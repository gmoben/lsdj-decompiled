#!/usr/bin/env bash
# Pre-commit quality gate for the LSDj disassembly.
# Install with: git config core.hooksPath .githooks
#
# 1. Refuse to commit ROM/save files (defense in depth on top of
#    .gitignore).
# 2. Verify the disassembly still reassembles to the original ROM byte-for-byte
#    (`make check`: `make compare`, or a fork's `make behaviour`) when a base ROM is available.
set -o errexit
set -o pipefail

# --- 1. Keep ROMs and saves out of the repo ----------------------
blocked=$(git diff --cached --name-only --diff-filter=A \
    | grep -Ei '\.(gb|gbc|gba|sav|srm|sgm)$' || true)
if [[ -n "$blocked" ]]; then
    echo "error: refusing to commit ROM/save files:" >&2
    echo "$blocked" >&2
    echo "These must never be committed. Remove them from the index:" >&2
    echo "  git restore --staged <file>" >&2
    exit 1
fi

# The carved disassembly is the ROM re-encoded as text -- also never committed.
blocked=$(git diff --cached --name-only --diff-filter=A \
    | grep -E '^src/.*\.asm$' || true)
if [[ -n "$blocked" ]]; then
    echo "error: refusing to commit generated disassembly (ROM-derived):" >&2
    echo "$blocked" >&2
    echo "src/*.asm is regenerated from your ROM by 'make'; only src/*.sym" >&2
    echo "curation is tracked. Remove from the index: git restore --staged <file>" >&2
    exit 1
fi

# --- 2. Verify the build still matches the original ROM ---------------------
# (`make check`: `make compare`, or for a fork, FORK=1, `make behaviour`)
ROM="${BASEROM:-lsdj9_4_0.gb}"
if [[ -f "$ROM" ]]; then
    echo "==> make check"
    make check
else
    echo "==> base ROM not present; skipping 'make check'." >&2
    echo "    Supply the base ROM to enable byte-for-byte verification." >&2
fi

echo "==> pre-commit checks passed."
