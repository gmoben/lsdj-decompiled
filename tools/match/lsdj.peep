replace restart {
	or	a,%1
	or	a,a
} by {
	or	a,%1
}
replace restart {
	ld	%1,a
	xor	a,a
	or	a,%1
} by {
	ld	%1,a
	or	a,%1
}
replace restart {
	ld	%1,a
	ld	a,%1
} by {
	ld	%1,a
}
replace restart {
	ld	a,%1
	push	af
	inc	sp
	ld	a,%1
} by {
	ld	a,%1
	push	af
	inc	sp
}
replace restart {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3
	push	hl
	ld	a,%1
} by {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3
	push	hl
}
replace restart {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3 + %4
	push	hl
	ld	a,%1
} by {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3 + %4
	push	hl
}
