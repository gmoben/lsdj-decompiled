	ld	(hl),e
	ld	a,e
}
replace restart {
	ld	a,%1
	cp	a,#%2
	jp	%3,%4
	xor	a,a
	or	a,%1
} by {
	ld	a,%1
	cp	a,#%2
	jp	%3,%4
	or	a,%1
}
