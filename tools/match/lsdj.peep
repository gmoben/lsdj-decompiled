}

// hl copied into a pair and straight back: the reload is dropped (0 in the
// ROM's compiled code; FileReadCompressedBlock pushes hl right after the copy)
replace {
	ld	%1,l
	ld	%2,h
	ld	l,%1
	ld	h,%2
} by {
	ld	%1,l
	ld	%2,h
}

// genXor stores a literal-left result twice (`ld (hl),a; ld (hl),a`); the ROM
// never has the pair (WriteSynthWaveColumn)
replace {
	ld	(hl),a
	ld	(hl),a
} by {
	ld	(hl),a
}

// SDCC's MOVA after reading an sfr for a compare (`ldh a,(_X); ld a,a`): the
// ROM's code never has `ld a,a` (its one occurrence is palette data; main)
replace restart {
	ld	a,a
} by {
}

// a literal loaded into a and overwritten by an sfr read at once: genCmp's
// `x > n` with an sfr x (`xor a,a; ld a,#n; ldh a,(_x); sbc a,a`, the switch
// bound in Command_E_NoteOn); the ROM never loads a twice in a row
replace restart {
	ld	a,#%1
	ldh	a,%2
} by {
	ldh	a,%2
}

// a load into a that the next stack read overwrites unread: SDCC's gencjneshort
// fetches a stack right operand into a over an a-packed left (`ld a,(de)`, then
// `cp a,a`); the ROM never has `ld a,X; ld hl,...; ld a,(hl)` (FreeUnusedInstruments'
// wColumnInstrument test; CheckRomChecksum's `(sum & 0xFF) == lo`, `ld a,c`)
replace restart {
	ld	a,%1
	lda	hl,%2
	ld	a,(hl)
} by {
	lda	hl,%2
	ld	a,(hl)
}
// genAnd's `if (!(x & n))` (jmpTrueOrFalse's IC_TRUE trampoline): the ROM
// folds it into one jump; no `and a,n; jr nz,L; jp M; L: jp X; M:` is left
// (DrawPhraseScreen's `note & 0xF0`; the one unfolded trampoline in the ROM
// follows a `cp (hl)`, CloneInstrumentTable)
replace restart {
	and	a,%1
	jr	nz,%2
	jp	%3
%2:
	jp	%4
%3:
} by {
	and	a,%1
	jp	nz,%4
%3:
}
// the `x != 0` test of a global (genCmpEq: `ld a,(hl); or a,a; jp z`) keeps
// hl like the `cp` forms above: the ROM never reloads after it (0 sites); its
// one compiled site keeps it (ProjectScreenInput's `wSyncMode != 0` before
// `wSyncMode--`; the other 2 are hand-written asm: tools/match/rom_grep.py)
replace restart {
	ld	hl,#%1 + %2
	ld	a,(hl)
	or	a,a
	jp	%3,%4
%5:
	ld	hl,#%1 + %2
} by {
	ld	hl,#%1 + %2
	ld	a,(hl)
	or	a,a
	jp	%3,%4
%5:
} if labelRefCount %5 0
replace restart {
	ld	hl,#%1 + %2
	ld	a,(hl)
	or	a,a
	jp	%3,%4
	ld	hl,#%1 + %2
} by {
	ld	hl,#%1 + %2
	ld	a,(hl)
	or	a,a
	jp	%3,%4
}
