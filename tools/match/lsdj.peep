replace restart {
	or	a,%1
	or	a,a
} by {
	or	a,%1
}
replace restart {
	ld	%1,a
	xor	a,a
	or	a,%1
} by {
	ld	%1,a
	or	a,%1
}
replace restart {
	ld	a,(bc)
	ld	b,a
	ld	a,b
} by {
	ld	a,(bc)
	ld	b,a
	LD	a,b
}
