replace restart {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3
	push	hl
	ld	a,%1
} by {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3
	push	hl
}
replace restart {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3 + %4
	push	hl
	ld	a,%1
} by {
	ld	a,%1
	ldh	%2,a
	ld	hl,%3 + %4
	push	hl
}
replace restart {
	xor	a,a
	lda	hl,%1
	ld	a,#0x00
} by {
	xor	a,a
	lda	hl,%1
}
replace restart {
