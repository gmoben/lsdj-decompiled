# --- ROMs and saves are never committed --------------------------------------
# The build regenerates everything from a ROM you download yourself
# (littlesounddj.com); the ROM stays out of the repo under any name.
*.gb
*.gbc
*.gba
*.sav
*.srm
*.sgm

# --- Build output -----------------------------------------------------------
/build/
*.o
*.sym
*.map
# ...but hand-maintained source symbol maps (src/*.sym) ARE tracked:
!src/*.sym

# --- Generated disassembly ---------------------------------------------------
# The carved .asm IS the ROM re-encoded as text, so it is never committed.
# `make` regenerates it from your ROM + the tracked src/*.sym curation.
/src/*.asm

# --- Live emulator RAM/state captures ---------------------------------------
# Keep these OUTSIDE /build/ (which `make clean` wipes). Not ours to ship.
/dumps/
*.dump
*.state
*.sn[0-9]

# --- Live emulator runtime dir (control socket, ROM/sav copy, logs, shots) ---
# Self-contained under the repo so nothing is left in /tmp; never committed.
/.emu/

# --- Recovered period toolchain (downloaded; binaries are not ours to ship) --
# GBDK 2.95 / SDCC 2.2.1 are fetched on demand by tools/toolchain/fetch_gbdk295.sh.
/toolchain/

# --- Editor / OS / local agent tooling noise --------------------------------
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db
opencode.jsonc
.opencode/

# --- Python tooling ---------------------------------------------------------
__pycache__/
*.pyc
.venv/
.ruff_cache/
