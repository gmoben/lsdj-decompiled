; Bank $01 -- UI string table + help text (incl. the FX command help popups)
4485 .done                ; (was CartridgeTest) common exit
51F4 PitchSpeedNames    ; [4][5] pitch-speed display names "STEP"/"TICK"/"DRUM"/"FAST"
764C LoadCommandHelp    ; resolve command (sp+8) -> help string in wStrBuffer + wVramCursor; shown at screen top on double-A. B/F/H/S/W are context-cased (by $C41D), the rest via CommandHelpTable
776E CommandHelpTable   ; [20] dw -> the "X: DESCRIPTION" help line per command (index = command*2; entry 0 points at an empty string, the end of TxtHelpSSweep)

; --- UI functions called from bank 0 (bank $01 paged in) ---
4CF1 UiInitScreen        ; screen setup: ApplyColorSet + ClearOamBuffer + UiLoadHwTables
4487 DrawCartTest               ; boot CARTRIDGE TEST screen (ROM checksum + SRAM self-test)
4FEC UpdatePlayClock            ; per-frame PLAY clock: wPlayFrames counts to 60 (one frame skipped every 4 s), then seconds/minutes; redraws m:ss on the project screen
7860 UiShowMessage       ; set up the timed status message (wMsgTimer / wMsgStrPtr)
7878 UiUpdateMessage     ; timed message + wSelectHeld handling
4811 CheckJkMarker              ; check the 'jk' SRAM-init marker at $a13e/$a13f (unreferenced)
4848 CheckSongInitFlag   ; ReadSongByte $be78/$be79 ('rb' memory-init marker)
50A0 UpdateWorkClock            ; apply one work-time minute: song WORKED h:mm ($BFB2/$BFB3) and the total d:hh:mm ($BFB6-$BFB8) in SRAM bank 1
48D4 WriteSongInitFlag   ; WriteSongByte $be78 (set the 'rb' init marker)
4D67 MarkChainUsed              ; set chain (arg)'s bit in the chain allocation map (SramChainAlloc + chain/8, bit chain&7); asserts chain < $80
4EA3 .writeSongByte       ; (was WriteSongByteWrap) thin WriteSongByte wrapper
45D1 UiClearSram         ; enable SRAM + ClearSramWindow

; --- UI message / status strings (db "..."; referenced by the draw code) ---
4557 TxtCartridgeTest           ; "CARTRIDGE TEST"
4A44 TxtSpch                    ; "SPCH" default speech-instrument name
52DE TxtCopiedInstr     ; "COPIED INSTR"
54F6 TxtClonedTable     ; "CLONED TABLE"
55BC TxtPastedInstr     ; "PASTED INSTR"
75C7 TxtOutOfMemory     ; "OUT OF MEMORY. CLEAN SONG DATA IN PROJECT SCREEN"
7602 TxtTapAddChain     ; "TAP A TO ADD CHAIN!"
7620 TxtTapAddPhrase    ; "TAP A TO ADD PHRASE!"
763F TxtMax16Marks      ; "MAX 16 MARKS"
7945 TxtBlank5          ; 5 spaces + NUL (blank/clear string)

; --- data tables (were decoded as code) ---
40EA DefaultWaveFrameB1  ; [16] default wave frame (32-nibble ramp), memcpy'd into wave_frames by $47E5
57BF ScreenPalChain             ; CGB palette block: CHAIN screen
7498 TxtBlankString2   ; blank (zero) display string (ref $6D98)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 UiTestSramLo               ; cartridge RAM test, SRAM banks 0-3: write/read-back pattern via $33f9 (part of CartridgeTest)
445A UiTestSramHi               ; probe SRAM banks 4-15 (enable $0a, select bank, call $20c4); jp UiTestSramHi.done on mismatch
493B CopyInstrName              ; copy instrument arg's 5-char name -> wNameEditBuf (speech $40 -> "SPCH")
4A49 WriteInstrName             ; wNameEditBuf -> instrument name storage ($be7a + instr*5)
4B15 UiLoadHwTables             ; load CGB/DMG-specific tables: palette-ish -> $cd28, 216-byte note-period table -> wNotePeriods ($cf28)
4B5E ClearOamBuffer             ; MemSet(wOamBuffer,0,$a0) + sprite state reset
4C61 ApplyColorSet              ; load the wColorSet CGB BG+OBJ palettes (hw $11 check, set_bkg_palette)
4CFB MarkPhraseUsed             ; set the phrase-alloc bit (song $3E82 bitmap) for phrase arg
5208 DrawSpeedGlyph             ; draw the 2-tile speed icon (SpeedGlyphTiles[value&7])
5243 .drawString          ; (was DrawStringBC) draw the string pointed to by bc (shared tail of the flag-name drawers)
52EB CopySong16                 ; copy a 16-byte song-data row src->dst via Read/WriteSongByte
5331 CopyTableData              ; copy table src->dst across the table column regions (song $3680/$3880/$3A80)
55C9 GetScreenPalette           ; -> de = CGB BG palette block for wCurrentScreen (INSTR varies by instr type)
6CD7 UiDrawTextHw               ; read instrument (GetScreenPalette); draw via CGB path (UiDrawScreenCgb) or DMG path (UiDrawScreenDmg) per hGameboyType
6D23 UiClearBgMap               ; clear BG tilemap from $9800 (VBK-aware: bank1 attrs on CGB)
6D53 DrawTopBar                 ; top status bar: active message (wMsgStrPtr) or screen title + hex number
7955 DrawCrashScreen            ; the crash screen: "DONT PANIC!", the bank, the stack pointer and 10 stack words, play mode, screen, hardware, sync, AST, the version; then hangs
7BDE ResetEditorState           ; clear selection rect, clipboard type, cursor mode (+$c412)
7DE9 ClearSramWindow           ; zero the whole $A000-$BFFF SRAM window (8 bytes/iter until h==$c0); used during init/format
7DFB UiDrawScreenCgb            ; copy 18x20 chars (arg ptr) -> $9800 with per-char CGB palette attribute (VBK1)
7E4E UiDrawScreenDmg            ; copy 18x20 chars (arg ptr) -> $9800 (DMG, no palette attrs)
7E74 CrashSaveStack             ; save the crash's stack pointer (wCrashSP) and 20 bytes from the stack (wCrashStack), then DrawCrashScreen
7ED3 UiLoadObjPalette           ; upload object palette: write rOBPI/rOBPD from [bc], index/count from args
; --- indirect (FarCall) target ---
75BD ShowOutOfMemory ; push TxtOutOfMemory, call ShowMessage
75F8 ShowTapAddChain ; push TxtTapAddChain, call ShowMessage

; --- song-data allocation, clipboard, message bar (FarCall targets) ---
4E43 FreeChain          ; clear chain-alloc bit (song $3EA2 bitmap) and write back
4EB3 AllocNextFreePhrase ; scan phrase-alloc bitmap ($3E82) from current phrase, mark first free; full -> ShowOutOfMemory, ret $ff
5253 CopyInstrument     ; copy the instrument ("COPIED INSTR"): wClipboardType=6, 16 instr bytes -> screen scratch
546E CloneInstrTable    ; on instr TABLE field: alloc table copy (bank1f), "CLONED TABLE", write #|$20
5503 PasteInstrument    ; if select-held + clipboardType==6: paste 16 bytes back into instrument
74F7 DrawMessageBar     ; render wStrBuffer (20 ch) to tilemap row 0 + CGB attrs (MsgBarAttrRow)
7616 ShowTapAddPhrase   ; push TxtTapAddPhrase, call ShowMessage
7635 ShowMax16Marks     ; push TxtMax16Marks, call ShowMessage
781F ClearMessageBar    ; zero wMsgStrPtr, fill top bar with spaces
7C86 LoadProjectSettings ; audio off; read key-repeat/sync/clone/colorset from song properties ($bfbc+), clamp, re-init palettes

