; Bank $01 -- UI string table + help text (incl. the FX command help popups)
4485 .done                ; common exit
51F4 PitchSpeedNames    ; [4][5] pitch-speed display names "STEP"/"TICK"/"DRUM"/"FAST"
764C ShowCommandHelp                ; show command cmd's help line on double-A (ShowMessage; wVramCursor kept): B and H by screen (phrase or table), F, S and W by channel (wSongColumn), the rest from CommandHelpPointers
776E CommandHelpPointers   ; [20] dw -> the "X: DESCRIPTION" help line per command (index = command*2; entry 0 points at an empty string, the end of TxtHelpSSweep)

; --- UI functions called from bank 0 (bank $01 paged in) ---
4CF1 InitializeScreen        ; screen setup: ApplyColorSet + ClearOamBuffer + LoadHardwareTables
4487 DrawCartTest               ; boot CARTRIDGE TEST screen (ROM checksum + SRAM self-test)
4FEC UpdatePlayClock            ; per-frame PLAY clock: wPlayFrames counts to 60 (one frame skipped every 4 s), then seconds/minutes; redraws m:ss on the project screen
7860 IsMessageActive            ; 1 while a message is up or pending (wMessageTimer or wMessageStringPointer set)
7878 UpdateMessage     ; timed message + wSelectHeld handling
4811 CheckJkMarker              ; check the 'jk' SRAM-init marker at $a13e/$a13f (unreferenced)
4848 CheckSongInitializedMarker   ; ReadSongByte $be78/$be79 ('rb' memory-init marker)
50A0 UpdateWorkClock            ; apply one work-time minute: song WORKED h:mm ($BFB2/$BFB3) and the total d:hh:mm ($BFB6-$BFB8) in SRAM bank 1
48D4 WriteSongInitializedMarker   ; WriteSongByte $be78 (set the 'rb' init marker)
4D67 MarkChainUsed              ; set chain (arg)'s bit in the chain allocation map (SramChainAllocation + chain/8, bit chain&7); asserts chain < $80
4EA3 .writeSongByte       ; thin WriteSongByte wrapper
45D1 FormatSramSong             ; format the SRAM song: zero the banks, default grooves/sequence/word names/instr names/synth params/wave frames

; --- UI message / status strings (db "..."; referenced by the draw code) ---
4557 TxtCartridgeTest           ; "CARTRIDGE TEST"
4A44 TxtSpch                    ; "SPCH" default speech-instrument name
52DE TxtCopiedInstr     ; "COPIED INSTR"
54F6 TxtClonedTable     ; "CLONED TABLE"
55BC TxtPastedInstr     ; "PASTED INSTR"
75C7 TxtOutOfMemory     ; "OUT OF MEMORY. CLEAN SONG DATA IN PROJECT SCREEN"
7602 TxtTapAddChain     ; "TAP A TO ADD CHAIN!"
7620 TxtTapAddPhrase    ; "TAP A TO ADD PHRASE!"
763F TxtMax16Marks      ; "MAX 16 MARKS"
7945 TxtBlank5          ; 5 spaces + NUL (blank/clear string)

; --- data tables (were decoded as code) ---
40EA DefaultWaveFrameB1  ; [16] default wave frame (32-nibble ramp), memcpy'd into wave_frames by $47E5
57BF ScreenPaletteChain             ; [18][20] ground tiles, CHAIN screen (DrawScreenPaletteMap)
7498 TxtBlankString2   ; blank (zero) display string (ref $6D98)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 TestSramLow                 ; cartridge RAM test, SRAM banks 0-3: write/read-back pattern (part of DrawCartTest)
445A TestSramHigh                 ; cartridge RAM test, SRAM banks 4-15 (jp TestSramHigh.done on mismatch)
493B CopyInstrumentName              ; copy instrument arg's 5-char name -> wNameEditBuffer (speech $40 -> "SPCH")
4A49 WriteInstrumentName             ; wNameEditBuffer -> instrument name storage ($be7a + instr*5)
4B15 LoadHardwareTables               ; load the CGB/DMG-specific tables: palettes -> wNotePeriodLow, the 216-byte note-period table -> wNotePeriods
4B5E ClearOamBuffer             ; clear the OAM shadow (wOamBuffer, $a0 bytes) and sprite tiles $8000-$802f/$8050-$805f, place the WAV sprites, wait for the OAM DMA, enable sprites
4C61 ApplyColorSet              ; load the wColorSet CGB BG+OBJ palettes (hw $11 check, set_bkg_palette)
4CFB MarkPhraseUsed             ; set the phrase-alloc bit (song $3E82 bitmap) for phrase arg
5208 DrawSpeedGlyph             ; draw the 2-tile speed icon (SpeedGlyphTiles[value&7])
5243 .drawString          ; draw the string pointed to by bc (shared tail of the flag-name drawers)
52EB CopySong16                 ; copy a 16-byte song-data row src->dst via Read/WriteSongByte
5331 CopyTableData              ; copy table src->dst across the table column regions (song $3680/$3880/$3A80)
55C9 GetScreenPalette           ; -> de = CGB BG palette block for wCurrentScreen (INSTR varies by instr type)
6CD7 DrawScreenPaletteMap           ; the current screen's palette map (GetScreenPalette): CopyScreenMapCgb on CGB, CopyScreenMapDmg on DMG (the message cancelled); none clears the attribute map
6D23 ClearBgMapAndAttributes               ; clear BG tilemap from $9800 (VBK-aware: bank1 attrs on CGB)
6D53 DrawTopBar                 ; top status bar: active message (wMessageStringPointer) or screen title + hex number
7955 DrawCrashScreen            ; the crash screen: "DONT PANIC!", the bank, the stack pointer and 10 stack words, play mode, screen, hardware, sync, AST, the version; then hangs
7BDE ResetEditorState           ; clear selection rect, clipboard type, cursor mode (+wQuickMarking)
7DE9 ClearSramWindow           ; zero the whole $A000-$BFFF SRAM window (8 bytes/iter until h==$c0); used during init/format
7DFB CopyScreenMapCgb           ; copy the 20x18 map at arg to the BG map ($9800) as CGB tiles + attributes: below $48 palette 0, $48-$8C palette 1 (the shaded block, tile - $45), $8D up palette 2 (the highlight block, tile - $8A)
7E4E CopyScreenMapDmg           ; copy the 20x18 map at arg to the BG map ($9800; rSTAT-gated)
7E74 SaveCrashStack             ; save the crash's stack pointer (wCrashSP) and 20 bytes from the stack (wCrashStack), then DrawCrashScreen
7ED3 LoadObjPalette           ; upload object palette: write rOBPI/rOBPD from [bc], index/count from args
; --- indirect (FarCall) target ---
75BD ShowOutOfMemory ; push TxtOutOfMemory, call ShowMessage
75F8 ShowTapAddChain ; push TxtTapAddChain, call ShowMessage

; --- song-data allocation, clipboard, message bar (FarCall targets) ---
