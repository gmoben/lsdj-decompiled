; Bank $1F -- instrument-editor helpers (called by bank $03) + Phrase screen update
; Per-instrument-type parameter draw handlers, dispatched by DrawInstrScreen
; ($03:$4F45) on the instrument's type (0=PULSE 1=WAVE 2=KIT 3=NOISE).

; --- data tables + strings (db; instrument-editor + word/phrase helpers) ---
4236 TxtDashTemplate    ; "/--/--" (value display template)
491A DefaultWaveFrameB1F        ; default wave frame (16 bytes; WaveFrameModified compares phrase rows against it)
4A02 DefaultInstrPulse          ; [11] default pulse (or noise) instrument bytes (ClaimInstrSlot)
4A0D DefaultInstrWave           ; [11] default wave instrument bytes
4A18 DefaultInstrKit            ; [14] default kit instrument bytes
4ACE TxtOutOfMemory1F     ; "OUT OF MEMORY. CLEAN SONG DATA IN PROJECT SCREEN"
4C11 TxtOutOfTables     ; "OUT OF TABLES!"
61FF DefaultSynthParams  ; [16] default softsynth params, memcpy'd into synth_params ($3EB2) by $61E1
637D TxtDeDupe          ; "DE-DUPE..."
644D TxtDeDupe2         ; "DE-DUPE..." (second instance)
723F TxtTypeSpeech      ; "TYPE   SPEECH" (instrument-type field)
77F5 TxtCopiedWord      ; "COPIED WORD"
423D DrawPulseInstr     ; draw PULSE instrument params (type 0)
473E TxtKitSpeedHalf          ; "0.5" (DrawKitInstr: SPEED, kit byte 2 bit 6 = half speed)
4742 TxtKitSpeedFull          ; "  1" (DrawKitInstr: SPEED, full speed)
4746 TxtKitLen1All            ; "ALL" (DrawKitInstr: LEN of the left kit, byte 3, when 0 = play the sample to its end)
474A TxtKitLen2All            ; "ALL" (DrawKitInstr: LEN of the right kit, byte 11)
474E DrawWaveInstr      ; draw WAVE instrument params (type 1)
44DD DrawKitInstr       ; draw KIT instrument params (type 2)
4399 DrawNoiseInstr     ; draw NOISE instrument params (type 3)
; --- instrument-screen display strings ---------------------------------------
408D StepRateStr       ; "STEP" (instrument cmd/table rate when byte5 bit3 set)
4092 TickRateStr       ; "TICK" (instrument cmd/table rate when byte5 bit3 clear)
44A3 LenUnlimStr       ; "UNLIM" (shown when sound-length byte3 bit6 = 0)
44AD NoiseSafeStr      ; "SAFE" (noise S command, nonzero)
44B2 NoiseFreeStr      ; "FREE" (noise S command, 0)
648F PhraseScreenUpdate ; per-frame visual update (screen idx 1 = Phrase)
4000 DrawInstrTableMode         ; draw the instrument's table mode at its type's row: " OFF", or STEP/TICK by byte 5 bit 3 when the table is on (byte 6 bit 5)
4157 InstrEnvHasSecond          ; 1 if the envelope's first value moves on (byte 1's speed nibble nonzero), so its second value is used
4169 InstrEnvHasThird           ; 1 if the envelope reaches its third value (bytes 1 and 9 both have a nonzero speed nibble)
5091 IsPhraseUsedFar            ; FarCall bank01 IsPhraseUsed
5413 MarkChainPhrasesUsed       ; mark all phrases of chain arg used (rows<16, $ff skipped)
5461 IsChainUsedFar             ; FarCall bank01 IsChainUsed
7097 RedrawScreenFar1F          ; FarCall home RedrawScreen ($24dd) with bank 4 arg

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
409C DrawInstrTableField        ; draw the instrument's table field: table number (hex) if on, '--' if off
40CA DrawKitLoopMode            ; draw one kit's LOOP setting: OFF unless loopBit of byte 5 is set, else ATK if bit 7 of byte atkByte, else ON
411F DrawKitLoopField           ; the kit LOOP field: kit 1's mode (byte 5 bit 6, byte 2 bit 7), a "/", kit 2's (byte 5 bit 5, byte 9 bit 7)
418A DrawInstrEnvFields         ; draw the instrument envelope line: byte 1, the /--/-- template, bytes 9 and 10 (hex or n-)
44B7 DrawKitNameCell            ; kit number (hex) + 6-char kit name (ReadKitName)
48C5 WriteChainPhrase           ; chains[chain*16+row] = phrase (song $2080 region)
492A ClaimInstrSlot             ; read+mark the instr-alloc entry (song $2040); returns prior state
4B00 IsSongBlockEmpty           ; read 16 song bytes (bank, addr) into wSongReadBuf; 1 if all are zero
4B45 IsTableFree                ; e=1 if table n has no data in its env/cmd rows (used by FindFreeTable)
4CCD FreeUnusedInstrs           ; CLEAN INSTR DATA pass: re-mark the instruments phrases use, reset the rest (name, $B080 block, column refs); e = how many allocated ones were freed
4F04 MarkTableUsed              ; set wUsedTableMap[t] (t < $20)
4F1C IsTableUsed                ; -> wUsedTableMap[t], the table's mark
4F2E IsInstrAllocated           ; instrument n's SramInstrAlloc flag
4F49 MarkPhraseTablesUsed       ; mark the tables phrase (arg)'s A commands (command 1) name: MarkTableUsed(value)
4FC5 MarkTableTablesUsed        ; mark the tables table t's two command columns name with A (MarkTableUsed)
50A8 MarkTablesOfUsedPhrases    ; mark the tables each used phrase's A commands name (MarkPhraseTablesUsed)
50CC CountUsedTables            ; count the marked tables in wUsedTableMap
50F6 MarkTablesOfUsedTables     ; mark the tables each marked table's A commands name; 1 if that marked more
513D MarkInstrTableUsed         ; mark instrument i's table used if its TABLE is on (byte 6 bit 5)
515F MarkTablesOfUsedInstrs     ; mark the table of every allocated instrument (MarkInstrTableUsed)
5183 ClearTableRow              ; zero 16 bytes of one table column region (row arg <$10)
51B9 ClearTable                 ; wipe table n (<$20) across all five column regions ($3480..$3C80)
526B ClearUnusedTables          ; clear every unmarked table; -> how many of them were not empty
52B3 FreeUnusedTables           ; CLEAN INSTR: mark the tables instruments, phrases and tables use, clear the rest; -> how many were freed
52DA RemapSeqChains             ; walk the 4 sequence columns remapping chain refs (CleanSongData step)
5478 MarkPhrasesOfUsedChains    ; mark the phrases every used chain plays (MarkChainPhrasesUsed)
549C FindDupPhrase        ; does phrase b equal phrase a? compares the 16 notes, instruments, commands and command values; 1 = duplicate
5644 FindDupChain         ; does chain b equal chain a? compares the 16 phrases and transposes; 1 = duplicate
573C FindDupTable         ; does table b equal table a? compares fx 1/values, fx 2/values, envelopes and transposes; 1 = duplicate
5996 RemapPhraseRefs            ; walk all chains ($2080..) replacing dup phrase refs with the canonical one
5A12 RemapChainRefs             ; walk the song sequence ($B290-$B68F) replacing references to a duplicate chain with the canonical one
5A8E RemapCmdTableRefs          ; walk phrase/table cmd values replacing dup table refs (A command)
5BDE DedupPhrases               ; fold duplicate phrases: for each used phrase i (hex counter at $98AE) every later used phrase FindDupPhrase finds equal is remapped to i (RemapPhraseRefs)
5C78 DedupChains                ; fold duplicate chains: for each used chain i (counter at $98AE) every later used chain FindDupChain finds equal is remapped to i (RemapChainRefs); then OK
5D18 DedupTables                ; fold duplicate tables: for each used table i (hex counter at $98AE) every later used table FindDupTable finds equal is remapped to i (RemapCmdTableRefs); then draws OK
5DC9 CountUsedPhrases           ; count the phrases in use (IsPhraseUsedFar)
5DF3 CountUsedChains            ; count the chains in use (IsChainUsedFar)
5E1D RebuildPhraseAllocMap      ; clear the phrase-alloc bitmap ($3E82, 32B) + rescan via used chains
5F20 WaveFrameModified          ; 1 if synth w's wave frame (SRAM bank 3 $A000 + w*16) differs from DefaultWaveFrameB1F
5F85 SynthFramesModified        ; 1 if any of synth s's 16 wave frames differs from the default (WaveFrameModified)
5FC2 CountModifiedSynths        ; count the synths with a modified wave frame
5FEC AnyPhraseUsesCmdF          ; 1 if any phrase step holds command F (6)
6074 AnyTableUsesCmdF           ; 1 if either command column of any table holds command F (6)
614C AnyCmdFUsed                ; 1 if any phrase or table uses command F (AnyPhraseUsesCmdF / AnyTableUsesCmdF)
6163 ResetWaveFrame             ; reset wave frame n (SRAM bank 3, $A000 + n*16) to DefaultWaveFrameB1F
619E ResetSynthWaves            ; reset synth s's 16 wave frames to the default (ResetWaveFrame)
61C4 ResetSynthParams           ; reset synth n's 16 params (SRAM bank 1, $BEB2 + n*16) to DefaultSynthParams
620F ResetUnusedSynths          ; reset the params and waves of every synth no wave instrument plays
62BD FreeUnusedSynths           ; CLEAN INSTR: unless a phrase or table uses F, reset the synths no wave instrument uses; -> how many were freed
6B3B HighlightPhraseCell        ; colour phrase cell (col,row) as the cursor/selection: ColorField at PhraseCellX/XAlt + 3 in the shifted draw mode, the PhraseCellWidth/WidthAlt width through wDrawTextScratch, palette 3 on CGB / 2 on DMG (row flag $fe/$ff picks the normal tables, else the Alt ones)
6CA2 UnhighlightPhraseCell      ; colour phrase cell (col,row) in its normal palette (the PhraseCell* layout tables; HighlightPhraseCell's inverse)
6EFE ErasePhraseCursor          ; restore the phrase cursor cell's palette: UnhighlightPhraseCell(wPhraseCol, wPhraseRow)
6F14 DrawChanStatus            ; draw channel status cell at (16, ch+6) from wChanOutput[ch]
70A8 SpeechCursorY              ; screen row of the speech instrument's word-list cursor: wSpeechRow + 4
70B6 EraseSpeechCursor          ; restore the word-list row's palette (alternating by row parity)
70DF DrawSpeechCursor           ; highlight the speech instrument's word-list row under wSpeechRow
; --- functions called from bank 0 (this bank paged in) ---
4A26 InitRemapTable             ; fill $c9b8..+16 with identity 0..15 (remap table for clone/dedupe)
7801 TxtCutWord        ; "CUT WORD"
780A TxtPastedWord     ; "PASTED WORD"

; --- allocation / clean / phrase-screen helpers (FarCall targets) ---
4A65 AllocNextFreeInstr         ; scan instr-alloc table (song $2040) for a free slot, place into phrase (bank04 $41f0); full -> OOM msg, e=$40
4BD9 FindFreeTable              ; first unused table 0-$1f; none -> ShowMessage(TxtOutOfTables), e=$ff
4C20 IsSongChainUsed            ; test chain-alloc bit for the chain under the song cursor col ($c44f+wSongCol; $80+ -> 0)
62DD CleanSongData              ; project CLEAN: de-dupe chains+phrases, DE-DUPE/FREEING progress panel
63B1 CleanInstrData             ; project CLEAN: de-dupe instruments/tables, DE-DUPE/FREEING progress panel
64FF CanEnterSongCol            ; e=1 if song column (arg<4) can take the cursor (channel active/enterable)
6656 HasEnterableColRight       ; e=1 if any song column right of wSongCol is enterable (phrase-screen '>' arrow)
6677 HasEnterableColLeft        ; e=1 if any song column left of wSongCol is enterable ('<' arrow)
6C1E DrawPhraseCursor           ; draw the phrase cursor cell: HighlightPhraseCell(wPhraseCol, wPhraseRow) via the PhraseCell* tables
6D58 DrawPhraseSelection        ; phrase selection (wClipboardType==1) redraw vs the cursor: the one-cell ring around the rectangle via UnhighlightPhraseCell, the inside via HighlightPhraseCell
7072 DrawAllChanStatus          ; draw the 4 channel status cells (DrawChanStatus 0-3)
7108 DrawSpeechInstrScreen      ; instrument screen for SPEECH type: "TYPE   SPEECH" + word list (pseudo-screen $0b)
724D SpeechInstrInput           ; speech instrument screen input (from InstrScreenInput for instrument $40): pick, rename, move, cut/copy/paste a word
; --- data ---
4ACE TxtOutOfMemInstr           ; "OUT OF MEMORY. CLEAN INSTR DATA IN PROJECT SCREEN!"
64E1 PhraseCellX                ; [5] phrase cell x per column (the six PhraseColLayout rows; $FF = hidden)
64E6 PhraseCellXAlt             ; [5] x when the step's row flag is not $FE/$FF
64EB PhraseCellWidthAlt         ; [5] width, alt rows
64F0 PhraseCellWidth            ; [5] width
64F5 PhraseCellPalAlt           ; [5] highlight palette, alt rows
64FA PhraseCellPal              ; [5] highlight palette
637D TxtDedupe                  ; "DE-DUPE..."
6388 TxtFreeing                 ; "FREEING:"
6391 TxtChainsFill              ; "CHAINS...."
639C TxtPctD                    ; "%d"
639F TxtPhrasesFill             ; "PHRASES..."
63AA TxtPctD2                   ; "%d"
63AD TxtOk2                     ; "OK!"
644D TxtDedupe2                 ; "DE-DUPE..."
6458 TxtFreeing2                ; "FREEING:"
6461 TxtInstrsFill              ; "INSTRS...."
646C TxtPctD3                   ; "%d"
646F TxtTablesFill              ; "TABLES...."
723F TxtTypeSpeech              ; "TYPE   SPEECH"
6698 CutCopyPhraseSelection ; arg!=0 -> "CUT" (copy+clear) else "COPY": phrase selection -> clipboard (clipType 1)
6B32 TxtCut1F           ; "CUT"
6B36 TxtCopy1F          ; "COPY"
6C34 DrawWordRow        ; draw word n's 3-character name (SramWordNames + 3*(n-1), blanks for 0) or \"---\" outside 1-14
647A TxtPctD4                   ; "%d"
647D TxtSynthsFill              ; "SYNTHS...."
6488 TxtPctD5                   ; "%d"
648B TxtOk3                     ; "OK!"

