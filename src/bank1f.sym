; Bank $1F -- instrument-editor helpers (called by bank $03) + Phrase screen update
; Per-instrument-type parameter draw handlers, dispatched by DrawInstrumentScreen
; ($03:$4F45) on the instrument's type (0=PULSE 1=WAVE 2=KIT 3=NOISE).

; --- data tables + strings (db; instrument-editor + word/phrase helpers) ---
4236 TxtDashTemplate    ; "/--/--" (value display template)
491A DefaultWaveFrameB1F        ; default wave frame (16 bytes; MarkPhraseDataUsed compares phrase rows against it)
4A02 DefaultInstrument       ; 16-byte default instrument template
4ACE TxtOutOfMemory1F     ; "OUT OF MEMORY. CLEAN SONG DATA IN PROJECT SCREEN"
4C11 TxtOutOfTables     ; "OUT OF TABLES!"
61FF DefaultSynthParams  ; [16] default softsynth params, memcpy'd into synth_params ($3EB2) by $61E1
637D TxtDeDupe          ; "DE-DUPE..."
644D TxtDeDupe2         ; "DE-DUPE..." (second instance)
723F TxtTypeSpeech      ; "TYPE   SPEECH" (instrument-type field)
77F5 TxtCopiedWord      ; "COPIED WORD"
423D DrawPulseInstr     ; draw PULSE instrument params (type 0)
474E DrawWaveInstr      ; draw WAVE instrument params (type 1)
44DD DrawKitInstr       ; draw KIT instrument params (type 2)
4399 DrawNoiseInstr     ; draw NOISE instrument params (type 3)
; --- instrument-screen display strings ---------------------------------------
408D StepRateStr       ; "STEP" (instrument cmd/table rate when byte5 bit3 set)
4092 TickRateStr       ; "TICK" (instrument cmd/table rate when byte5 bit3 clear)
44A3 LenUnlimStr       ; "UNLIM" (shown when sound-length byte3 bit6 = 0)
44AD NoiseSafeStr      ; "SAFE" (noise S command, nonzero)
44B2 NoiseFreeStr      ; "FREE" (noise S command, 0)
648F PhraseScreenUpdate ; per-frame visual update (screen idx 1 = Phrase)
4000 GetInstrType1F                           ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
4157 GetInstrEnv1F                             ; read instrument byte 1 = envelope/volume
4169 GetInstrByte1F9                         ; read instrument byte 9 (kit row gate: 0 -> dashes)
5091 IsPhraseUsedFar            ; FarCall bank01 IsPhraseUsed
5413 MarkChainPhrasesUsed       ; mark all phrases of chain arg used (rows<16, $ff skipped)
5461 IsChainUsedFar             ; FarCall bank01 IsChainUsed
7097 RedrawScreenFar1F          ; FarCall home RedrawScreen ($24dd) with bank 4 arg
4085 GetInstrTable1F                         ; read instrument byte 6 = table (bits0-4) + enable (bit5)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
409C GetInstrTable1F2                       ; read instrument byte 6 = table (bits0-4) + enable (bit5)
40CA GetInstrFlags1F5                       ; read instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
411F DrawTableFlag              ; draw the instr TABLE on/off state glyph (field 5) with palettes
418A GetInstrEnv1F2                           ; read instrument byte 1 = envelope/volume
44B7 DrawKitNameCell            ; kit number (hex) + 6-char kit name (ReadKitName)
48C5 WriteChainPhrase           ; chains[chain*16+row] = phrase (song $2080 region)
492A ClaimInstrSlot             ; read+mark the instr-alloc entry (song $2040); returns prior state
4B00 InstrHReadTableRow         ; read a 16-byte row from SRAM (ReadSongBytes) -> $c46d, then scan it
4B45 IsTableFree                ; e=1 if table n has no data in its env/cmd rows (used by FindFreeTable)
4CCD MarkInstrUsed              ; set the instr-alloc entry for instrument arg (<$40)
4F04 InstrHMarkTableUsed        ; if arg<$20, set $c47d[arg]=1 (mark table used)
4F1C InstrHGetTableUsed         ; return $c47d[arg] (table-used flag)
4F2E InstrHReadPhraseRef        ; read SRAM byte at $A040+arg (ReadSongByte bank1)
4F49 ComparePhraseToWork        ; compare phrase rows against the $0FF0 work row (dedupe comparator)
4FC5 ReadTableRowCmds           ; gather one table row's cmd1/val1/cmd2 bytes ($3680/$3880/$3A80 regions)
50A8 InstrHScanUsedPhrases      ; for each phrase 0..255 used (IsPhraseUsedFar), process via ComparePhraseToWork
50CC InstrHCountUsedTables      ; count nonzero entries in used-table map $c47d[0..$1f]
50F6 InstrHProcessUsedTables    ; count tables (50CC) then run ReadTableRowCmds per used
513D InstrHMarkInstrTable       ; read instr field6; if bit5 set, mark its table used (InstrHMarkTableUsed)
515F InstrHScanInstrTables      ; for each instrument 0..63 used, mark its table (InstrHReadPhraseRef/513D)
5183 ClearTableRow              ; zero 16 bytes of one table column region (row arg <$10)
51B9 ClearTable                 ; wipe table n (<$20) across all five column regions ($3480..$3C80)
526B InstrHCollectUsedTables    ; gather used-table indices + pointers from map $c47d
52B3 BuildUsedTablesMap         ; rebuild the used-tables map ($c47d, 32 slots): scan instrs, phrases, tables
52DA RemapSeqChains             ; walk the 4 sequence columns remapping chain refs (CleanSongData step)
5478 InstrHScanUsedChains       ; for each chain 0..127 used (IsChainUsedFar), process (MarkChainPhrasesUsed)
549C FindDupPhrase              ; scan phrase-note rows ($0000) for a duplicate of the candidate
5644 FindDupChain               ; scan chain rows ($2080) for a duplicate
573C FindDupTable               ; scan table rows ($3680) for a duplicate
5996 RemapPhraseRefs            ; walk all chains ($2080..) replacing dup phrase refs with the canonical one
5A12 RemapTableRefs             ; walk instruments/table-env ($3290..) replacing dup table refs
5A8E RemapCmdTableRefs          ; walk phrase/table cmd values replacing dup table refs (A command)
5BDE DrawFreedPhrases           ; count freed phrases (IsPhraseUsedFar) + draw the DE-DUPE counter ($c9c8)
5C78 DrawFreedChains            ; count freed chains (IsChainUsedFar) + draw the DE-DUPE counter ($c9ca)
5D18 DrawFreedTables            ; count free tables (IsTableFree) + draw the DE-DUPE counter
5DC9 InstrHCountUsedPhrases     ; count used phrases 0..255 (IsPhraseUsedFar)
5DF3 InstrHCountUsedChains      ; count used chains 0..127 (IsChainUsedFar)
5E1D RebuildPhraseAllocMap      ; clear the phrase-alloc bitmap ($3E82, 32B) + rescan via used chains
5F20 MarkPhraseDataUsed         ; per-phrase used-scan helper (reads rows, dispatch table $491a)
5F85 InstrHScanChainPhrases     ; scan the 16 phrase slots of a chain (arg*16) for usage
5FC2 InstrHScanAllChainPhr      ; for 16 chains, scan their phrases (InstrHScanChainPhrases)
5FEC InstrHScanPhraseCmds       ; scan phrase command bytes from SRAM ($A0xx) for references
6074 InstrHScanTableCmds        ; scan table command columns from SRAM ($B680/$BA80) for references
614C InstrHAnyCmdRef            ; return 1 if InstrHScanPhraseCmds or InstrHScanTableCmds found a reference
6163 InstrHPhraseAddr           ; compute SRAM phrase address (arg*16 + base)
619E InstrHScanChainRows        ; scan 16 rows of a chain (arg*16)
61C4 InstrHSongAddr             ; compute SRAM song-area address (arg*16 + $B2xx)
620F InstrHScanTableRows        ; scan 16 table rows from a pointer
62BD TableIsReferenced          ; e=1 if table n is referenced by any instrument or A command (CleanInstrData)
6B3B DrawPhraseCellValue        ; draw the cell under the phrase cursor ($fe/$ff specials, $c90c state)
6CA2 InstrHReadCursorCell       ; read cell via ROM table $64E1 + cursor offsets (args sp+7/sp+8)
6EFE InstrHReadCursorCellAt     ; read cell at cursor $c415/$c416 (InstrHReadCursorCell)
6F14 DrawChanStatus            ; draw channel status cell at (16, ch+6) from wChanModFlag[ch]
70A8 InstrHGetParamPlus4        ; return $c429 + 4
70B6 InstrHDrawParamField       ; draw a field from $c429 (parity-based) via InstrHGetParamPlus4
70DF DrawInstrParamField        ; draw an instrument parameter text field (InstrHGetParamPlus4 + DrawTextField)
; --- functions called from bank 0 (this bank paged in) ---
4A26 InitRemapTable             ; fill $c9b8..+16 with identity 0..15 (remap table for clone/dedupe)
7801 TxtCutWord        ; "CUT WORD"
780A TxtPastedWord     ; "PASTED WORD"

; --- allocation / clean / phrase-screen helpers (FarCall targets) ---
4A65 AllocNextFreeInstr         ; scan instr-alloc table (song $2040) for a free slot, place into phrase (bank04 $41f0); full -> OOM msg, e=$40
4BD9 FindFreeTable              ; first unused table 0-$1f; none -> ShowMessage(TxtOutOfTables), e=$ff
4C20 IsSongChainUsed            ; test chain-alloc bit for the chain under the song cursor col ($c44f+wSongCol; $80+ -> 0)
62DD CleanSongData              ; project CLEAN: de-dupe chains+phrases, DE-DUPE/FREEING progress panel
63B1 CleanInstrData             ; project CLEAN: de-dupe instruments/tables, DE-DUPE/FREEING progress panel
64FF CanEnterSongCol            ; e=1 if song column (arg<4) can take the cursor (channel active/enterable)
6656 HasEnterableColRight       ; e=1 if any song column right of wSongCol is enterable (phrase-screen '>' arrow)
6677 HasEnterableColLeft        ; e=1 if any song column left of wSongCol is enterable ('<' arrow)
6C1E DrawPhraseCursor           ; draw the phrase cursor cell: DrawPhraseCellValue(wPhraseCol, wPhraseRow) via PhraseColLayout
6D58 PastePhraseSelection       ; wClipboardType==1: normalize sel rect vs cursor, write clipboard cells into the phrase
7072 DrawAllChanStatus          ; draw the 4 channel status cells (DrawChanStatus 0-3)
7108 DrawSpeechInstrScreen      ; instrument screen for SPEECH type: "TYPE   SPEECH" + word list (pseudo-screen $0b)
724D WordScreenInput            ; word/speech editor input dispatch (wButtons); edits words at song $3DD0 ($bdd0)
; --- data ---
4ACE TxtOutOfMemInstr           ; "OUT OF MEMORY. CLEAN INSTR DATA IN PROJECT SCREEN!"
64E1 PhraseColLayout            ; per-phrase-column draw metrics (x pos / width / flags), 6 rows x 5 cols
637D TxtDedupe                  ; "DE-DUPE..."
6388 TxtFreeing                 ; "FREEING:"
6391 TxtChainsFill              ; "CHAINS...."
639C TxtPctD                    ; "%d"
639F TxtPhrasesFill             ; "PHRASES..."
63AA TxtPctD2                   ; "%d"
63AD TxtOk2                     ; "OK!"
644D TxtDedupe2                 ; "DE-DUPE..."
6458 TxtFreeing2                ; "FREEING:"
6461 TxtInstrsFill              ; "INSTRS...."
646C TxtPctD3                   ; "%d"
646F TxtTablesFill              ; "TABLES...."
723F TxtTypeSpeech              ; "TYPE   SPEECH"
6698 CutCopyPhraseSelection ; arg!=0 -> "CUT" (copy+clear) else "COPY": phrase selection -> clipboard (clipType 1)
6B32 TxtCut1F           ; "CUT"
6B36 TxtCopy1F          ; "COPY"
6C34 DrawWordRow        ; draw the 3 allophone chars of word row (arg-1); 0 -> spaces
647A TxtPctD4                   ; "%d"
647D TxtSynthsFill              ; "SYNTHS...."
6488 TxtPctD5                   ; "%d"
648B TxtOk3                     ; "OK!"

