; Bank $1F -- instrument-editor helpers (called by bank $03) + Phrase screen update
; Per-instrument-type parameter draw handlers, dispatched by DrawInstrumentScreen
; ($03:$4F45) on the instrument's type (0=PULSE 1=WAVE 2=KIT 3=NOISE).

; --- data tables + strings (db; instrument-editor + word/phrase helpers) ---
4236 TxtDashTemplate            ; "/--/--" (value display template)
491A DefaultWaveFrameB1F        ; [16] default wave frame (WaveFrameModified compares phrase rows against it)
4A02 DefaultInstrumentPulse     ; [11] default pulse (or noise) instrument bytes (ClaimInstrumentSlot)
4A0D DefaultInstrumentWave      ; [11] default wave instrument bytes
4A18 DefaultInstrumentKit       ; [14] default kit instrument bytes
4C11 TxtOutOfTables             ; "OUT OF TABLES!"
61FF DefaultSynthParameters     ; [16] default softsynth params, memcpy'd into synth_params ($3EB2) by $61E1
77F5 TxtCopiedWord              ; "COPIED WORD"
423D DrawPulseInstrument        ; draw PULSE instrument params (type 0)
473E TxtKitSpeedHalf            ; "0.5" (DrawKitInstrument: SPEED, kit byte 2 bit 6 = half speed)
4742 TxtKitSpeedFull            ; "  1" (DrawKitInstrument: SPEED, full speed)
4746 TxtKitLen1All              ; "ALL" (DrawKitInstrument: LEN of the left kit, byte 3, when 0 = play the sample to its end)
474A TxtKitLen2All              ; "ALL" (DrawKitInstrument: LEN of the right kit, byte 11)
474E DrawWaveInstrument         ; draw WAVE instrument params (type 1)
44DD DrawKitInstrument          ; draw KIT instrument params (type 2)
4399 DrawNoiseInstrument        ; draw NOISE instrument params (type 3)
; --- instrument-screen display strings ---------------------------------------
408D StepRateString             ; "STEP" (instrument cmd/table rate when byte5 bit3 set)
4092 TickRateString             ; "TICK" (instrument cmd/table rate when byte5 bit3 clear)
44A3 LengthUnlimitedString      ; "UNLIM" (shown when sound-length byte3 bit6 = 0)
44AD NoiseSafeString            ; "SAFE" (noise S command, nonzero)
44B2 NoiseFreeString            ; "FREE" (noise S command, 0)
648F PhraseScreenUpdate         ; per-frame visual update (screen idx 1 = Phrase)
4000 DrawInstrumentTableMode    ; draw the instrument's table mode at its type's row: " OFF", or STEP/TICK by byte 5 bit 3 when the table is on (byte 6 bit 5)
4157 InstrumentEnvelopeHasSecond ; 1 if the envelope's first value moves on (byte 1's speed nibble nonzero), so its second value is used
4169 InstrumentEnvelopeHasThird ; 1 if the envelope reaches its third value (bytes 1 and 9 both have a nonzero speed nibble)
5091 IsPhraseUsedFar            ; FarCall bank01 IsPhraseUsed
5413 MarkChainPhrasesUsed       ; mark all phrases of chain arg used (rows<16, $ff skipped)
5461 IsChainUsedFar             ; FarCall bank01 IsChainUsed
7097 RedrawScreenFar1F          ; FarCall home RedrawScreen ($24dd) with bank 4 arg

; --- context-based names (named for the role their callees show) ---
409C DrawInstrumentTableField   ; draw the instrument's table field: table number (hex) if on, '--' if off
40CA DrawKitLoopMode            ; draw one kit's LOOP setting: OFF unless loopBit of byte 5 is set, else ATK if bit 7 of byte atkByte, else ON
411F DrawKitLoopField           ; the kit LOOP field: kit 1's mode (byte 5 bit 6, byte 2 bit 7), a "/", kit 2's (byte 5 bit 5, byte 9 bit 7)
418A DrawEnvelopeFields         ; draw the instrument envelope line: byte 1, the /--/-- template, bytes 9 and 10 (hex or n-)
44B7 DrawKitNameCell            ; kit number (hex) + 6-char kit name (ReadKitName)
48C5 WriteChainPhrase           ; chains[chain*16+row] = phrase (song $2080 region)
492A ClaimInstrumentSlot        ; read+mark the instr-alloc entry (song $2040); returns prior state
4B00 IsSongBlockEmpty           ; read 16 song bytes (bank, addr) into wSongReadBuffer; 1 if all are zero
4B45 IsTableFree                ; e=1 if table n has no data in its env/cmd rows (used by FindFreeTable)
4CCD FreeUnusedInstruments      ; CLEAN INSTR DATA pass: re-mark the instruments phrases use, reset the rest (name, $B080 block, column refs); e = how many allocated ones were freed
4F04 MarkTableUsed              ; set wUsedTableMap[t] (t < $20)
4F1C IsTableUsed                ; -> wUsedTableMap[t], the table's mark
4F2E IsInstrumentAllocated      ; instrument n's SramInstrumentAllocation flag
4F49 MarkPhraseTablesUsed       ; mark the tables phrase (arg)'s A commands (command 1) name: MarkTableUsed(value)
4FC5 MarkTableTablesUsed        ; mark the tables table t's two command columns name with A (MarkTableUsed)
50A8 MarkTablesOfUsedPhrases    ; mark the tables each used phrase's A commands name (MarkPhraseTablesUsed)
50CC CountUsedTables            ; count the marked tables in wUsedTableMap
50F6 MarkTablesOfUsedTables     ; mark the tables each marked table's A commands name; 1 if that marked more
513D MarkInstrumentTableUsed    ; mark instrument i's table used if its TABLE is on (byte 6 bit 5)
515F MarkTablesOfUsedInstruments ; mark the table of every allocated instrument (MarkInstrumentTableUsed)
5183 ClearTableRow              ; zero 16 bytes of one table column region (row arg <$10)
51B9 ClearTable                 ; wipe table n (<$20) across all five column regions ($3480..$3C80)
526B ClearUnusedTables          ; clear every unmarked table; -> how many of them were not empty
52B3 FreeUnusedTables           ; CLEAN INSTR: mark the tables instruments, phrases and tables use, clear the rest; -> how many were freed
52DA RemapSequenceChains        ; walk the 4 sequence columns remapping chain refs (CleanSongData step)
5478 MarkPhrasesOfUsedChains    ; mark the phrases every used chain plays (MarkChainPhrasesUsed)
549C FindDuplicatePhrase        ; does phrase b equal phrase a? compares the 16 notes, instruments, commands and command values; 1 = duplicate
5644 FindDuplicateChain         ; does chain b equal chain a? compares the 16 phrases and transposes; 1 = duplicate
573C FindDuplicateTable         ; does table b equal table a? compares fx 1/values, fx 2/values, envelopes and transposes; 1 = duplicate
5996 RemapPhraseRefs            ; walk all chains ($2080..) replacing dup phrase refs with the canonical one
5A12 RemapChainRefs             ; walk the song sequence ($B290-$B68F) replacing references to a duplicate chain with the canonical one
5A8E RemapCommandTableRefs      ; walk phrase/table cmd values replacing dup table refs (A command)
5BDE DeduplicatePhrases         ; fold duplicate phrases: for each used phrase i (hex counter at $98AE) every later used phrase FindDuplicatePhrase finds equal is remapped to i (RemapPhraseRefs)
5C78 DeduplicateChains          ; fold duplicate chains: for each used chain i (counter at $98AE) every later used chain FindDuplicateChain finds equal is remapped to i (RemapChainRefs); then OK
5D18 DeduplicateTables          ; fold duplicate tables: for each used table i (hex counter at $98AE) every later used table FindDuplicateTable finds equal is remapped to i (RemapCommandTableRefs); then draws OK
5DC9 CountUsedPhrases           ; count the phrases in use (IsPhraseUsedFar)
5DF3 CountUsedChains            ; count the chains in use (IsChainUsedFar)
5E1D RebuildPhraseAllocationMap ; clear the phrase-alloc bitmap ($3E82, 32B) + rescan via used chains
5F20 WaveFrameModified          ; 1 if synth w's wave frame (SRAM bank 3 $A000 + w*16) differs from DefaultWaveFrameB1F
5F85 SynthFramesModified        ; 1 if any of synth s's 16 wave frames differs from the default (WaveFrameModified)
5FC2 CountModifiedSynths        ; count the synths with a modified wave frame
5FEC AnyPhraseUsesCommandF      ; 1 if any phrase step holds command F (6)
6074 AnyTableUsesCommandF       ; 1 if either command column of any table holds command F (6)
614C AnyCommandFUsed            ; -> e = 1 if any phrase or table uses command F (AnyPhraseUsesCommandF / AnyTableUsesCommandF)
6163 ResetWaveFrame             ; reset wave frame n (SRAM bank 3, $A000 + n*16) to DefaultWaveFrameB1F
619E ResetSynthWaves            ; reset synth s's 16 wave frames to the default (ResetWaveFrame)
61C4 ResetSynthParameters       ; reset synth n's 16 params (SRAM bank 1, $BEB2 + n*16) to DefaultSynthParameters
620F ResetUnusedSynths          ; reset the params and waves of every synth no wave instrument plays
62BD FreeUnusedSynths           ; CLEAN INSTR: unless a phrase or table uses F, reset the synths no wave instrument uses; -> how many were freed
6B3B HighlightPhraseCell        ; colour phrase cell (col,row) as the cursor/selection: ColorField at PhraseCellX (or PhraseCellXAlternate) + 3 in the shifted draw mode, the PhraseCellWidth (or PhraseCellWidthAlternate) width through wDrawTextScratch, palette 3 on CGB / 2 on DMG (row flag $fe/$ff picks the normal tables, else the alternate ones)
6CA2 UnhighlightPhraseCell      ; colour phrase cell (col,row) in its normal palette (the PhraseCell* layout tables; HighlightPhraseCell's inverse)
6EFE ErasePhraseCursor          ; restore the phrase cursor cell's palette: UnhighlightPhraseCell(wPhraseColumn, wPhraseRow)
6F14 DrawChannelStatus          ; draw channel status cell at (16, ch+6) from wChannelOutput[ch]
70A8 SpeechCursorY              ; screen row of the speech instrument's word-list cursor: wSpeechRow + 4
70B6 EraseSpeechCursor          ; restore the word-list row's palette (alternating by row parity)
70DF DrawSpeechCursor           ; highlight the speech instrument's word-list row under wSpeechRow
; --- functions called from bank 0 (this bank paged in) ---
4A26 InitializeRemapTable       ; fill wInstrumentRemapTable..+16 with identity 0..15 (remap table for clone/dedupe)
7801 TxtCutWord                 ; "CUT WORD"
780A TxtPastedWord              ; "PASTED WORD"

; --- allocation / clean / phrase-screen helpers (FarCall targets) ---
4A65 AllocateNextFreeInstrument ; scan instr-alloc table (song $2040) for a free slot, place into phrase (bank04 $41f0); full -> OOM msg, e=$40
4BD9 FindFreeTable              ; first unused table 0-$1f; none -> ShowMessage(TxtOutOfTables), e=$ff
4C20 IsSongChainUsed            ; test chain-alloc bit for the chain under the song cursor col (wColumnChain+wSongColumn; $80+ -> 0)
62DD CleanSongData              ; project CLEAN: de-dupe chains+phrases, DE-DUPE/FREEING progress panel
63B1 CleanInstrumentData        ; project CLEAN: de-dupe instruments/tables, DE-DUPE/FREEING progress panel
64FF EnterChannelPhrase         ; e = 1 when the phrase screen moved to channel column's phrase: in live mode the one it plays, else the one on the song row's chain at the chain row (or the nearest above); 0 when it has none
6656 EnterPhraseRight           ; B+RIGHT on the phrase screen: the phrase of the nearest channel to the right that has one (EnterChannelPhrase)
6677 EnterPhraseLeft            ; B+LEFT on the phrase screen: the phrase of the nearest channel to the left that has one (EnterChannelPhrase)
6C1E DrawPhraseCursor           ; draw the phrase cursor cell: HighlightPhraseCell(wPhraseColumn, wPhraseRow) via the PhraseCell* tables
6D58 DrawPhraseSelection        ; phrase selection (wClipboardType==1) redraw vs the cursor: the one-cell ring around the rectangle via UnhighlightPhraseCell, the inside via HighlightPhraseCell
7072 DrawAllChannelStatus       ; draw the 4 channel status cells (DrawChannelStatus 0-3)
7108 DrawSpeechInstrumentScreen ; instrument screen for SPEECH type: "TYPE   SPEECH" + word list (pseudo-screen $0b)
724D SpeechInstrumentInput      ; speech instrument screen input (from InstrumentScreenInput for instrument $40): pick, rename, move, cut/copy/paste a word
; --- data ---
4ACE TxtOutOfMemInstr           ; "OUT OF MEMORY. CLEAN INSTR DATA IN PROJECT SCREEN!"
64E1 PhraseCellX                ; [5] the x of each phrase column's cell ($FF = hidden); PhraseCellXAlternate, PhraseCellWidthAlternate and PhraseCellWidth follow
64E6 PhraseCellXAlternate       ; [5] x when the step's row flag is not $FE/$FF
64EB PhraseCellWidthAlternate   ; [5] width, alt rows
64F0 PhraseCellWidth            ; [5] width
64F5 PhraseCellPaletteAlternate ; [5] highlight palette, alt rows
64FA PhraseCellPalette          ; [5] highlight palette
637D TxtDedupe                  ; "DE-DUPE..."
6388 TxtFreeing                 ; "FREEING:"
6391 TxtChainsFill              ; "CHAINS...."
639C TxtPctD                    ; "%d"
639F TxtPhrasesFill             ; "PHRASES..."
63AA TxtPctD2                   ; "%d"
63AD TxtOk2                     ; "OK!"
644D TxtDedupe2                 ; "DE-DUPE..." (CleanInstrumentData's, a second copy)
6458 TxtFreeing2                ; "FREEING:"
6461 TxtInstrsFill              ; "INSTRS...."
646C TxtPctD3                   ; "%d"
646F TxtTablesFill              ; "TABLES...."
723F TxtTypeSpeech              ; "TYPE   SPEECH": the speech instrument's type field
6698 CutCopyPhraseSelection     ; arg!=0 -> "CUT" (copy+clear) else "COPY": phrase selection -> clipboard (clipType 1)
6B32 TxtCut1F                   ; "CUT"
6B36 TxtCopy1F                  ; "COPY"
6C34 DrawWordRow                ; draw word n's 3-character name (SramWordNames + 3*(n-1), blanks for 0) or \"---\" outside 1-14
647A TxtPctD4                   ; "%d"
647D TxtSynthsFill              ; "SYNTHS...."
6488 TxtPctD5                   ; "%d"
648B TxtOk3                     ; "OK!"

