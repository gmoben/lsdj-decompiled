; Bank $1F -- instrument-editor helpers (called by bank $03) + Phrase screen update
; Per-instrument-type parameter draw handlers, dispatched by DrawInstrumentScreen
; ($03:$4F45) on the instrument's type (0=PULSE 1=WAVE 2=KIT 3=NOISE).

; --- data tables + strings (db; instrument-editor + word/phrase helpers) ---
4236 TxtDashTemplate    ; "/--/--" (value display template)
491A DefaultWaveFrame    ; [16] default wave frame (32-nibble ramp), memcpy'd into wave_frames by $6163
4A02 DefaultInstrument       ; 16-byte default instrument template
4ACE TxtOutOfMemory1F     ; "OUT OF MEMORY. CLEAN SONG DATA IN PROJECT SCREEN"
4C11 TxtOutOfTables     ; "OUT OF TABLES!"
61FF DefaultSynthParams  ; [16] default softsynth params, memcpy'd into synth_params ($3EB2) by $61E1
637D TxtDeDupe          ; "DE-DUPE..."
644D TxtDeDupe2         ; "DE-DUPE..." (second instance)
723F TxtTypeSpeech      ; "TYPE   SPEECH" (instrument-type field)
77F5 TxtCopiedWord      ; "COPIED WORD"
423D DrawPulseInstr     ; draw PULSE instrument params (type 0)
474E DrawWaveInstr      ; draw WAVE instrument params (type 1)
44DD DrawKitInstr       ; draw KIT instrument params (type 2)
4399 DrawNoiseInstr     ; draw NOISE instrument params (type 3)
; --- instrument-screen display strings ---------------------------------------
408D StepRateStr       ; "STEP" (instrument cmd/table rate when byte5 bit3 set)
4092 TickRateStr       ; "TICK" (instrument cmd/table rate when byte5 bit3 clear)
44A3 LenUnlimStr       ; "UNLIM" (shown when sound-length byte3 bit6 = 0)
44AD NoiseSafeStr      ; "SAFE" (noise S command, nonzero)
44B2 NoiseFreeStr      ; "FREE" (noise S command, 0)
648F PhraseScreenUpdate ; per-frame visual update (screen idx 1 = Phrase)
4000 InstrGetField0_4000    ; instrument field 0x0 read (4x)
4157 InstrGetField1_4157    ; instrument field 0x1 read (2x)
4169 InstrGetField9_4169    ; instrument field 0x9 read (1x)
5091 InstrBanked_5091       ; banked-call wrapper (5x)
5413 InstrBanked_5413       ; banked-call wrapper (1x)
5461 InstrBanked_5461       ; banked-call wrapper (4x)
7097 InstrBanked_7097       ; banked-call wrapper (4x)
4085 InstrGetField6_4085    ; instrument field 0x6 read

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
409C InstrGetField6_409C        ; instrument field 0x6 read
40CA InstrGetField5_40CA        ; instrument field 0x5 read
411F InstrHDrawStr_411F         ; calls DrawStringIndexed
418A InstrGetField1_418A        ; instrument field 0x1 read
44B7 InstrHDrawHex_44B7         ; calls DrawHexByte
48C5 InstrHSongWrite_48C5       ; calls WriteSongByte
492A InstrHInstrWrite_492A      ; calls WriteInstrByte
4B00 InstrHReadTableRow         ; read a 16-byte row from SRAM (ReadSongBytes) -> $c46d, then scan it
4B45 InstrHTableTrans_4B45      ; accesses TableTrans
4CCD InstrHSongWrite_4CCD       ; calls WriteSongByte
4F04 InstrHMarkTableUsed        ; if arg<$20, set $c47d[arg]=1 (mark table used)
4F1C InstrHGetTableUsed         ; return $c47d[arg] (table-used flag)
4F2E InstrHReadPhraseRef        ; read SRAM byte at $A040+arg (ReadSongByte bank1)
4F49 InstrHPhraseNote_4F49      ; accesses PhraseNote
4FC5 InstrHTableCmd1_4FC5       ; accesses TableCmd1
50A8 InstrHScanUsedPhrases      ; for each phrase 0..255 used (InstrBanked_5091), process via InstrHPhraseNote_4F49
50CC InstrHCountUsedTables      ; count nonzero entries in used-table map $c47d[0..$1f]
50F6 InstrHProcessUsedTables    ; count tables (50CC) then run InstrHTableCmd1_4FC5 per used
513D InstrHMarkInstrTable       ; read instr field6; if bit5 set, mark its table used (InstrHMarkTableUsed)
515F InstrHScanInstrTables      ; for each instrument 0..63 used, mark its table (InstrHReadPhraseRef/513D)
5183 InstrHSongWrite_5183       ; calls WriteSongByte
51B9 InstrHTableTrans_51B9      ; accesses TableTrans
526B InstrHCollectUsedTables    ; gather used-table indices + pointers from map $c47d
52B3 InstrHMemFill_52B3         ; calls MemSet
52DA InstrHSeqRead_52DA         ; calls ReadSeqByte
5478 InstrHScanUsedChains       ; for each chain 0..127 used (InstrBanked_5461), process (InstrBanked_5413)
549C InstrHPhraseNote_549C      ; accesses PhraseNote
5644 InstrHChainPhrase_5644     ; accesses ChainPhrase
573C InstrHTableTrans_573C      ; accesses TableTrans
5996 InstrHChainPhrase_5996     ; accesses ChainPhrase
5A12 InstrHSong_5A12            ; accesses Song
5A8E InstrHInstrWrite_5A8E      ; calls WriteInstrByte
5BDE InstrHDrawHex_5BDE         ; calls DrawHexByte
5C78 InstrHDrawHex_5C78         ; calls DrawHexByte
5D18 InstrHDrawHex_5D18         ; calls DrawHexByte
5DC9 InstrHCountUsedPhrases     ; count used phrases 0..255 (InstrBanked_5091)
5DF3 InstrHCountUsedChains      ; count used chains 0..127 (InstrBanked_5461)
5E1D InstrHMemFill_5E1D         ; calls MemSet
5F20 InstrHPhraseNote_5F20      ; accesses PhraseNote
5F85 InstrHScanChainPhrases     ; scan the 16 phrase slots of a chain (arg*16) for usage
5FC2 InstrHScanAllChainPhr      ; for 16 chains, scan their phrases (InstrHScanChainPhrases)
5FEC InstrHScanPhraseCmds       ; scan phrase command bytes from SRAM ($A0xx) for references
6074 InstrHScanTableCmds        ; scan table command columns from SRAM ($B680/$BA80) for references
614C InstrHAnyCmdRef            ; return 1 if InstrHScanPhraseCmds or InstrHScanTableCmds found a reference
6163 InstrHPhraseAddr           ; compute SRAM phrase address (arg*16 + base)
619E InstrHScanChainRows        ; scan 16 rows of a chain (arg*16)
61C4 InstrHSongAddr             ; compute SRAM song-area address (arg*16 + $B2xx)
620F InstrHScanTableRows        ; scan 16 table rows from a pointer
62BD InstrHDrawStr_62BD         ; calls DrawString
6B3B InstrHDrawStr_6B3B         ; calls DrawStringIndexed
6CA2 InstrHReadCursorCell       ; read cell via ROM table $64E1 + cursor offsets (args sp+7/sp+8)
6EFE InstrHReadCursorCellAt     ; read cell at cursor $c415/$c416 (InstrHReadCursorCell)
6F14 InstrHDrawStr_6F14         ; calls DrawStringIndexed
70A8 InstrHGetParamPlus4        ; return $c429 + 4
70B6 InstrHDrawParamField       ; draw a field from $c429 (parity-based) via InstrHGetParamPlus4
70DF InstrHDrawStr_70DF         ; calls DrawStringIndexed
; --- functions called from bank 0 (this bank paged in) ---
4A26 WordHelper         ; word/speech helper
