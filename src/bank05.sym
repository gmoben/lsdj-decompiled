; Bank $05 -- Table screen. tables[wTable][16], 4 columns in SRAM:
; envelope $B690 (bank0), transpose $B480, cmd1 $B680, cmd2 $BA80 (bank1).
4360 GetTableEnvelope  ; editor: read table_envelopes[wTable][step] (song $1690 / SRAM bank0 $B690)
4491 GetTableTranspose ; editor: read table_transposes[wTable][step] (song $3480 / SRAM bank1 $B480)
4668 ReadTableStep       ; read the 4 columns (env/transpose/cmd1/cmd2) for table[wTable][step]
4762 DrawTableScreen     ; screen idx 5: draws the table (env/transpose/cmd cols)
4967 TableScreenUpdate  ; per-frame visual update (screen idx 5)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 TableDrawStr_4000          ; calls DrawStringIndexed
4167 TableSelectScreen          ; navigation: pick wCurrentScreen ($c401) from mode $c900 + state $c901/$c902 vs $c8ff + jump table $41bf
420C TableResetScroll           ; store arg -> $c903, then zero rSCX/rSCY
421A TableBanked_421A           ; banked-call wrapper
42A4 TableDrawStr_42A4          ; calls DrawStringIndexed
42E7 TableGetCellA              ; address table column-A cell: base ptr $c447 + wTable*32 + row(arg<16); bounds-checked
43B7 TableSongWrite_43B7        ; calls WriteSongByte
442A TableSongWrite_442A        ; calls WriteSongByte
44E8 TableReadEnv          ; read table_envelopes[table][row<$10] from SRAM (bounds-checked)
453B TableGetCellB              ; address table column-B cell: base ptr $c449 + wTable*32 + row(arg<16); bounds-checked
459E TableReadTrans        ; read table_transposes[table][row<$10] from SRAM (bounds-checked)
45F1 TableColumnLookup     ; map table column $c92f via ROM tables $42D5/$42DB (uses $c930, $c413); called across the table screen
472B TableDrawStr_472B          ; calls DrawStringIndexed
4930 TableInputFlag             ; return e=flag derived from input code (arg sp+4: 4 or $0a) and column $c92f
4AA8 TableDrawHex_4AA8          ; calls DrawHexByte
61CA TableBanked_61CA           ; banked-call wrapper
64A3 TableHandleInput           ; table-screen input/cursor handler ($c411 mode, wCursorX/Y); large
676A TableUpdateScreen          ; main table-screen update/draw (large; also entered from DrawTableScreen)