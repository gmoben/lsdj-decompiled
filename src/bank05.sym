; --- Table-screen clipboard strings (db) ---
61B5 TxtCancelSelect05  ; "CANCEL SELECT"
6764 TxtPaste05         ; "PASTE"
72A3 TxtSignalWave      ; "SIGNAL WAVE" (W command / FX usage help)

; Bank $05 -- Table screen. tables[wTable][16], 4 columns in SRAM:
; envelope $B690 (bank0), transpose $B480, cmd1 $B680, cmd2 $BA80 (bank1).
4360 GetTableEnvelope  ; editor: read table_envelopes[wTable][step] (song $1690 / SRAM bank0 $B690)
4491 GetTableTranspose ; editor: read table_transposes[wTable][step] (song $3480 / SRAM bank1 $B480)
4668 ReadTableStep       ; read the 4 columns (env/transpose/cmd1/cmd2) for table[wTable][step]
4762 DrawTableScreen     ; screen idx 5: draws the table (env/transpose/cmd cols)
4967 TableScreenUpdate  ; per-frame visual update (screen idx 5)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 MapUpdateTopRow            ; recompute wMapProjectCol/wMapSynthCol from wMapCol when on the map middle row
4167 MapEnterScreen             ; SEL+B screen map: set wCurrentScreen from wMapRow/wMapCol (row0=PROJECT/WAVE/SYNTH, row1=SONG CHAIN PHRASE INSTR TABLE, row2=GROOVE)
420C MapStartTransition         ; store move direction (1=up 2=right 3=down 4=left) -> wMapMoveDir, reset rSCX/rSCY
421A MapCancelSelection         ; if select mode (wCursorMode==4) restore pre-selection state before leaving the screen
42A4 TableDrawStr_42A4          ; calls DrawStringIndexed
42E7 TableGetCellA              ; address table column-A cell: base ptr $c447 + wTable*32 + row(arg<16); bounds-checked
43B7 TableSongWrite_43B7        ; calls WriteSongByte
442A TableSongWrite_442A        ; calls WriteSongByte
44E8 TableReadEnv          ; read table_envelopes[table][row<$10] from SRAM (bounds-checked)
453B TableGetCellB              ; address table column-B cell: base ptr $c449 + wTable*32 + row(arg<16); bounds-checked
459E TableReadTrans        ; read table_transposes[table][row<$10] from SRAM (bounds-checked)
45F1 TableColumnLookup     ; map table column $c92f via ROM tables $42D5/$42DB (uses $c930, $c413); called across the table screen
472B TableDrawStr_472B          ; calls DrawStringIndexed
4930 TableInputFlag             ; return e=flag derived from input code (arg sp+4: 4 or $0a) and column $c92f
4AA8 TableDrawHex_4AA8          ; calls DrawHexByte
61CA TableBanked_61CA           ; banked-call wrapper
64A3 TableHandleInput           ; table-screen input/cursor handler ($c411 mode, wCursorX/Y); large
676A TableUpdateScreen          ; main table-screen update/draw (large; also entered from DrawTableScreen)
; --- functions called from bank 0 (this bank paged in) ---
4B5D TableFieldFunc     ; table-field access (wTable)
4040 MapDrawTopRow      ; draw the map top-row entries (PROJECT + WAVE/SYNTH) at wMapProjectCol/wMapSynthCol, screen row 15
61C3 TxtSelect05       ; "SELECT" (pairs with TxtCancelSelect05)

; --- screen-map navigation (SEL+direction) + selection save ---
4233 MapMoveLeft        ; dec wMapCol, MapEnterScreen, MapStartTransition(4), MapDrawTopRow
4253 MapMoveRight       ; inc wMapCol, MapEnterScreen, MapStartTransition(2), MapUpdateTopRow
426A MapMoveUp          ; dec wMapRow, MapEnterScreen, MapStartTransition(1)
4287 MapMoveDown        ; inc wMapRow (max 2), MapEnterScreen, MapStartTransition(3)
7208 GetSynthFieldHelp  ; -> bc = help string for the selected synth field (jump table by wSynthCursor)
743F SaveSelectionState ; wCursorMode/wClipboardType/wSelLeft/Top/Right/... -> $cbd2 save area
747D RestoreSelectionState ; $cbd2 save area -> wCursorMode/wClipboardType/wSel*
69BD DrawInstrFieldHelp ; pick + draw the instr-screen bottom help string by wInstrField/arg (TYPE -> TxtHelpInstrType)
6F38 TxtHelpInstrType   ; "USE PULSE IN PU1/PU2; WAVE/KIT IN WAV; NOISE IN NOI"
