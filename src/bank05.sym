; --- Table-screen clipboard strings (db) ---
61B5 TxtCancelSelect05  ; "CANCEL SELECT"
6764 TxtPaste05         ; "PASTE"
72A3 TxtSignalWave      ; "SIGNAL WAVE" (W command / FX usage help)

; Bank $05 -- Table screen. tables[wTable][16], 4 columns in SRAM:
; envelope $B690 (bank0), transpose $B480, cmd1 $B680, cmd2 $BA80 (bank1).
4360 TableWriteEnv              ; write table_envelopes[wTable][step] = v (SRAM bank 0 $B690); asserts step < $10, wTable < $20
4491 TableWriteTranspose            ; write table_transposes[wTable][step] = v (SRAM bank 1 $B480); asserts step < $10, wTable < $20
4668 ReadTableStep       ; read the 4 columns (env/transpose/cmd1/cmd2) for table[wTable][step]
4762 DrawTableScreen     ; screen idx 5: draws the table (env/transpose/cmd cols)
4967 TableScreenUpdate  ; per-frame visual update (screen idx 5)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 MapUpdateTopRow            ; recompute wMapProjCol/wMapSynthCol from wMapCol when on the map middle row
4167 MapEnterScreen             ; SEL+B screen map: set wCurScreen from wMapRow/wMapCol (row0=PROJECT/WAVE/SYNTH, row1=SONG CHAIN PHRASE INSTR TABLE, row2=GROOVE)
420C MapStartTransition         ; store move direction (1=up 2=right 3=down 4=left) -> wMapMoveDir, reset rSCX/rSCY
421A MapCancelSelection         ; if select mode (wCursorMode==4) restore pre-selection state before leaving the screen
42A4 DrawCmdLetter              ; draw an FX command letter cell (FxMnemonics char via DrawStringIndexed; >$13 asserted)
42E7 TableReadCmd               ; read the command column (wTableCellAPtr) at step; 0 unless a command (<= $13)
43B7 TableWriteCmd              ; write the command column (wTableCellAPtr) at step; asserts cmd <= $13
442A TableWriteVal              ; write the value column (wTableCellBPtr) at step
44E8 TableReadEnv          ; read table_envelopes[table][row<$10] from SRAM (bounds-checked)
453B TableReadVal               ; read the value column (wTableCellBPtr) at step
459E TableReadTranspose        ; read table_transposes[table][row<$10] from SRAM (bounds-checked)
45F1 TableEraseCursor           ; restore the cursor cells to their column palette (TableColPal) at row wTableRow+2, unless selecting
472B DrawTableEnv               ; draw a table envelope cell (lo-nibble $F -> hi-nibble + release glyph)
4930 TableInputFlag             ; return e=flag derived from input code (arg sp+4: 4 or $0a) and column $c92f
4AA8 TableDrawCursor            ; refresh the table cursor cell (select mode -> DrawTableSelection; palette by CGB)
61CA CutCopyTableSelection      ; arg? "CUT" (copy+clear) : "COPY": table selection -> clipboard (clipType 5)
64A3 TablePasteCells            ; table-screen paste: clipboard cells into rows from wTableRow (a phrase selection's CMD pair too; swaps the two CMD/value pairs; "PASTE" for more than one row)
676A DrawTableSelection         ; table selection (wClipboardType==5) redraw vs the cursor: cells around the rectangle in their column palettes, the inside highlighted (ColorField)
; --- functions called from bank 0 (this bank paged in) ---
4B5D TableScreenInput           ; the table screen's input: A writes envelopes/transposes/commands (a free table on an A command's value), A+directions step cells by 1/16 over the row or selection, B+directions change table, A+B cuts, select+A pastes, start plays, select+DOWN opens a G command's groove, select+B selects
4040 MapDrawTopRow      ; draw the map top-row entries (PROJECT + WAVE/SYNTH) at wMapProjCol/wMapSynthCol, screen row 15
61C3 TxtSelect05       ; "SELECT" (pairs with TxtCancelSelect05)

; --- screen-map navigation (SEL+direction) + selection save ---
4233 MapMoveLeft        ; dec wMapCol, MapEnterScreen, MapStartTransition(4), MapDrawTopRow
4253 MapMoveRight       ; inc wMapCol, MapEnterScreen, MapStartTransition(2), MapUpdateTopRow
426A MapMoveUp          ; dec wMapRow, MapEnterScreen, MapStartTransition(1)
4287 MapMoveDown        ; inc wMapRow (max 2), MapEnterScreen, MapStartTransition(3)
7208 GetSynthFieldHelp  ; -> bc = help string for the selected synth field (jump table by wSynthCursor)
743F SaveSelectionState ; wCursorMode/wClipboardType/wSelectionLeft/Top/Right/... -> $cbd2 save area
747D RestoreSelectionState ; $cbd2 save area -> wCursorMode/wClipboardType/wSel*
69BD DrawInstrFieldHelp ; instrument-screen help line: the string for wInstrField under instrument type arg (TYPE row: TxtHelpInstrType) -> ShowMessage
6F38 TxtHelpInstrType   ; "USE PULSE IN PU1/PU2; WAVE/KIT IN WAV; NOISE IN NOI"
6D25 TxtHelpEnvStage1           ; "ENVELOPE STAGE 1: ..." (DrawInstrFieldHelp reaches these ten shared strings by constant address)
6D72 TxtHelpEnvStage2           ; "ENVELOPE STAGE 2: ..."
6DBF TxtHelpEnvStage3           ; "ENVELOPE STAGE 3: ..."
6E0C TxtHelpPan                 ; "LEFT/RIGHT/BOTH/NONE"
6E21 TxtHelpLength              ; "LENGTH [N/256 SECS]"
6E35 TxtHelpPitchMode           ; "P/L/V CMDS: FAST=358 HZ UPDATE; ..."
6EB5 TxtHelpTransposeOk         ; "ALLOW TRANSPOSES?"
6EC7 TxtHelpCmdRate             ; "SLOWS C+R COMMANDS, P+V TOO IF PITCH=TICK"
6EF1 TxtHelpTableMode           ; "TABLE ADVANCE: TICK=EVERY TICK, STEP=EVERY NOTE"
6F21 TxtHelpVolume              ; "AMPLITUDE=0/25/50/100%"
6F6C TxtHelpPulseWidth          ; "PULSE WIDTH 12/25/50/75%"
6F85 TxtHelpPu1Sweep            ; "PU1 PITCH CHANGE: 1ST DIGIT=TIME, 2ND DIGIT=INC/DEC"
6FCB TxtHelpPuDetune            ; "DETUNES PU1 DOWN, PU2 UP"
7000 TxtHelpSynthToPlay         ; "SYNTH TO PLAY. SYNTH N=WAVES N0-NF"
7023 TxtHelpWavePlayMode        ; "MANUAL=PLAY SINGLE WAVE ...; RESYNC=RESTART WAVE ON EACH STEP"
70B5 TxtHelpTicksPerStep        ; "TICKS/STEP"
70E3 TxtHelpKitLeft             ; "SAMPLE KIT [LEFT]"
70F5 TxtHelpKitRight            ; "SAMPLE KIT [RIGHT]"
7108 TxtHelpPitchShift          ; "PITCH SHIFT"
649A TxtCut05                   ; "CUT"
649E TxtCopy05                  ; "COPY"
42D5 TableColX                  ; x of the six table screen columns (VOL TSP CMD VAL CMD VAL)
42DB TableColWidth              ; widths of the six table screen columns
42E1 TableColPal            ; normal palette of the six table screen columns (1 on the command columns)

