6BB8 .done                      ; common exit of SoundLiveQueueRange
6CB1 .loop                      ; loop head in SoundStartChannelFromRow
6D93 .done                      ; common exit of SoundStartChannelFromRow
6DA6 .loop                      ; loop head in SoundStartChannels
6E0D .done                      ; common exit of SoundStartChannels
6E22 .done                      ; common exit of SoundStartRange
6E2E .loop                      ; loop head in SoundLiveStopRange
6EA3 .done                      ; common exit of SoundLiveStopRange
6F61 .done                      ; common exit of SoundLiveStartQueued
6F87 .loop                      ; loop head in SoundGetChainPhrase
7032 .done                      ; common exit of SoundStepWavFrames
735E .done                      ; common exit of SoundPhraseHop
73AC .done                      ; common exit of SoundTableMaybeHop
75C2 .done                      ; common exit of SoundReadChannelStep
76F2 .loop                      ; loop head in SoundUpdateChannel
77EC .done                      ; common exit of SoundUpdateChannel
786D .done                      ; common exit of SoundTick
78C2 .done                      ; common exit of SoundLiveChainEnd
792A .done                      ; common exit of SoundToggleSongPlayback
799D .loop                      ; loop head in SoundStartSongPlayback
