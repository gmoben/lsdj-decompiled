; Bank $02 -- sound engine. Entry: the main loop pages in this bank and calls
; SndRunFrame ($556A) once per frame. Backbone (verified by tracing):
;   SndRunFrame  -- tempo gate ($cb6f frame-skip, $cb70 tick-repeat) -> run SndTick N times
;   SndTick      -- one tick: SndStepAllChannels then SndUpdateAllChannels
;   SndStepAllChannels  -- ProcessChannel for each active channel (order WAV,PU1,PU2,NOI):
;                          advance phrase via channel cursors, read note/instrument/command,
;                          run the per-tick FX command (DispatchFxCommand)
;   SndUpdateAllChannels -- SndUpdateChannel per channel: write GB sound regs / run tables
; Channels: hSoundCh ($FF8B) 0-3 = PU1/PU2/WAV/NOI -> rAUD1/2/3/4; KIT plays on WAV.
; Per-channel state is a struct-of-arrays at $C0xx-$C3xx (see constants/ram.inc wChan*);
; working read-cursors are 16-bit ptrs whose low bytes live at $C8xx (InitSoundStatePtrs
; sets them to channel 0, SndAdvanceStatePtrs steps to the next channel).
494D ProcessChannel     ; per-channel sound tick (channel = hSoundCh); called per active channel
49B7 NoteToPeriod       ; wChanFreq[ch] = wNotePeriods[note+wNoteTranspose-1] (alt linear table at bank0 $09B9)
4C2D AdvanceChanCursors ; advance the 3 phrase cursors (note/cmd, cmdval, instr) by c
4AA3 WriteChannelFreq   ; write the current channel's frequency to rAUDxLOW/HIGH each tick (no retrigger; P/L/V pitch)
; --- Note trigger: write the GB sound regs to start a note on the current channel
6007 TriggerNote        ; dispatch by hSoundCh to the per-voice trigger below
604B TriggerPU1         ; PU1 note-on: rAUD1 sweep/env/freq + trigger
6091 TriggerPU2         ; PU2 note-on: rAUD2 env/freq + trigger
60D1 TriggerWave        ; WAV note-on: rAUD3 level/freq + trigger
6014 TriggerNoise       ; NOI note-on: rAUD4 len/env/poly + trigger
5151 ReadChanCursor     ; read byte via channel hSoundCh's 16-bit cursor (array base in hl); SRAM-guarded
485A InitSoundStatePtrs ; set $C8xx to the low-bytes of the engine's $C1xx state ptrs
; --- Note-on: load instrument from SRAM into wSoundParams, set up channel shadows -
5934 SetupChannelSound  ; dispatch by hSoundCh to the per-channel setup block below
5942 SetupSoundPU1      ; PU1: stage wSoundParams -> sweep/env/duty/freq shadows + trigger
5A27 SetupSoundPU2      ; PU2: stage wSoundParams -> env/duty/freq shadows + trigger
5B0C SetupSoundWave     ; WAV/KIT: stage wSoundParams -> wave level/freq shadows + trigger
5DB2 SetupSoundNoise    ; NOI: stage wSoundParams -> env/poly shadows + trigger
4F33 FillChan8         ; write a -> 8 consecutive bytes [hl] (clears a per-channel 16-bit array)
4F37 FillChan4         ; write a -> 4 consecutive bytes [hl] (clears a per-channel [4] array)
; --- Table macro playback (per-channel; runs the instrument's table) ----------
4668 ProcessChannelTable ; advance/apply the channel's table (wChanTable/Played/Countdown); calls the column readers
574B ReadTableEnvelope  ; read table_envelopes[wChanTable][row] (song $1690 = SRAM bank0 $B690)
587D ReadTableTranspose ; read table_transposes[wChanTable][row] (song $3480 = SRAM bank1 $B480)
487E ReadGroove         ; read grooves[wChanGroove][wChanGrooveRow] (song $1090 = SRAM bank0 $B090) via wPtrGroove/GrooveRow
; --- Sequencer: song row -> chain -> phrase resolution ------------------------
48D2 AdvanceSongRow     ; on wChanChain[ch]==$FF, walk chain_assignments (loop-back) -> next chain
5EAD ReadSongChain      ; e = chain_assignments[wChanSongRow[ch]][ch] ($B290 = song offset $1290)
5E7C ReadChainPhrase    ; e = CHAIN_PHRASES[wChanChain[ch]*16 + wChanChainRow] (SRAM bank1 $A080) -> wChanPhrase
; --- Per-tick FX command dispatch (command value in a -> FxCommandTable) -------
; Command values index the same table as the mnemonics at $0824 ("-ABCDEFGH...").
; B/D/G/H have null handlers here -- they act at note-trigger, not per tick.
4790 DispatchFxCommand  ; a = command value (<19); jp FxCommandTable[a]
47A2 FxCommandTable     ; [19] per-tick command handler pointers (0 = no per-tick action)
4679 FxCmd_A            ; A: table start/stop
476C FxCmd_C            ; C: chord
46D8 FxCmd_E            ; E: amplitude envelope
46F7 FxCmd_F            ; F: wave frame / finetune
4812 FxCmd_S            ; S: sweep / shape
47C8 FxCmd_W            ; W: wave / duty cycle
4286 FxCmd_L            ; L: slide (legato)
6246 FxCmd_M            ; M: master volume
665F FxCmd_O            ; O: output (panning)
6646 FxCmd_P            ; P: pitch bend / shift
45D8 ApplyPitchBend     ; FxCmd_P tonal-channel impl: set up pitch bend from hFxValue (per-chan accum $C248)
43D8 PitchBendTable     ; [256] 16-bit exponential pitch curve; ApplyPitchBend reads [$43D8 + 2*hFxValue]
6669 FxCmd_T            ; T: tempo
649D FxCmd_R            ; R: retrig
65F3 FxCmd_K            ; K: kill note
7DD1 FxCmd_V            ; V: vibrato
7D81 VibDepthTable      ; [16] vibrato depth curve, FxCmd_V reads [$7D81 + (hFxValue & $0f)]
7D91 VibRateTableA      ; [16] 16-bit vibrato rate (type A); [$7D91 + 2*(hFxValue>>4)]
7DB1 VibRateTableB      ; [16] 16-bit vibrato rate (type B); selected by wChanVibType
7EAC KitPitchTable              ; per-pitch kit sample step deltas (SndSetKitParams)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 SndFxParsePitchVal         ; parse an FX value (mask $80/$0f) -> SndSetVibratoParams
4033 SndApplyVibratoStep        ; apply hFxValue high nibble to pitch acc $c4d6; clamp via SndClampAcc6Hi
40E6 SndClampAcc6Hi             ; if pitch acc $c4d6:d7 >= limit $c4de:df, clamp to it & ret 0; else ret 1
410C SndClampAcc4Hi             ; if pitch acc $c4d4:d5 >= limit $c4dc:dd, clamp to it & ret 0; else ret 1
4132 SndStepAcc4                ; pitch acc $c4d6:d7 = $c4d4:d5 + $10 (16-bit, saturating compare)
4208 SndClampAccAHi             ; clamp pitch acc $c4da:db to limit $c4e2:e3 (ret 0 if clamped)
422E SndClampAcc8Hi             ; clamp pitch acc $c4d8:d9 to limit $c4e0:e1 (ret 0 if clamped)
4254 SndStepAcc8                ; pitch acc $c4da:db = $c4d8:d9 + $10 (16-bit)
4276 SndDivMod                  ; 16-bit hl / 8-bit c -> quotient in l, remainder in a (shift-subtract)
43CE SndFxTableJump             ; FX dispatch via computed jump (jp hl region)
4637 SndClampNoteRange          ; clamp a note value to playable range ($3c..$78) -> $c422
46C7 SndClearChanFxSlots        ; clear this channel's 3 FX slots ($c2f0/$c2f4/$c2f8 + ch)
472F SndRunTableColumn          ; dispatch one table column (-> SndRunFxSlot / SndResetPitchState)
4753 SndRunChannelFxSlots       ; iterate the 12-entry FX-slot table $c2f0, run SndRunTableColumn per active
478D SndDispatchStoredFx        ; load command from $c8c4, fall into DispatchFxCommand
483F SndAdvanceTableCursor      ; advance this channel's table read cursor ($c8e1 ptr + $c140[ch])
48AB SndAdvanceGroove           ; step the channel's groove row (wrap 15 / skip zero-tick), reload the note tick countdown
4B8A SndReadChainTranspose      ; read chain_transposes[wChanChain[ch]] from SRAM bank1 ($A880, di/ei guarded) -> per-channel shadow $c3fc[ch]
4BC5 SndTransposeNote           ; add chain transpose (wChanChainTrans, song/chain mode) + global transpose to the note; skip if wChanTranspose set
4C26 AdvanceCurChanCursors      ; set de=hSoundCh*2, c=a (amount), then fall into AdvanceChanCursors (advance current channel's cursors by a)
4C42 SndAnyChannelActive        ; scan the 8 wChanActive flags ($C0E0..7); return nz (flag in a) if any channel is active, z if none
4C4E SndStartChannel            ; handle $c0e4 (re)start request: read seq (SndStartChanFromRow), set retrigger $c4cd, clear request
4C68 SndLoadChannelInstr        ; read the channel's instrument number from SRAM bank3 via its $c140[ch] cursor -> wChanInstr shadow ($c0c8/$c210[ch]); then SndLoadInstrument
4C9C SndReadChainRow            ; read the current chain row (cp $ff = end-of-chain)
4CBF SndAdvanceChainRow         ; advance the chain row, load that row's phrase; end-of-chain handling at row 16/$ff
4D71 SndStepAllChannels         ; run ProcessChannel (sequencer step: advance phrase, read note/cmd) for each active channel, order WAV,PU1,PU2,NOI
4DA9 SndEnterSongRow            ; commit wChanNextSongRow -> wChanSongRow, load its chain ($ff -> scan up)
4E17 SndMaskLow5                ; return a & $1f
4E2A SndDecodeNibbles           ; split a byte into hi/lo nibbles ($f0/$10/$0f)
4E69 SndQueueSyncByte           ; store a byte to $cbdc / wSyncTxByte (sync transmit)
4E74 SndDeactivateChannel       ; clear wChanActive[ch] and $c0e4[ch] (stop this channel)
4EA3 SndResetFxState            ; clear retrigger $c4cd, $c8f4, $c4ce, $c552
4F2B FillChan16                 ; write a -> 16 consecutive bytes [hl] (staggered entry into the FillChan8/4 unrolled memset)
4F2F FillChan12                 ; write a -> 12 consecutive bytes [hl] (staggered entry into the FillChan8/4 unrolled memset)
4F3C SndDecodeCmdNibbles        ; decode a command's nibbles ($01/$02 cases)
4FC0 SndApplyTableCmd           ; (cp $02) SndReadSramByteVia then jp SndClampNoteRange
503C SndReadSramByteVia         ; read [hl-pointer] from SRAM ($0a enable, di/reti) -> e
504A SndRunTableStep            ; run a table step (SndDecodeCmdNibbles, SndTableStepDispatch)
5074 SndBank0Call5074           ; call bank0 helpers $33f9 then $3758 (d=$0f)
507F SndAdvanceStatePtrs        ; advance the 7 working sound-state pointers (low bytes $c8df/e1/e3/e5/e7/eb/ed) to the next channel's slot in the $C1xx tables (counterpart of InitSoundStatePtrs)
509C SndReadPhraseCmd           ; fetch phrase FX cmd+val for the current row (SRAM bank 2 phrase_fx); H/W special-cased
50E1 SndReadTableCmd1           ; fetch table CMD1-column cmd+val via $c118/$c130 stream ptrs
5119 SndReadTableCmd2           ; fetch table CMD2-column cmd+val via $c120/$c138 stream ptrs
5165 SndReadCmdStream           ; read command-stream bytes ($c8fb; cp $ff = end)
5345 SndSetupWaveChannel        ; ch2 (WAV/KIT): seed working ptrs ($c8ef/e3/e5/e7/fc), SndReadCmdStream
5459 SndReadCursorByte          ; read a byte via $c110[ch] cursor + $c8ed (SRAM-guarded)
5477 SndApplyTablePitch         ; apply table transpose/pitch to a note (nibble masks)
54D7 SndUpdateAllChannels       ; output phase of a tick: for each active channel (wChanActive $C0E0..7) set hSoundCh and call SndUpdateChannel (writes sound regs / runs tables)
556A SndRunFrame                ; per-frame sound entry (called from main loop, bank00 $2317): tempo gate -- if $cb6f pending skip it; else run SndTick 1+$cb70 times this frame
5583 SndApplyTableTranspose     ; jp target from SndStepTablePtrs: read table_transpose row, add to the channel note, apply (SndApplyTablePitch)
55AE SndReadChanState55AE       ; read channel state via SndAdvanceGrooveCursor
55CB SndReadChainEnd            ; chain end-marker check (cp $ff)
55EF SndDecodeTransA            ; SndApplyTablePitch / SndDecodeNibbles
5604 SndDecodeTransB            ; SndApplyTablePitch / SndDecodeNibbles (variant)
561B SndReadGrooveOrSpeed       ; (cp $20) groove vs speed -> SndGrooveStep / $cbbf
5657 SndStepTablePtrs           ; advance the channel's table step counter; on 16-step wrap rebuild SRAM read-pointers ($c1xx) for the table transpose ($B480) and command ($BA80) columns of wChanTable[ch]
56E1 SndReadGrooveVal           ; (cp $20/$08) -> SndGrooveStep, $cbbf
572B SndSetVibratoParams        ; set vibrato state $cbc6/$c2d9/$cbc7
5778 SndSetKitParams            ; set kit state $c694/$c8f1/$c695
583F SndSplitPhraseNibbles      ; wChanPhrase[ch] -> hi/lo nibbles (compute phrase index)
58C7 SndFillFF                  ; write $ff to a run of consecutive bytes [hl]
58EA SndLoadInstrument          ; copy the 16-byte instrument record instruments[a] (SRAM bank1 $B080+a*16) into wSoundParams ($C0D0)
5F5E SndSetupChanState5F5E      ; set $c14f/$c14d then SndSetupLfoWavNoi
5FA7 SndSetChanState5FA7        ; set $c14e/$c319
5FBE SndSetChanState5FBE        ; SndSetChanState5FA7 then $c69c
5FDA SndSetChannelEnable        ; enable/disable this channel in rAUDENA (per hSoundCh; SndWritePanning)
61A9 SndWritePanning            ; set this channel's panning bits in rAUDTERM
61F7 SndClearVoiceHram          ; clear $ffa0-$ffa3 (per-voice HRAM shadow regs)
6270 SndUpdateWavFreq           ; WAV channel: recompute sample step from wChanFreq when the update flag is set
6479 SndBank0Call6479           ; call bank0 helpers $33f9 then $3758
6577 SndSetupWaveTrigger        ; wave/kit trigger helper (SndSetupChanState5F5E)
6685 SndRunFxSlot               ; set hSoundCh = $c527 & 3, run SndSetupWaveTrigger
6694 SndTableEnvDispatch        ; table-envelope command dispatch
66E7 SndResetPitchState         ; per-channel jp-table: clear wChanSlideNoteSrc, center wChanPitchCur ($8000), reset wChanCmdStep
6904 SndTableStepDispatch       ; table-step jump table (jp hl), SndClampNoteRange
69C3 SndMapFxLow3               ; map hFxValue & 7 via ROM table $69d7
69DF SndTriggerPU1Plus          ; TriggerPU1 then SndSetupLfo
6A94 SndCheckRetrigState        ; retrigger-state checks (cp [hl], $03)
6B59 SndCheckChanMode           ; channel-mode check (cp $04)
6B9B SndUpdateRetrig            ; SndCheckChanMode / SndCheckRetrigState (advance retrigger)
6BBA SndStartChanFromRow        ; start this channel playing from wChanNextSongRow ($ff -> stop path)
6D97 SndStartChannels           ; start channels [$c8dd..$c8de] from wSongRow (per-screen playback entry)
6E0F SndStopAllIfIdle           ; if no channel active, stop (SndUpdateRetrig, SndStartChannels)
6E24 SndAdvanceRetrig           ; SndCheckChanMode (cp $ff)
6EA7 SndChanStateMachine        ; per-channel state-machine dispatch (multiple branches)
6F65 SndGetChainPhrase          ; bounds-checked chain_phrases[chain*16+row] lookup (chain=arg sp+6, row=arg sp+7 <$10; SRAM $A080); DebugTrap on out-of-range
6FB6 SndWaveRetrigDispatch      ; wave-channel retrigger dispatch (-> SndLoadWaveFrame)
7034 SndLoadWaveFrame           ; stream the next synth wave frame ([$c4d0] ptr, SRAM bank 0) to the WAV channel
70FB SndEnableLcdInts           ; SetInterruptEnable
710E SndInitPlayState           ; copy $c401 -> $c4d2, clear $c528, StopPlayback
711F SndAdvanceChanPos          ; per-frame position advance inside SndUpdateChannel; state $ff -> SndInitPlayState
7362 SndBank0Call7362           ; bank0 $33f9 dispatch
73B0 SndClearVoicePairs         ; recursive: SndBank0Call6479 x2 (clear voice state)
748E SndAdvanceGrooveCursor     ; SndReadCursorByte + SndGrooveStep
75C6 SndUpdateChannel           ; per-channel processor (channel = hSoundCh): advance phrase cursor, resolve song/chain row, read note/cmd; called per active channel by SndUpdateAllChannels
77F0 SndTick                    ; one engine tick: SndStepAllChannels (sequencer) then SndUpdateAllChannels (output); self-recurses on retrigger flag $c4cd / mode $cb66
786F SndUpdateChanAltPath       ; per-channel alt update (SndReadChainRow/4E74/5F5E)
792B SndSyncStart               ; decide/perform playback start from wSyncMode + saved screen context ($c8fe)
7B31 SndCheckSyncState          ; sync-state check (cp $01/$ff)
7C4C StopPlayback               ; stop for current screen context: audio off, wPlayMode=0, clear channel state; LIVE -> SndStopAllIfIdle
7CFB SndCmdJumpTable            ; command jump table (jp hl)
7F24 SndSetupLfo                ; dispatch by hSoundCh -> SndSetupLfoPU1/PU2/WavNoi (vibrato/LFO setup)
7F33 SndSetupLfoWavNoi          ; LFO setup for ch2/3 (WAV/NOI): clear $cbcd, init from $c2db
7F3E SndSetupLfoPU2             ; LFO setup for ch1 (PU2): clear $cbc6, init from $c2d9
7F49 SndSetupLfoPU1             ; LFO setup for ch0 (PU1): $cbbf, call bank0 $2f9a
78C4 StopAllPlayback            ; stop playback in screen context AND song context (temporarily forces wCurrentScreen=SONG); LIVE -> SndAdvanceRetrig
5EDA NoiseFreqTable             ; [noise note] -> NR43 poly/divisor byte (120 entries)
5F52 SetNoisePoly               ; a = NoiseFreqTable[a] -> rAUD4POLY (NR43); noise-channel pitch
7FF0 WavFreqTable               ; WAV channel sample-rate steps (SndUpdateWavFreq)
7F51 StepEnvToTarget            ; step channel volume [hl] toward e via zombie mode ($08 nudge up / FadeEnvStepDown); c = rAUDxENV; shared tail of SndSetupLfo*
7F5C .stepDown           ; target below current: fade one step down (FadeEnvStepDown)

