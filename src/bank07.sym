; Bank $07 -- Song screen. The arrangement: song[256][4] = chain# per channel per
; step ($FF=empty), sequence at SRAM bank0 $B290 (song offset $1290); read via
; ReadSequenceByte, written via WriteSongByte(bank0, $B290+...).

; --- Song-screen strings + display tables (db; clipboard/output/channel) ---
6889 TxtOct78                   ; "O7-8"
6E2C ChannelNames       ; channel display names "PU1"/"PU2"/"PU1+2"/...
4373 TxtClonedChain     ; "CLONED CHAIN"
4380 TxtClonedChainPhrases ; "CLONED CHAIN+PHRASES"
56FE TxtCancelSelect07  ; "CANCEL SELECT"
492A TxtDashes          ; "--" (SetSongRowPalettes: cell with bit 7 set)
5957 TxtCutChains       ; "CUT CHAINS"
5962 TxtCopiedChains    ; "COPIED CHAINS"
5B0F TxtPastedChains    ; "PASTED CHAINS"
40D0 WriteSongCell              ; write song[row][col] = chain (SRAM bank 0 $B290); asserts col < 4, row <= $BF, chain < $80 or $FF
7220 CopyVramByteSafe   ; spin until rSTAT mode<2 (VRAM free), then copy [de]->[hl], inc e/l
4574 DrawSongScreen      ; screen idx 4: draws the song sequence (4 channels = PU1/PU2/WAV/NOI)
47AA SongScreenUpdate   ; per-frame visual update (screen idx 4)
4139 CloneSongChain             ; song screen chain clone (CLONED CHAIN / +PHRASES in deep mode): new chain via IsSongChainUsed, copy its 16 phrases (deep: clone each phrase once via the wClonePhraseMap map), transposes; returns the new chain or $ff

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 CopySongColumn             ; copy a song column from p to q (stride 4) until p reaches $B590 (ScanSongSram); asserts both >= $B290, q < $B590
404B SongChannelActiveMask         ; OR wChannelActive[0..3] -> combined active flag
4084 EraseSongCursor            ; restore the cursor cell palette (1 if the row is bookmarked, else 0) at SongColumnOffsets[wSongColumn]
4366 .showCloneMessage    ; show "CLONED CHAIN" / "CLONED CHAIN+PHRASES" popup
4395 DrawSongCursor             ; highlight the cursor cell (palette 3 on CGB, 2 on DMG) at SongColumnOffsets[wSongColumn]
43E4 ReadSongRow                ; read song row wSongScroll from SRAM ($B290, ReadSongBytes) -> wSongReadBuffer (16 bytes)
4463 DrawSongRowNumber             ; draw a song row number + bookmark marker (wSongScroll window, 18 rows)
451E RedrawSongRow              ; ReadSongRow + draw the row at VRAM $9842 (palettes, DrawSongColumnValues/4395)
4540 ScrollSongToCursor         ; clamp song top-row wSongScroll so cursor wSongRow stays visible
4657 UpdateSongPlayMarker       ; per-channel play-position markers from wChannelSongRow/wChannelNextSongRow (<-SongScreenUpdate)
47CF SetSongRowPalettes            ; pick row draw palettes (cursor/bookmark-aware)
492D DrawSongCursorRow          ; draw cursor-row string (SetVramCursor at wSongRow-wSongScroll, SetSongRowPalettes)
494E ScrollSongUp               ; scroll the song grid for the row above: ScrollSongVramUp (+ CopyVramRowUp on CGB), redraw row 2 ($9840)
4973 ScrollSongDown             ; scroll the song grid for the row below: ScrollSongVramDown (+ CopyVramRowDown on CGB), redraw row 17 ($9A20)
4998 FindNextSongRow            ; scan down 1..16 from cursor wSongRow, wrapping at 0 -> $ff
49E7 PageSongCursorDown         ; PgDn: advance song cursor wSongRow by a page (wCursorMode==4 guard)
4A25 FindPreviousSongRow            ; scan up 1..16 from cursor wSongRow, wrapping
4A79 PageSongCursorUp           ; PgUp: retreat song cursor wSongRow by a page
4AB8 BeginSongSelection         ; SaveSelectionState, seed wSel* rect from the song cursor
4AFD LoadSongCursorChain        ; read seq[wSongRow,wSongColumn] ($ff -> empty path), validate+cache via CloneSongChain
5736 CutCopySongSelection       ; cut (isCut arg) or copy the song selection rect into the clipboard; a cut shifts each column up and clears the tail ($FF), AdjustBookmarksOnDelete, CUT/COPIED CHAINS
5929 .endSelection        ; finish selection (ShowMessage), restore cursor from wSelectionLeft/wSongSelectionRow
5970 PasteSongSelection         ; paste the clipboard rows into the song grid at the cursor: shifts the columns down (WriteSongSramBytes) to make room, writes the cells, PASTED CHAINS
5B1D EditSongSelection          ; apply the current edit op across the selection rect (clipType 4; 7 uses in SongScreenInput)
627C SortBookmarks              ; bubble-sort the 16-byte song bookmarks row ($aff0, song offset $0FF0)
6320 IsBookmarked               ; -> e=1 if song row (arg) is in the bookmarks list, else 0
637C AddBookmark                ; append song row to bookmarks; full -> ShowMax16Marks
63B5 RemoveBookmark             ; delete song row from bookmarks list, re-sort
6413 ToggleBookmark             ; song row in list ? RemoveBookmark : AddBookmark
644F AdjustBookmarksOnDelete    ; song rows [lo,hi) removed: drop bookmarks inside, shift later ones up, re-sort
64CA AdjustBookmarksOnInsert    ; song rows shifted (src->dst): rebase bookmarks, drop wrapped, re-sort
6543 DrawKeyboardInstrumentState          ; keyboard state cell (arrows by wKeyboardPulseChannels) + instrument hex (wKeyboardInstrument) at row 12
672A HexDigitCharacter               ; return hex char "0123456789ABCDEF"[arg]
674D DrawKeyboardInstrumentName           ; DrawKeyboardInstrumentState + instrument name via CopyInstrumentName -> wSampleNoteString
6812 DrawKeyboardOctave              ; draw the keyboard octave range ("O3-4".."O7-8") from wKeyboardTranspose
6E50 ProcessKeyboardNote             ; PS/2 keyboard note -> play/preview on the channel (wKeyboardHeldNote; screen/col aware)
7012 LinkDequeueByte            ; wait for a queued link byte and pop it from the wLinkQueueBuffer ring (index wLinkQueueHead, 16 entries)
7033 KeyboardDrainQueue              ; delay(10), drop every queued link byte, then SendSyncHandshake
704E KeyboardPollScancode            ; drain the queue, then expect 20 key records (3, [7,] $27) from the keyboard: 1 if all arrive (the calibration taps)
71BF DrawSongColumnValues       ; draw 16 song-row values into the column (wSongReadBuffer, IsBookmarked)
720A DrawHexOrDashes            ; draw space then [bc]: bit7 ? "--" : hex byte
722B CopyVramRowDown            ; copy tilemap row 2 -> row 3 (VBK-aware, calib screen)
7276 CopyVramRowUp              ; copy tilemap row 17 -> row 16 (VBK-aware, calib screen)
72C1 ScrollSongVramUp           ; shift VRAM rows up ($9a00 -> $9a20, 15 bytes, hblank-safe)
735B ScrollSongVramDown         ; shift VRAM rows down (counterpart of ScrollSongVramUp)
73F5 ScanSongSram               ; copy [hl] -> [de] in SRAM bank 0 (di-guarded), both += 4, until hl reaches $B590
7422 WriteSongSramBytes         ; write N bytes (count arg) to SRAM (di, bank-select, $0a enable)
; --- functions called from bank 0 (this bank paged in) ---
68A2 ProcessLinkQueue           ; drain the link-port ring buffer (wLinkQueueBuffer+, head wLinkQueueHead): keyboard scancodes / sync bytes
4B3B SongScreenInput            ; song screen (4) input (wButtons): chain entry, cursor moves, chain number steps, clear/delete, live mode, selections, bookmarks, playback; 1 = handled

; --- bookmarks / tempo / PS/2 keyboard ---
6249 WriteBookmarkByte          ; bounds-checked ($aff0-$afff) WriteSongByte into the bookmarks row
643D ClearBookmarks             ; FillMemory($aff0, $ff, 16)
5DD8 SetSyncSendRate            ; wSyncSendRate (interrupts off) from the tempo: $800 x (4 - wTempoMode) for the sync speeds, else TempoTimerTableDmg/Cgb[wTempo - 40]
5E49 TempoTimerTableDmg         ; [BPM byte] -> 16-bit tempo timer value (DMG), 256 x dw
6049 TempoTimerTableCgb         ; [BPM byte] -> 16-bit tempo timer value (CGB double-speed), 256 x dw
662A KeyboardNoteMap            ; [PS/2 scancode & $7f] -> note (0=none), + wKeyboardTranspose octave offset
66AA KeyboardFunctionMap              ; [PS/2 scancode & $7f] -> function code (channel mutes/cursor keys)
7097 DrawCalibrationScreen    ; PS/2 "KEYBOARD CALIBRATION" screen (tap down-arrow prompt)
7171 TxtKeyboardCalibration     ; "KEYBOARD CALIBRATION"
7186 TxtTapDownArrowKey         ; "TAP DOWN ARROW KEY"
7199 TxtOnPs2Keyboard           ; "ON PS/2 KEYBOARD"
71AA TxtManyTimes               ; "MANY TIMES"
71B5 TxtFail                    ; "FAIL!"
71BB TxtOk                      ; "OK!"
688E TxtOct67                   ; "O6-7"
6893 TxtOct56                   ; "O5-6"
6898 TxtOct45                   ; "O4-5"
689D TxtOct34                   ; "O3-4"
4047 SongColumnOffsets             ; per-song-column x offsets (col+1)*3: $03,$06,$09,$0c
5DB8 SongSelectionAttribute               ; [32] CGB attribute 3 (selection palette) for set_bkg_tiles in EditSongSelection
403F SongColumnFlags               ; 8-byte per-column flag row (precedes SongColumnOffsets)

