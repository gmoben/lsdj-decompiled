; Bank $06 -- Chain / Wave / Word screens
; Chain editor: chains[wChain] = phrase# + transpose per step (16); chain_phrases
; at SRAM bank1 $A080, chain_transposes at $A880.
5677 .shift               ; chain * 16 (was GetChainTranspose)

; --- UI strings + note-name table (db "..."; referenced by draw/clipboard code) ---
76E4 NoteNames          ; chromatic note-name display table "---C 2C#2..." (C-2..B, all octaves)
42FB TxtWord            ; "WORD " (word/speech screen)
4301 TxtNoSample        ; "--- " (word screen: empty sample slot)
5383 TxtCancelSelect    ; "CANCEL SELECT"
5467 TxtCopy            ; "COPY"
54F4 TxtPaste           ; "PASTE"
5899 TxtClonedPhrase    ; "CLONED PHRASE"
6D40 TxtCancelSelect2   ; "CANCEL SELECT" (second instance)
6F03 TxtCut             ; "CUT "
7000 TxtPaste2          ; "PASTE" (second instance)
7455 TxtWait            ; "WAIT" (sync status)
749E TxtSync            ; "SYNC" (sync status)
7510 TxtSync2           ; "SYNC" (second instance)
5908 .shift               ; wChain * 16 (was SetChainPhrase)
58FB LoadChainRow        ; load chain_phrases/chain_transposes[wChain] -> wSongReadBuf / wUsedTableMap (16 each)
5626 DrawChainPos               ; draw "CP" and the chain cursor row (DrawByte) at $9851 in the shadow palette
569C .write               ; (was ReadChainTranspose)
5947 DrawChainScreen     ; screen idx 3: draws chain phrases + transposes
4A0A WriteWaveSample            ; write sample pos+1 (inverted nibble) of the edited wave frame (SRAM bank 3 )
4F18 DrawWaveScreen      ; screen idx 8: draws the waveform; edits wave_frames (bank3 $A000) directly
405D ReadWordCell               ; read the speech word cell under the cursor: SRAM bank 0 $B890 + word*32 + col + row*2
41A2 DrawWordScreen      ; screen idx 12: draws speech words; edits words ($B890) + word_names ($BDD0)
5A62 ChainScreenUpdate  ; per-frame visual update (screen idx 3)
5511 ChainLoadCursorPhrase      ; read the phrase at (wChain, wChainRow) via FarCallArg2; $ff -> empty path

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 ChainScaleValue            ; (v / 15) + $19, then +5 past $1A (DivU8)
4026 DrawSampleNameCell         ; draw a kit sample-name cell (ChainScaleValue + ReadKitSampleName -> wSampleNoteString)
40B3 WriteWordCell              ; write to the speech-word data under the word cursor (wWordEditRow/Col, $b890 region)
410E ChainDrawWaveCell          ; draw cell at cursor $c937/$c938 via ROM tables $4022/$4024
414F ChainDrawWaveCellHw        ; like ChainDrawWaveCell but palette per hGameboyType
4306 DrawWaveCellPair           ; draw a wave cell in both variants (ChainDrawWaveCell + Hw) for the row
48AB TilemapAddr                ; the BG tilemap address of cell x,y: $9800 | (y*32 + x)
4901 ChainCalcParamAddr         ; pick SRAM base $bfc4/$bfc5 by bit3 of arg (= SynthCalcParamAddr)
493F CopySynthParam             ; copy one synth parameter byte (ChainCalcParamAddr src->dst)
4992 ReadWaveSample             ; sample (i+1)&31 of the edited synth wave frame (SRAM bank 3 $A000 + wSynth*16), inverted: $0F ^ nibble
4AB0 WaveSetSpriteColumns       ; set the x of wave sprites 3..10 and 11..18
4B16 ChainSetCursorSprite       ; compute cursor sprite X/Y from $c42b/$c93b ($c413==4)
4B40 ChainWriteCursorPair       ; store $c42b through two arg pointers
4BA7 WaveInitSprites            ; init the 16 wave-sample sprites (3..18): y, tile 5, attr ; x via WaveSetSpriteColumns
4C55 DrawWaveColumn             ; wave graph column col: samples 2col/2col+1 as dots (one tile or a half-tile pair, CGB/DMG tiles), wWaveColEmpty rows blank, their hex values below
4EAC ChainDrawCursorByte        ; draw $c42b>>1 via DrawWaveColumn
4EBD ChainWriteWaveA            ; write wave data via ChainWriteCursorPair
4F02 ChainDrawRow16             ; draw 16 bytes via DrawWaveColumn
4F42 ChainWriteWaveB            ; write wave data via ChainWriteCursorPair (variant)
4FA9 ChainWriteWaveC            ; write wave data via ChainWriteCursorPair (variant)
4FFB ChainWriteWaveD            ; write wave data via ChainWriteCursorPair (variant)
504E DrawWaveCursor             ; draw the wave-screen cursor nibbles (WriteWaveSample + ChainDrawCursorByte x2)
5398 CopyWaveSelection          ; wave-screen COPY: selection -> clipboard (clipType 8), shows "COPY"
546C PasteWaveSelection         ; wave screen: paste the clipboard samples at the cursor
54FA GetCursorChain             ; read the chain number under the song cursor (ReadSeqByte(wSongCol, wSongRow))
5563 ChainScreenEnter           ; enter the chain screen for the cursor chain (LIVE-mode aware, clears message)
5655 SetChainTranspose          ; write chain_transposes[chain<$80][step<$10] = v (SRAM bank 1 $A880)
56AA ChainReadTrans        ; read chain_transposes[chain<$80] from SRAM (bounds-checked)
56F0 ClonePhraseAtCursor        ; chain screen deep-clone: new phrase + copy rows, "CLONED PHRASE"
5804 .copyNotes           ; (was CopyPhraseNotes) copy 16 phrase-note bytes src->dst phrase (clone helper)
5836 .copyFx              ; (was CopyPhraseFx) copy 16 phrase-fx bytes src->dst phrase
5868 .copyInstrs          ; (was CopyPhraseInstrs) copy 16 phrase-instrument bytes src->dst phrase
58A7 ChainDrawCellLo            ; draw cell at cursor $c419/$c41a
5ABE ChainDrawCellHw            ; draw cell at $c41a (palette per hGameboyType)
5B00 ChainOpenPhrase            ; open the phrase under the chain cursor (RestoreSelectionState, load phrase)
6D55 CutCopyChainSelection      ; arg!=0 -> "CUT " (copy+clear) else "COPY": chain selection -> clipboard (clipType 3; phrases via SndGetChainPhrase, transposes)
6F0D ChainPasteCells            ; SELECT+A paste on the chain screen: clipboard cells into rows wSelTop..wSelBottom (column 0 phrases via WriteChainPhrase, column 1 transposes), "PASTE" message when more than one row
7006 DrawChainSelection         ; chain selection (wClipboardType==3) redraw vs the cursor: cells around the rectangle in their column palettes, the inside highlighted (ColorField)
71ED DrawKitSampleNames         ; draw the playing kit sample names (wKit1Bank/wKit2Bank) at the tilemap position
73C0 DrawStringAtCursor         ; set wVramCursor + DrawString (9-use draw helper)
73DC ChainSyncStatusFlag        ; read $cb69, return status flag
740C ChainDrawSyncStatus        ; draw sync status string from $cb6c/$cb6b (DrawStringAtCursor)
7469 ChainDrawLeadStatus        ; draw LEAD/sync status via ChainSyncStatusFlag (DrawStringAtCursor)
7508 .drawStatus          ; (was ChainDrawStatusWord) draw a status word (SYNC/LEAD) via DrawStringAtCursor
7524 DrawTileHexCell            ; (v): t = ((v-60)+1)>>2 - 9; prefix = HexCellPrefixPtrs[v&3]; t<0 -> prefix[0], '-', DrawByte(-t); else DrawString(prefix), DrawByte(t). Matched in C: c/bank06/DrawTileHexCell.c
75A6 HexCellPrefixPtrs          ; [4] dw -> the 2-char prefix strings below, indexed by (v & 3) in DrawTileHexCell (also parked in wChainScratchPtr)
75AE TxtHexCellPrefix0          ; "D "
75B1 TxtHexCellPrefix1          ; "F "
75B4 TxtHexCellPrefix2          ; "G#"
75B7 TxtHexCellPrefix3          ; "C "
75BA DrawChainCell              ; draw one chain-row cell: "---" empty or phrase hex (+bookmark tile via $ff88)
784C ChainShiftSamples          ; sla each of N bytes from de (scope/visualization helper)
786F ChainDrawScopePoint        ; plot oscilloscope point (ChainShiftSamples + $cba. buffer)
78B8 ChainUpdateScope           ; update scope from $cba2/$cba3/$cba4
; --- functions called from bank 0 (this bank paged in) ---
74AD DrawSyncStatus             ; draw the sync/lead status by wSyncMode (1/3/6/7 cases)
72C4 UpdateStatusPanel          ; per-frame status update for most screens: pending sample-name cells (wChanDispNote) at x=17, the tempo field when wTempo changed, the scope
5BD0 ChainScreenInput           ; the chain screen's input: A writes a phrase/transpose, the directions move, A+directions step phrases (1/16) or transposes (1/octave) over the cell or selection, B+directions change channel or song row, A+B cuts, select+A pastes, start plays, select+B selects
507F WaveScreenInput            ; wave-screen input dispatch (wButtons)
431D WordEditorInput            ; word screen (12) input handler, from DispatchScreenInput: cursor over wWordEditRow/Col, dispatch on wButtons
5391 TxtSelect         ; "SELECT" (pairs with TxtCancelSelect)
6D4E TxtSelect2        ; "SELECT" (second instance; pairs with TxtCancelSelect2)
4024 WordColWidth               ; widths of the word editor columns ($03, $02)
550F ChainColX                  ; x of the chain screen columns ($02, $05)
5A5E TxtDashes2                 ; " --" (blank transpose display)
745A TxtLead                    ; "LEAD"
745F TxtSync3                   ; "SYNC" (third instance)
7464 TxtBlank4a                 ; "    "
74A3 TxtWait2                   ; "WAIT" (second instance)
74A8 TxtBlank4b                 ; "    "
7515 TxtBlank4c                 ; "    "
751A TxtLead2                   ; "LEAD" (second instance)
751F TxtBlank4d                 ; "    "
4022 WordColX                   ; x of the word editor columns ($02, $06)

