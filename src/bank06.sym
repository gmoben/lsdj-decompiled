; Bank $06 -- Chain / Wave / Word screens
; Chain editor: chains[wChain] = phrase# + transpose per step (16); chain_phrases
; at SRAM bank1 $A080, chain_transposes at $A880.
5677 GetChainTranspose  ; read chain_transposes[chain][step] (song $2880 / SRAM bank1 $A880)

; --- UI strings + note-name table (db "..."; referenced by draw/clipboard code) ---
76E4 NoteNames          ; chromatic note-name display table "---C 2C#2..." (C-2..B, all octaves)
42FB TxtWord            ; "WORD " (word/speech screen)
5383 TxtCancelSelect    ; "CANCEL SELECT"
5467 TxtCopy            ; "COPY"
54F4 TxtPaste           ; "PASTE"
5899 TxtClonedPhrase    ; "CLONED PHRASE"
6D40 TxtCancelSelect2   ; "CANCEL SELECT" (second instance)
6F03 TxtCut             ; "CUT "
7000 TxtPaste2          ; "PASTE" (second instance)
7455 TxtWait            ; "WAIT" (sync status)
749E TxtSync            ; "SYNC" (sync status)
7510 TxtSync2           ; "SYNC" (second instance)
5908 SetChainPhrase     ; write chain_phrases[chain][step] (song $2080 / SRAM bank1 $A080)
58FB LoadChainRow        ; load chain_phrases+chain_transposes[wChain][16] -> buffers $C46D/$C47D
5626 WriteChainTranspose ; write chain_transposes[wChain][step]
569C ReadChainTranspose  ; read chain_transposes[wChain][step]
5947 DrawChainScreen     ; screen idx 3: draws chain phrases + transposes
4A0A AccessWaveFrame     ; compute/access a wave_frames cell (SRAM bank3 $A000; 32 nibbles/frame)
4F18 DrawWaveScreen      ; screen idx 8: draws the waveform; edits wave_frames (bank3 $A000) directly
405D AccessWord          ; words[word][32] cell at SRAM bank0 $B890 (42 words; allophone+length pairs)
41A2 DrawWordScreen      ; screen idx 12: draws speech words; edits words ($B890) + word_names ($BDD0)
5A62 ChainScreenUpdate  ; per-frame visual update (screen idx 3)
5511 ChainLoadCursorPhrase      ; read the phrase at (wChain, wChainRow) via FarCallArg2; $ff -> empty path

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 ChainScaleValue            ; scale/clamp a display value (mask $0f, $374c) with +$19/+$05 offset
4026 DrawSampleNameCell         ; draw a kit sample-name cell (ChainScaleValue + ReadKitSampleName -> wSampleNoteString)
40B3 WriteWordCell              ; write to the speech-word data under the word cursor (wWordEditRow/Col, $b890 region)
410E ChainDrawWaveCell          ; draw cell at cursor $c937/$c938 via ROM tables $4022/$4024
414F ChainDrawWaveCellHw        ; like ChainDrawWaveCell but palette per hGameboyType
4279 DrawSampleNameFull         ; sample name + extras draw (unreferenced variant of DrawSampleNameCell)
4306 DrawWaveCellPair           ; draw a wave cell in both variants (ChainDrawWaveCell + Hw) for the row
48AB ChainCalcSampleAddr        ; compute a sample address (arg<<5 + base) for LoadKitSampleInfo
4901 ChainCalcParamAddr         ; pick SRAM base $bfc4/$bfc5 by bit3 of arg (= SynthCalcParamAddr)
493F CopySynthParam             ; copy one synth parameter byte (ChainCalcParamAddr src->dst)
4992 ChainReadPhraseNote   ; read phrase_notes[arg<$20] from SRAM (chain screen)
4AB0 ChainScanCmd               ; scan 4 entries for command $0b with nonzero operand
4B16 ChainSetCursorSprite       ; compute cursor sprite X/Y from $c42b/$c93b ($c413==4)
4B40 ChainWriteCursorPair       ; store $c42b through two arg pointers
4BA7 ChainDrawWaveform          ; draw wave samples from $400c.. (<-DrawWaveScreen)
4C55 LoadKitSampleInfo          ; resolve the kit sample pair for the cursor note (ChainCalcSampleAddr; clears $c93d..+8)
4EAC ChainDrawCursorByte        ; draw $c42b>>1 via LoadKitSampleInfo
4EBD ChainWriteWaveA            ; write wave data via ChainWriteCursorPair
4F02 ChainDrawRow16             ; draw 16 bytes via LoadKitSampleInfo
4F42 ChainWriteWaveB            ; write wave data via ChainWriteCursorPair (variant)
4FA9 ChainWriteWaveC            ; write wave data via ChainWriteCursorPair (variant)
4FFB ChainWriteWaveD            ; write wave data via ChainWriteCursorPair (variant)
504E DrawWaveCursor             ; draw the wave-screen cursor nibbles (AccessWaveFrame + ChainDrawCursorByte x2)
5398 CopyWaveSelection          ; wave-screen COPY: selection -> clipboard (clipType 8), shows "COPY"
546C ChainReadCursorInput       ; read input ($07da) -> cursor $c93b
54FA GetCursorChain             ; read the chain number under the song cursor (ReadSeqByte(wSongRow,wSongCol))
5563 ChainScreenEnter           ; enter the chain screen for the cursor chain (LIVE-mode aware, clears message)
5655 ChainReadChainCell         ; bounds-checked chain[arg<$80][row<$10] read
56AA ChainReadTrans        ; read chain_transposes[chain<$80] from SRAM (bounds-checked)
56F0 ClonePhraseAtCursor        ; chain screen deep-clone: new phrase + copy rows, "CLONED PHRASE"
5804 CopyPhraseNotes            ; copy 16 phrase-note bytes src->dst phrase (clone helper)
5836 CopyPhraseFx               ; copy 16 phrase-fx bytes src->dst phrase
5868 CopyPhraseInstrs           ; copy 16 phrase-instrument bytes src->dst phrase
58A7 ChainDrawCellLo            ; draw cell at cursor $c419/$c41a
5ABE ChainDrawCellHw            ; draw cell at $c41a (palette per hGameboyType)
5B00 ChainOpenPhrase            ; open the phrase under the chain cursor (RestoreSelectionState, load phrase)
6D55 PasteChainSelection        ; write clipboard cells into the chain grid (clipType 3)
6F0D ChainNormalizeSelection    ; normalize the chain-screen selection rect (wSel*)
7006 ChainHandleInput           ; main chain-screen input handler ($c411==3, $c419/$c40d); large
71ED DrawOscSampleNames         ; draw the playing kit sample names (wOscBankA/B) at the tilemap position
73C0 DrawStringAtCursor         ; set wVramCursor + DrawString (9-use draw helper)
73DC ChainSyncStatusFlag        ; read $cb69, return status flag
740C ChainDrawSyncStatus        ; draw sync status string from $cb6c/$cb6b (DrawStringAtCursor)
7469 ChainDrawLeadStatus        ; draw LEAD/sync status via ChainSyncStatusFlag (DrawStringAtCursor)
7508 ChainDrawStatusWord        ; draw a status word (SYNC/LEAD) via DrawStringAtCursor
7524 DrawTileHexCell            ; draw two indexed tiles + a hex byte
75BA DrawChainCell              ; draw one chain-row cell: "---" empty or phrase hex (+bookmark tile via $ff88)
784C ChainShiftSamples          ; sla each of N bytes from de (scope/visualization helper)
786F ChainDrawScopePoint        ; plot oscilloscope point (ChainShiftSamples + $cba. buffer)
78B8 ChainUpdateScope           ; update scope from $cba2/$cba3/$cba4
; --- functions called from bank 0 (this bank paged in) ---
74AD DrawSyncStatus             ; draw the sync/lead status by wSyncMode (1/3/6/7 cases)
72C4 DrawShadowDigit            ; draw a digit cell with the shadow palettes
5BD0 ChainScreenEdit            ; chain-screen edit dispatcher (wButtons; wChain asserted)
507F WaveScreenInput            ; wave-screen input dispatch (wButtons)
431D DrawSelectDigit    ; draw select-palette digit (wSelectDigitPal)
5391 TxtSelect         ; "SELECT" (pairs with TxtCancelSelect)
6D4E TxtSelect2        ; "SELECT" (second instance; pairs with TxtCancelSelect2)
