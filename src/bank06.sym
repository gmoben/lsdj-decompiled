; Bank $06 -- Chain / Wave / Word screens
; Chain editor: chains[wChain] = phrase# + transpose per step (16); chain_phrases
; at SRAM bank1 $A080, chain_transposes at $A880.
5677 .shift               ; chain * 16

; --- UI strings + note-name table (db "..."; referenced by draw/clipboard code) ---
76E4 NoteNames          ; chromatic note-name display table "---C 2C#2..." (C-2..B, all octaves)
42FB TxtWord            ; "WORD " (word/speech screen)
4301 TxtNoSample        ; "--- " (word screen: empty sample slot)
5383 TxtCancelSelect    ; "CANCEL SELECT"
5467 TxtCopy            ; "COPY"
54F4 TxtPaste           ; "PASTE"
5899 TxtClonedPhrase    ; "CLONED PHRASE"
6D40 TxtCancelSelect2   ; "CANCEL SELECT" (second instance)
6F03 TxtCut             ; "CUT "
7000 TxtPaste2          ; "PASTE" (second instance)
7455 TxtWait            ; "WAIT" (sync status)
749E TxtSync            ; "SYNC" (sync status)
7510 TxtSync2           ; "SYNC" (second instance)
5908 .shift               ; wChain * 16
58FB LoadChainRow        ; load chain_phrases/chain_transposes[wChain] -> wSongReadBuffer / wUsedTableMap (16 each)
5626 DrawChainPosition               ; draw "CP" and the chain cursor row (DrawByte) at $9851 in the shadow palette
569C .write               ;
5947 DrawChainScreen     ; screen idx 3: draws chain phrases + transposes
4A0A WriteWaveSample            ; write sample pos+1 (inverted nibble) of the edited wave frame (SRAM bank 3 )
4F18 DrawWaveScreen      ; screen idx 8: draws the waveform; edits wave_frames (bank3 $A000) directly
405D ReadWordCell               ; read the speech word cell under the cursor: SRAM bank 0 $B890 + word*32 + col + row*2
41A2 DrawWordScreen      ; screen idx 12: draws speech words; edits words ($B890) + word_names ($BDD0)
5A62 ChainScreenUpdate  ; per-frame visual update (screen idx 3)
5511 LoadChainCursorPhrase      ; read the phrase at (wChain, wChainRow) via FarCallArgument2; $ff -> empty path

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 AllophoneKit               ; the speech kit holding allophone v: v / 15 + $19, then + 5 past $1A (its sample is v % 15 + 1)
4026 DrawAllophoneName          ; draw allophone v's name: ReadKitSampleName(AllophoneKit(v), v % 15 + 1)
40B3 WriteWordCell              ; write to the speech-word data under the word cursor (wWordRow/Col, $b890 region)
410E EraseWordCursor            ; restore the word screen's cursor cell to its column palette
414F DrawWordCursor             ; highlight the word screen's cursor cell (WordColumnX/WordColumnWidth[wWordColumn], row wWordRow)
4306 MoveWordCursorDown             ; word screen: move the cursor one row down (EraseWordCursor, wWordRow++, DrawWordCursor) unless on row 15
48AB TilemapAddress                ; the BG tilemap address of cell x,y: $9800 | (y*32 + x)
4901 SynthLockByteAddress          ; the SRAM byte holding synth x's lock bit ("synths locked?" $BFC4-$BFC5): $BFC5 for 0-7, $BFC4 for 8-F
493F LockCurrentSynth           ; set the current synth's (wSynth >> 4) bit in its lock byte; WriteWaveSample calls it before editing a wave
4992 ReadWaveSample             ; sample (i+1)&31 of the edited synth wave frame (SRAM bank 3 $A000 + wSynth*16), inverted: $0F ^ nibble
4AB0 SetWaveSpriteColumns       ; set the x of wave sprites 3..10 and 11..18
4B16 SetWaveCursorSprite        ; place the wave cursor and selection-anchor sprites from wWaveCursor/wWaveSelectionStart (SetWaveSpriteColumns)
4B40 GetWaveEditRange           ; the wave screen's edit range into *start/*end (end exclusive): the cursor sample, or the selection from wWaveSelectionStart (wCursorMode 4)
4BA7 InitializeWaveSprites            ; init the 16 wave-sample sprites (3..18): y, tile 5, attr ; x via SetWaveSpriteColumns
4C55 DrawWaveColumn             ; wave graph column col: samples 2col/2col+1 as dots (one tile or a half-tile pair, CGB/DMG tiles), wWaveColumnEmpty rows blank, their hex values below
4EAC DrawWaveCursorColumn       ; redraw the wave column under the cursor (DrawWaveColumn(wWaveCursor >> 1))
4EBD DrawWaveRange              ; redraw the wave columns of the edit range
4F02 DrawWaveColumns            ; draw all 16 wave columns
4F42 ReverseWaveRange           ; A+LEFT/RIGHT on a wave selection: reverse its samples, then redraw
4FA9 FlipWaveRange              ; A+UP/DOWN (help: FLIP SAMPLE): each sample in the edit range becomes F - v, then redraw
4FFB ChangeWaveRange            ; UP/DOWN (help: CHANGE SAMPLE): add d (1 or -1) to each sample in the edit range, then redraw
504E DrawWaveLine               ; A+LEFT/RIGHT (help: DRAW LINE): copy the cursor's sample into the next column (d = +-1) and move there
5398 CopyWaveSelection          ; wave-screen COPY: selection -> clipboard (clipType 8), shows "COPY"
546C PasteWaveSelection         ; wave screen: paste the clipboard samples at the cursor
54FA GetCursorChain             ; read the chain number under the song cursor (ReadSequenceByte(wSongColumn, wSongRow))
5563 ChainScreenEnter           ; enter the chain screen for the cursor chain (LIVE-mode aware, clears message)
5655 SetChainTranspose          ; write chain_transposes[chain<$80][step<$10] = v (SRAM bank 1 $A880)
56AA ReadChainTranspose        ; read chain_transposes[chain<$80] from SRAM (bounds-checked)
56F0 ClonePhraseAtCursor        ; chain screen deep-clone: new phrase + copy rows, "CLONED PHRASE"
5804 .copyNotes           ; copy 16 phrase-note bytes src->dst phrase (clone helper)
5836 .copyCommand              ; copy 16 phrase-fx bytes src->dst phrase
5868 .copyInstruments          ; copy 16 phrase-instrument bytes src->dst phrase
58A7 EraseChainCursor           ; restore the chain cursor cell's palette (the transpose column 1 on CGB, else 0)
5ABE DrawChainCursor            ; highlight the chain cursor cell (palette 3 on CGB, 2 on DMG) at ChainColumnX[wChainColumn], row wChainRow
5B00 OpenChainPhrase            ; open the phrase under the chain cursor (RestoreSelectionState, load phrase)
6D55 CutCopyChainSelection      ; arg!=0 -> "CUT " (copy+clear) else "COPY": chain selection -> clipboard (clipType 3; phrases via SoundGetChainPhrase, transposes)
6F0D PasteChainCells            ; SELECT+A paste on the chain screen: clipboard cells into rows wSelectionTop..wSelBottom (column 0 phrases via WriteChainPhrase, column 1 transposes), "PASTE" message when more than one row
7006 DrawChainSelection         ; chain selection (wClipboardType==3) redraw vs the cursor: cells around the rectangle in their column palettes, the inside highlighted (ColorField)
71ED DrawStatusNote             ; draw channel ch's playing note in the status panel at (17, ch + 6): a kit's sample name on the wave channel, wNoiNote on the noise channel, else DrawNoteName (PU2 shifted by wNoteTranspose)
73C0 DrawSyncStatusText         ; draw string s in the status panel's sync slot ($99B0, palette 4/1)
73DC SyncStatusFlag        ; read wSyncTick, return status flag
740C DrawSyncStatusLsdj         ; sync mode LSDJ: WAIT while handshaking, LEAD while running, else SYNC or blank (SyncStatusFlag)
7469 DrawSyncStatusMidi         ; sync mode MIDI: SYNC (SyncStatusFlag), WAIT while playing, else blank
7508 .drawStatus          ; draw a status word (SYNC/LEAD) via DrawSyncStatusText
7524 DrawTileHexCell            ; (v): t = ((v-60)+1)>>2 - 9; prefix = HexCellPrefixPointers[v&3]; t<0 -> prefix[0], '-', DrawByte(-t); else DrawString(prefix), DrawByte(t). Matched in C: c/bank06/DrawTileHexCell.c
75A6 HexCellPrefixPointers          ; [4] dw -> the 2-char prefix strings below, indexed by (v & 3) in DrawTileHexCell (also parked in wChainScratchPointer)
75AE TxtHexCellPrefix0          ; "D "
75B1 TxtHexCellPrefix1          ; "F "
75B4 TxtHexCellPrefix2          ; "G#"
75B7 TxtHexCellPrefix3          ; "C "
75BA DrawNoteName               ; draw note v for channel col: '---' for 0; the noise channel's values (hex below $3C, the kit notes C 5..C 8); else a NoteNames entry (the wave channel an octave down); '???' past the table
784C ShiftScopeSamples          ; sla each of N bytes from de (scope/visualization helper)
786F DrawScopePoint        ; plot oscilloscope point (ShiftScopeSamples + $cba. buffer)
78B8 UpdateScope           ; update scope from wScopeDirty/wScopeRefresh/wScopeBitmap
; --- functions called from bank 0 (this bank paged in) ---
74AD DrawSyncStatus             ; draw the sync/lead status by wSyncMode (1/3/6/7 cases)
72C4 UpdateStatusPanel          ; per-frame status update for most screens: pending sample-name cells (wChannelDisplayNote) at x=17, the tempo field when wTempo changed, the scope
5BD0 ChainScreenInput           ; the chain screen's input: A writes a phrase/transpose, the directions move, A+directions step phrases (1/16) or transposes (1/octave) over the cell or selection, B+directions change channel or song row, A+B cuts, select+A pastes, start plays, select+B selects
507F WaveScreenInput            ; wave-screen input dispatch (wButtons)
431D WordScreenInput            ; word screen (12) input handler, from DispatchScreenInput: cursor over wWordRow/Col, dispatch on wButtons
5391 TxtSelect         ; "SELECT" (pairs with TxtCancelSelect)
6D4E TxtSelect2        ; "SELECT" (second instance; pairs with TxtCancelSelect2)
4024 WordColumnWidth               ; widths of the word editor columns ($03, $02)
550F ChainColumnX                  ; x of the chain screen columns ($02, $05)
5A5E TxtDashes2                 ; " --" (blank transpose display)
745A TxtLead                    ; "LEAD"
745F TxtSync3                   ; "SYNC" (third instance)
7464 TxtBlank4a                 ; "    "
74A3 TxtWait2                   ; "WAIT" (second instance)
74A8 TxtBlank4b                 ; "    "
7515 TxtBlank4c                 ; "    "
751A TxtLead2                   ; "LEAD" (second instance)
751F TxtBlank4d                 ; "    "
4022 WordColumnX                   ; x of the word editor columns ($02, $06)

