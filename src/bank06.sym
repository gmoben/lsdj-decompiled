; Bank $06 -- Chain / Wave / Word screens
; Chain editor: chains[wChain] = phrase# + transpose per step (16); chain_phrases
; at SRAM bank1 $A080, chain_transposes at $A880.
5677 GetChainTranspose  ; read chain_transposes[chain][step] (song $2880 / SRAM bank1 $A880)
5908 SetChainPhrase     ; write chain_phrases[chain][step] (song $2080 / SRAM bank1 $A080)
58FB LoadChainRow        ; load chain_phrases+chain_transposes[wChain][16] -> buffers $C46D/$C47D
5626 WriteChainTranspose ; write chain_transposes[wChain][step]
569C ReadChainTranspose  ; read chain_transposes[wChain][step]
5947 DrawChainScreen     ; screen idx 3: draws chain phrases + transposes
4A0A AccessWaveFrame     ; compute/access a wave_frames cell (SRAM bank3 $A000; 32 nibbles/frame)
4F18 DrawWaveScreen      ; screen idx 8: draws the waveform; edits wave_frames (bank3 $A000) directly
405D AccessWord          ; words[word][32] cell at SRAM bank0 $B890 (42 words; allophone+length pairs)
41A2 DrawWordScreen      ; screen idx 12: draws speech words; edits words ($B890) + word_names ($BDD0)
5A62 ChainScreenUpdate  ; per-frame visual update (screen idx 3)
