; Bank $03 -- Instrument screen (see docs/editors.md)
4000 WriteCurInstrByte ; write value to field[arg] of the current instrument (wInstr) via WriteInstrByte

; --- Instrument-screen data tables + strings ---
4DCB WaveSourceNames  ; "WAVE"/"SYNTH" (wave-instrument source)
66F5 .decKitFields
7A7B InstrOptionNames ; instrument param value strings "ON"/"ATK"/"OFF"/"SAFE"/...
433B TxtOutOfSynths             ; "OUT OF SYNTHS! CLEAN INSTR DATA IN PROJECT SCREEN"
459A TxtClonedSynth   ; "CLONED SYNTH"
4AB4 TxtHard                    ; " HARD"
4DE7 DrawInstrScreen ; screen idx 6: draws instrument params (reads instruments[] 119x)
4FC4 InstrTypeNames     ; [4][6] type names "PULSE"/" WAVE"/"  KIT"/"NOISE" (indexed by type*6)
4105 WavePlayIsManual           ; 1 if the wave PLAY mode is MANUAL (SPEED/LENGTH/LOOP POS then show dashes)
4118 IsInstrTableOn             ; instrument byte 6 bit 5 (table on) as 0/1
4133 InstrTableOn               ; set instrument byte 6 bit 5 (table on)
4170 DrawInstrCursor            ; draw the cursor highlight on field wInstrField (ColorField from InstrFieldX/Y/W[type][field], palette 3 CGB / 2)
4257 SetInstrPitchByte          ; write instrument byte 5 (pitch flags) and redraw its transpose ON/OFF (bank 1 DrawOnOffName)
4293 InstrTransposeOff          ; clear instrument byte 5 bit 5 (transpose) via SetInstrPitchByte
4679 EraseInstrCursor           ; erase the cursor highlight on field wInstrField (palette 1)
4741 InstrCmdRateInc            ; A+RIGHT on CMD/RATE: byte 8 one up (to F), redrawn
4769 InstrCmdRateDec            ; A+LEFT on CMD/RATE: byte 8 one down (to 0), redrawn
4924 InstrTableAdd16            ; table on, fresh press: set table-number bit 4 (+16)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
40F8 GetWavePlayMode            ; the wave PLAY mode: byte 9 (MANUAL, ONCE, LOOP, PINGPONG, RESYNC = PlayModeNames)
414F InstrCheckFieldOption      ; return 1 if option-table[c] (ROM $40F4) minus 1 == current field $c427, else 0
427B InstrTransposeOn           ; set instrument byte 5 bit 5 (transpose) via SetInstrPitchByte
42AB SynthWavesModified         ; 1 if synth n's 256-byte wave page (SRAM bank 3) differs from DefaultWaveFrameB3 repeated
42FF FindFreeSynth              ; first synth (0-15) whose waves are still default; else 'OUT OF SYNTHS!' message and $FF
436D InstrTableNew              ; give the instrument the first free table (FarCallByte bank $1F FindFreeTable), switched on; SDCC bug clears byte 6's other bits
43C0 InstrSynthNew              ; A twice on a wave instrument's SYNTH field (PLAY not MANUAL): give it a free synth (FindFreeSynth), drawn and stored in byte 3 bits 7-4
441A CloneSynth                 ; clone the current instrument's synth into a free synth slot (params + 256 wave bytes), then point the instrument at it
45A7 InstrScreenFrame           ; shared instrument-screen frame draw (map row, tempo field, marker sprites)
45D3 InstrSelectPrevUsed        ; step wInstr back to the previous allocated instrument (SramInstrAlloc), then redraw
461B InstrSelectPrevPage        ; wInstr -= 16 (clamped to 0), then InstrSelectPrevUsed
4638 InstrSelectNextUsed        ; step wInstr on to the next allocated instrument (stops at $40, speech), then redraw
47A2 InstrTableModePrev         ; table mode down: clear byte 5 bit 3 (table step) if set, else table off; redraw
482E InstrTableModeNext         ; table mode up: table on, then set byte 5 bit 3 (table step); redraw
489D InstrTableNext             ; table on: table number +1 (up to $1F), then FarCall bank $1F DrawInstrTableField
48D6 InstrTablePrev             ; A+LEFT on the TABLE field: the previous table number; at 0 (a fresh press) the mode steps back twice and the cursor leaves the field
495C InstrTableSub16            ; table on: clear table-number bit 4 (-16)
498B DrawWaveLen             ; draw the wave LENGTH at $99CC ("-" when PLAY is MANUAL)
49B7 DrawWaveSpeed              ; draw the wave SPEED at $99AB ("--" when PLAY is MANUAL)
49E7 GetWaveLoopPos             ; the wave LOOP POS as stored: F ^ byte 2 bits 3-0
49FD DrawWaveLoopPos            ; draw the wave LOOP POS at $99EC (LOOP, PINGPONG and RESYNC only; length less loop position, 0 if negative)
4A44 DrawKitDistName            ; draw the kit DIST mode: $d0-$d3 -> " HARD"/" SOFT"/" FOLD"/" WRAP"
4ACF GetWaveSpeed               ; the wave SPEED: byte 11 + 3
4AE0 SetInstrByte11             ; write current instrument byte 11
4AF4 GetWaveLen              ; the wave LENGTH as shown: F - byte 10 bits 3-0
4B0A SetInstrByte10             ; write current instrument byte 10 (nibble-asserted path)
4B29 SetInstrByte2              ; write instrument byte 2 (pulse tune / kit half-speed+keep-attack / wave synth pre-v16)
4B4C GetVibShape            ; the PITCH field's vibrato shape: instrument byte 5 bits 2-0 (sine/saw/square << 1, bit 0 = up)
4B5E SetVibShape            ; store the vibrato shape in byte 5 bits 2-0 and redraw the PITCH field (DrawSpeedGlyph for noise, else DrawSpeedModeName)
4BAC VibShapeNext           ; A+RIGHT on PITCH: next vibrato shape (triangle, saw, square down, then up)
4BCB VibShapePrev           ; A+LEFT on PITCH: previous vibrato shape
4BE9 GetInstrType3              ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
4BF9 InstrPitchModeUp           ; pitch mode up: byte 5 bits 4/6/7 (bit 7 = top), redraw via DrawSpeedModeName
4C64 InstrPitchModeDown         ; pitch mode down: byte 5 bits 4/6/7, redraw via DrawSpeedModeName
4CD9 DrawWaveFinetune           ; draw the wave FINETUNE (byte 12) signed at $990A
4D15 DrawWaveSynthField         ; draw the WAVE/SYNTH field: 'WAVE ' + byte 3 (hex), or 'SYNTH' + byte 3 >> 4
4DD7 InstrEnvChanged       ; FarCall bank1b UpdateInstrEnv after a field edit
4FDC DrawKitNameField           ; draw kit number (hex) + 6-char kit name (ReadKitName -> wSampleNoteString)
5002 WriteKitNumber             ; write kit# into the field's low 6 bits (top flag bits preserved via $c0 mask)
503A KitSelectNext              ; step to the next existing kit bank (KitExists scan), WriteKitNumber
508C KitSelectPrev              ; step to the previous existing kit (bound $3f), WriteKitNumber
50DF KitSelectEnsure            ; ensure the kit field points at an existing kit, else fix up
5128 SetInstrType               ; write instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
5181 InstrFieldIncLo            ; current field byte: +1 on the lo nibble (clamp $0f), redraw + InstrEnvChanged
51BC InstrFieldDecLo            ; current field byte: -1 on the lo nibble (clamp 0)
51F4 InstrFieldIncHi            ; current field byte: +$10 on the hi nibble (clamp $f0)
5231 InstrFieldDecHi            ; current field byte: -$10 on the hi nibble
526B InstrLenInc             ; A+RIGHT on LENGTH (byte 3, bit 6 = limited, shown as 3F - bits 5-0): one longer, past 3F to UNLIM
52BF InstrLenDec             ; A+LEFT on LENGTH: one shorter, from UNLIM to 3F
531C InstrLenBigInc          ; A+UP on LENGTH: 16 longer, past 3F to UNLIM
537A InstrLenBigDec          ; A+DOWN on LENGTH: 16 shorter, from UNLIM to 30
53DE CloneSynthOrTable          ; clone what the instrument screen's cursor names: the softsynth on a WAVE instrument's synth field, else the instrument's table (CloneInstrTable)
; --- functions called from bank 0 (this bank paged in) ---
541F InstrScreenInput           ; instrument-screen input entry (speech $40 -> SpeechInstrInput via FarCallByte)
4790 GetInstrByte5Flag8 ; read current instr byte 5 & $08 (table AUTOMATE-class flag; unreferenced)
4ABA TxtSoft                    ; " SOFT"
4AC0 TxtFold                    ; " FOLD"
4AC6 TxtWrap                    ; " WRAP"
4025 TxtUnlim                   ; "UNLIM"
402B InstrFieldX                ; [4][18] per-type cursor X per field (NOISE row: 13): indexed [type][field]
406E InstrFieldY                ; [4][18] per-type cursor Y per field (NOISE row: 13)
40B1 InstrFieldW                ; [4][18] per-type cursor width per field (NOISE row: 13)
40F4 InstrFieldCounts           ; fields per instrument type: PULSE 16, WAVE 15, KIT 18, NOISE 13
4015 DefaultWaveFrameB3         ; default wave frame (16 bytes, bank-3 copy)

