; Bank $03 -- Instrument screen (see docs/editors.md)
4000 WriteCurrentInstrByte ; write value to field[arg] of the current instrument (wInstrument) via WriteInstrByte
4AB4 KitClipNames      ; [4][6] kit dist_type names " HARD"/" SOFT"/" FOLD"/" WRAP" (indexed by byte-$D0)
4DE7 DrawInstrumentScreen ; screen idx 6: draws instrument params (reads instruments[] 119x)
4FC4 InstrTypeNames     ; [4][6] type names "PULSE"/" WAVE"/"  KIT"/"NOISE" (indexed by type*6)
; --- mechanically-named call-targets (interface-based; some purpose TBD) ---
4105 InstrField9IsZero_4105 ; 1 if instr field 0x9 == 0 (12x)
4118 InstrGetField6_4118    ; instrument field 0x6 read (2x)
4133 InstrGetField6_4133    ; instrument field 0x6 read (2x)
4170 InstrGetField0_4170    ; instrument field 0x0 read (10x)
4257 InstrSetField5_4257    ; instrument field 0x5 write (2x)
4293 InstrGetField5_4293    ; instrument field 0x5 read (3x)
4638 InstrProc_4638         ; subroutine (purpose TBD) (2x)
4679 InstrGetField0_4679    ; instrument field 0x0 read (6x)
4741 InstrGetField8_4741    ; instrument field 0x8 read (3x)
4769 InstrGetField8_4769    ; instrument field 0x8 read (3x)
4924 InstrGetField6_4924    ; instrument field 0x6 read (4x)
5002 InstrProc_5002         ; subroutine (purpose TBD) (3x)
5128 InstrProc_5128         ; subroutine (purpose TBD) (2x)
5181 InstrProc_5181         ; subroutine (purpose TBD) (6x)
5231 InstrProc_5231         ; subroutine (purpose TBD) (6x)
