; Bank $03 -- Instrument screen (see docs/editors.md)
4000 WriteCurrentInstrByte ; write value to field[arg] of the current instrument (wInstrument) via WriteInstrByte

; --- Instrument-screen data tables + strings ---
4DCB WaveSourceNames  ; "WAVE"/"SYNTH" (wave-instrument source)
66F5 InstrParamJumps  ; jp-table for per-param draw dispatch (jp $6725/$6734/...)
7A7B InstrOptionNames ; instrument param value strings "ON"/"ATK"/"OFF"/"SAFE"/...
433B TxtOutOfSynths             ; "OUT OF SYNTHS! CLEAN INSTR DATA IN PROJECT SCREEN"
459A TxtClonedSynth   ; "CLONED SYNTH"
4AB4 TxtHard                    ; " HARD"
4DE7 DrawInstrumentScreen ; screen idx 6: draws instrument params (reads instruments[] 119x)
4FC4 InstrTypeNames     ; [4][6] type names "PULSE"/" WAVE"/"  KIT"/"NOISE" (indexed by type*6)
4105 InstrByte9IsZero           ; 1 if instrument byte 9 == 0 (kit row dashes gate; 12 uses)
4118 GetInstrTable              ; read instrument byte 6 = table (bits0-4) + enable (bit5)
4133 SetInstrTable              ; write instrument byte 6 = table (bits0-4) + enable (bit5)
4170 GetInstrType               ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
4257 SetInstrFlags5             ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4293 GetInstrFlags5             ; read instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4679 GetInstrType2              ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
4741 SetInstrByte8              ; write instrument byte 8 (kit pitch / pulse finetune)
4769 SetInstrByte82             ; write instrument byte 8 (kit pitch / pulse finetune)
4924 SetInstrTable2             ; write instrument byte 6 = table (bits0-4) + enable (bit5)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
40F8 GetInstrByte9              ; read instrument byte 9 (kit row gate: 0 -> dashes)
414F InstrCheckFieldOption      ; return 1 if option-table[c] (ROM $40F4) minus 1 == current field $c427, else 0
427B GetInstrFlags52            ; read instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
42AB InstrReadPhraseNote   ; read phrase_notes[arg] from SRAM ($A000-based) -- instrument preview
42FF ShowOutOfSynths            ; "OUT OF SYNTHS!..." -> wStrBuffer + DrawMessageBar (16-synth limit hit)
436D SetInstrTable3             ; write instrument byte 6 = table (bits0-4) + enable (bit5)
43C0 SetInstrLen                ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
441A SetInstrLen2               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
4540 SetInstrLen3               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
45A7 InstrScreenFrame           ; shared instrument-screen frame draw (map row, tempo field, marker sprites)
45D3 InstrScreenRefresh         ; reload current instrument + DrawInstrumentScreen
461B InstrAdjustNumber          ; adjust wInstrument (-16, clamp >$40 to 0, +1) then redraw via InstrScreenRefresh
4638 InstrScreenEnter           ; enter the instrument screen (speech $40 special-cased) + DrawInstrumentScreen
47A2 SetInstrFlags52            ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
482E SetInstrFlags53            ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
489D SetInstrTable4             ; write instrument byte 6 = table (bits0-4) + enable (bit5)
48D6 SetInstrTable5             ; write instrument byte 6 = table (bits0-4) + enable (bit5)
495C SetInstrTable6             ; write instrument byte 6 = table (bits0-4) + enable (bit5)
498B DrawInstrByte10            ; draw the instr byte-10 field cell at row 14 (dashes gate via InstrField9IsZero)
49B7 DrawInstrByte11            ; draw the instr byte-11 field cell ("--" when byte 9 is zero)
49E7 GetInstrByte2              ; read instrument byte 2 (pulse tune / kit half-speed+keep-attack / wave synth pre-v16)
49FD DrawInstrRow14             ; draw the type-dependent row-14 fields (dispatch by byte 9 = 2/3/4)
4A44 DrawKitDistName            ; draw the kit DIST mode: $d0-$d3 -> " HARD"/" SOFT"/" FOLD"/" WRAP"
4ACF GetInstrByte11             ; read current instrument byte 11
4AE0 SetInstrByte11             ; write current instrument byte 11
4AF4 GetInstrByte10             ; read current instrument byte 10 (KIT: dist mode $d0-$d3)
4B0A SetInstrByte10             ; write current instrument byte 10 (nibble-asserted path)
4B29 SetInstrByte2              ; write instrument byte 2 (pulse tune / kit half-speed+keep-attack / wave synth pre-v16)
4B4C GetInstrFlags53            ; read instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4B5E SetInstrFlags54            ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4BAC InstrField5Next            ; read instr field5, step +2 (wrap 6->1), write back via SetInstrFlags54
4BCB InstrField5Prev            ; read instr field5, step -2 (wrap <0 ->4), write back via SetInstrFlags54
4BE9 GetInstrType3              ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
4BF9 SetInstrFlags55            ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4C64 SetInstrFlags56            ; write instrument byte 5 flags (bit3 = table STEP/AUTOMATE mode, vibrato bits)
4CD9 DrawInstrByte12            ; read instr byte 12 + draw label/hex pair
4D15 GetInstrLen                ; read instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
4DD7 InstrEnvelopeChanged       ; FarCall bank1b UpdateInstrEnvelope after a field edit
4FDC DrawKitNameField           ; draw kit number (hex) + 6-char kit name (ReadKitName -> wSampleNoteString)
5002 WriteKitNumber             ; write kit# into the field's low 6 bits (top flag bits preserved via $c0 mask)
503A KitSelectNext              ; step to the next existing kit bank (KitExists scan), WriteKitNumber
508C KitSelectPrev              ; step to the previous existing kit (bound $3f), WriteKitNumber
50DF KitSelectEnsure            ; ensure the kit field points at an existing kit, else fix up
5128 SetInstrType               ; write instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
5181 InstrFieldIncLo            ; current field byte: +1 on the lo nibble (clamp $0f), redraw + InstrEnvelopeChanged
51BC InstrFieldDecLo            ; current field byte: -1 on the lo nibble (clamp 0)
51F4 InstrFieldIncHi            ; current field byte: +$10 on the hi nibble (clamp $f0)
5231 InstrFieldDecHi            ; current field byte: -$10 on the hi nibble
526B SetInstrLen4               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
52BF SetInstrLen5               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
531C SetInstrLen6               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
537A SetInstrLen7               ; write instrument byte 3 = length (bit6=limited, bits0-5; wave v16+: synth<<4)
53DE GetInstrType4              ; read instrument byte 0 = type (0=PULSE 1=WAVE 2=KIT 3=NOISE)
; --- functions called from bank 0 (this bank paged in) ---
541F InstrScreenInput           ; instrument-screen input entry (speech $40 -> WordScreenInput via FarCallByte)
4790 GetInstrByte5Flag8 ; read current instr byte 5 & $08 (table AUTOMATE-class flag; unreferenced)
4ABA TxtSoft                    ; " SOFT"
4AC0 TxtFold                    ; " FOLD"
4AC6 TxtWrap                    ; " WRAP"
4025 TxtUnlim                   ; "UNLIM"
402B InstrFieldX                ; per-field cursor X positions (per-type rows)
4046 InstrFieldXKit             ; kit-type X row (direct base)
406E InstrFieldY                ; per-field cursor Y positions (per-type rows)
4089 InstrFieldYWave            ; wave-type Y row (direct base)
409C InstrFieldYKit             ; kit-type Y row (direct base)
40B1 InstrFieldW                ; per-field cursor widths (per-type rows)
40F4 InstrFieldCounts           ; fields per instrument type: PULSE 16, WAVE 15, KIT 18, NOISE 13
4015 DefaultWaveFrameB3         ; default wave frame (16 bytes, bank-3 copy)

