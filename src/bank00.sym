; Bank 0 symbol map for tools/disasm.py (--symbols).
; Format: ADDR Name   (hex address, then RGBDS label). ';' starts a comment.
; Names verified by control-flow + hardware-register analysis; see
; docs/functionality.md. Update here, then regenerate src/bank00.asm.

0010 BitMasks                   ; [8]+[8] single-bit masks 1<<(7-i) then 1<<i: GBDK's crt0 puts them at $0010 for its drawing library, which LSDj does not link, so nothing reads them (bank $02's `ld hl, $0010` is the number 16)
1760 ReadKitSampleName          ; (kitbank, sampleIdx) -> copy the 3-char sample name at [kitBank $4022 + idx*3] into wSampleNoteString (switches ROM bank)
2CA4 DrawTempoField             ; set VRAM cursor $9891 + BG/digit palettes, then draw the tempo (GetTempoTimerValue)
17EC WriteVramByteSafe          ; (vramAddr, value) -> spin until rSTAT allows VRAM access, then [vramAddr]=value
2D7E DrawFieldValue             ; draw a value formatted by its type: string / hex byte (DrawHexByte) / pulse duty (DrawPulseDuty)
158F SoundInitializeKit1Sample  ; init kit voice 1 for sample e (bit 3 picks the loop-flag byte $405C/$405D): bank + sample-table lookup -> loop window/read pointer/clamps (wKit1*); -> e = 1 when the voice plays, 0 when it is switched off
1676 SoundInitializeKit2Sample  ; init kit voice 2 for sample a (asserts a < $10; wKit2*; speech uses the allophone banks); -> e = 1 when the voice plays, 0 when it is switched off
339A ResetDisplayState          ; ReinitDisplay, then clear tile-loader alloc + state (wTileRequestSlot0/wUnusedCBFB/wUnusedCBFC)
337D LoadTilesDispatch          ; C's entry to LoadTilesToVram: (the tile-graphics source) on the stack -> de = its request table entry ($0000 when all six are taken)
148B DebugNop                   ; `ld b,b; ret` -- no$gmb/BGB debug marker (no-op at runtime)
0908 WriteClipboardCell         ; wClipboardBuffer[col*42 + row] = v (asserts col < 6, row < 42)
07DA ReadClipboardCell          ; return wClipboardBuffer[col*42 + row] (asserts col < 6, row < 42)
0D8B SortBytePair               ; order the bytes at two pointers: swap them so *a <= *b
33F9 randw                      ; GBDK libc/gb/rand.s _rand/_randw: 16-bit LCG seed = seed*17 + $5C93 (wRandomSeedHigh/Lo); returns de
3826 initrand                   ; GBDK libc/gb/rand.s _initrand: seed the generator from a 16-bit stack arg
0B54 LoadSynthShape             ; page in bank $1E and sign-extend the 32 signed seed bytes at the pointer arg into wSynthShapeBuffer
338B RequestTileSlot            ; wrap SetTileLoadRequest for a tile-slot arg
36DD StringLength               ; GBDK libc/strlen.c strlen (rgbasm reserves STRLEN): the length of the NUL-terminated string at a pointer arg
3261 OrBitsIntoDaBuffer         ; OR flag bits into the wDecompressBuffer/wDecompressBufferEnd allocation buffer
3055 ReloadEnvelopeCounterPu1   ; wEnvelopeCounterPu1 = ExponentialCurve16[wEnvelopeSpeedPu1] (de = speed ptr, counter = de+1)
309C ReloadEnvelopeCounterPu2   ; wEnvelopeCounterPu2 = ExponentialCurve16[wEnvelopeSpeedPu2]
30D7 ReloadEnvelopeCounterNoi   ; wEnvelopeCounterNoi = ExponentialCurve16[wEnvelopeSpeedNoi]
3298 UploadTilesToVram          ; rSTAT-gated copy of 128 tile bytes ($DA40 -> VRAM $8060)
2CC6 DrawChannelHeader          ; draw the channel/column header at VRAM $9811, dispatched on wSongColumn (0-3)
0150 Start                      ; init (from Entry): a = the boot ROM's model id and b its AGB flag, kept in wBootHardwareId/wBootAgbId; di, stack at $E000, clear WRAM/HRAM, copy OamDmaRoutine to HRAM
0824 CommandMnemonics           ; "-ABCDEFGHKLMOPRSTVWZ": phrase/table command letters indexed by command byte (0='-'=none); CommandHandlers order
0839 PlayModeNames              ; five 9-byte table PLAY mode names "  MANUAL", "    ONCE", "    LOOP", "PINGPONG", "  RESYNC" (DrawWaveInstrument: byte 9, capped at 5)
0DDB InitializeAndLoadSong      ; second-stage boot (runs once before main's loop): SwitchToDoubleSpeed, ClearBgTilemap, init subsystems, load the working song (bank1 $4CF1/$4848) or ResetWorkState if empty, set palettes + load song properties
1377 .mainLoop                  ; poll ready flags, then process a frame (-> ProcessInput)
1CFF SyncLoadSetting            ; read song sync property ($BFBD) -> wSyncMode/wSyncMode2
254F DispatchScreenDraw         ; jp table ScreenDrawJumps indexed by wCurrentScreen ($C401): per-screen draw
2563 ScreenDrawJumps            ; 15x jp: screen index -> "select bank N; call draw; ret"
; --- per-screen draw dispatch stubs (select bank, call the screen's draw) ---
2593 DispatchScreenDraw_Phrase  ; idx 1 -> bank $04:$4CE5 (Phrase: note/instr/cmd/val grid)
25A2 DispatchScreenDraw_Groove  ; idx 2 -> bank $1D:$41DA (reads grooves)
25B1 DispatchScreenDraw_Chain   ; idx 3 -> bank $06:$5947 (chain_transp, 2 cols)
25C0 DispatchScreenDraw_Song    ; idx 4 -> bank $07:$4574 (Song: 4-channel sequence)
25CF DispatchScreenDraw_Table   ; idx 5 -> bank $05:$4762 (table_env)
25DE DispatchScreenDraw_Instrument ; idx 6 -> bank $03:$4DE7 (Instrument: reads instruments 119x)
25F0 DispatchScreenDraw_Wave    ; idx 8 -> bank $06:$4F18 (wave_frames, copy/paste)
25FF DispatchScreenDraw_Project ; idx 9 -> bank $1B:$5C17 (DrawProjectScreen)
260E DispatchScreenDraw_Synth   ; idx 10 -> bank $1D:$68AB (synth params)
2620 DispatchScreenDraw_Word    ; idx 12 -> bank $06:$41A2 (words / speech)
262F DispatchScreenDraw_File    ; idx 13 -> bank $1C:$57BB (save/load filesystem)
263E DispatchScreenDraw_Help    ; idx 14 -> bank $1B:$4A62 (help text)
264B DispatchScreenUpdate       ; per-frame per-screen update for screens 1-5 (table $268D)
268D .jumpTable                 ; 5x jp: screen 1-5 -> "select bank N; call update; ret"
269C .phrase                    ; idx 1 -> bank $1F:$648F (PhraseScreenUpdate)
26AB .groove                    ; idx 2 -> bank $1D:$4215 (GrooveScreenUpdate)
26BA .table                     ; idx 5 -> bank $05:$4967 (TableScreenUpdate)
26C9 .chain                     ; idx 3 -> bank $06:$5A62 (ChainScreenUpdate)
26D8 .song                      ; idx 4 -> bank $07:$47AA (SongScreenUpdate)
0038 Rst38                      ; rst $38, LSDj's crash vector (and its asserts'): di, ld b,b (debugger break), jr CrashTrampoline
0040 VBlankInterrupt            ; VBlank vector: push af/hl, jp VBlankHandler
0048 StatInterrupt              ; STAT vector: reti (unused)
0050 TimerInterrupt             ; timer vector: jp TimerHandler
0058 SerialInterrupt            ; serial vector: jp SerialHandler
0060 JoypadInterrupt            ; joypad vector: reti (unused)
0061 CrashTrampoline            ; trampoline: select ROM bank 1, jp CrashHandler ($794B)
0391 TimerHandler               ; timer IRQ body: sound/playback engine tick
0662 TimerHandlerReturn         ; timer IRQ epilogue: restore regs, wait rSTAT, reti
0ED6 ProcessInput               ; the frame's input: queued keyboard events or the joypad; A's release commits what was edited while held; button changes go to HandleButtonEvent at the key delay/repeat rates
1CEA GetNextButtons             ; dequeue next button state from the input ring (wButtonRing[wButtonReadIndex++]) -> e; stops at wButtonWriteIndex
2B8D HandleButtonEvent          ; process one button event: latch A/B/Select held flags (wAHeld/wBHeld/wSelectHeld) from wButtons, then HandleInputCombos + DispatchScreenInput, OR their results
271A HandleInputCombos          ; the B combos before the screen's input: B+SELECT mute, B+LEFT/RIGHT pan (song screen), B+START solo, B released restores; 1 when one took the buttons
2A71 DispatchScreenInput        ; jump table by wCurrentScreen (0-$0E, table $2A86) -> the current screen's input handler in its bank
2BC4 GetTempoTimerValue         ; -> de = tempo timer value: wTempoMode 1/2/3 -> fixed presets (2.4% more on a Super Game Boy, wIsSgb), else derived from wTempo (BPM)
2C3C DrawTempo                  ; draw the tempo at the VRAM cursor: special label for wTempoMode 1/2/3, else the BPM number (printf "%d", wTempo)
2D22 DrawPulseDuty              ; draw the pulse WAVE/duty field (top 2 bits of the instr byte) as one of 4 two-tile waveform glyphs
183A VBlankHandler              ; reloads rTIMA from tempo (wTimerReload), can raise timer IRQ
34BD SerialHandler              ; Game Boy sync RX: rSB -> wSyncReceiveByte, mode in wSyncState
18BF ReadJoypad                 ; a = rJOYP's first select (the d-pad): read the d-pad and the buttons, queue the byte in wButtonRing when it changed; the end of VBlankHandler's frame
349B display_off                ; GBDK display_off: wait VBL (rLY), clear rLCDC bit7 (byte-exact match)
34B2 OamDmaRoutine              ; OAM DMA (source wOamBuffer), copied to HRAM (hOamDmaRoutine) and called there by VBlankHandler with hl = wOamDirty, which it clears
3154 SetOamByte                 ; write byte (sp+6) to wOamBuffer+offset(sp+4) only if changed; set wOamDirty (-> OAM DMA next frame)
; marker/cursor sprite field setters (sprite group at OAM byte $0C+; offset = index*4 + field), used by every editor screen's draw code
31E3 SetSpriteY                 ; OAM Y of sprite (arg) = row*8 + $20, clamped to $FC when off-screen
31B5 SetSpriteX                 ; OAM X of sprite (arg) = col*8 + $08
319E ClearSpriteY               ; OAM Y of sprite (arg) = 0 (move off-screen / hide)
321C SetSpriteTile3             ; OAM tile of sprite (arg) = $03
3233 SetSpriteTile4             ; OAM tile of sprite (arg) = $04
324A SetSpriteAttribute         ; OAM attr of sprite (arg) = value (arg2)
3176 PositionWavSprites         ; set OAM Y=$68 for sprites 0,1,2 -- the WAV channel's on-screen wave display (right edge, tiles $00-$02); only when the WAV channel is active (ResetScreenSprites)
30DD ClearSprites012            ; zero OAM Y of sprites 0,1,2 (wOamBuffer +0/+4/+8)
30EC ClearMarkerSprites         ; hide the marker sprites 3-10 (Y and attr = 0) and the cursor sprites 11-18 (X = 0); set wOamDirty
1500 ReadSongBytes              ; bulk copy from SRAM (bank, src) into a RAM dest buffer (e.g. a chain row)
3A33 ResetWorkState             ; reset all runtime state to defaults: per-channel sequencer ptrs (read ptr=$0140, rows=$FF, instr/table/groove=0) + editor cursors + wCurrentScreen=SONG; e.g. when a song load comes back empty
14D1 ReadSongByte               ; (bank, address) on the stack -> e = SRAM's byte there: asserts bank < $10, di, maps the bank and enables RAM, reads, disables RAM, reti
14EB ReadSongByteRaw            ; (bank, address) on the stack -> e = SRAM's byte there, as ReadSongByte without di/reti (the caller holds interrupts off)
158C WaitInterrupt              ; halt;nop;ret -- wait for the next interrupt (frame sync)
1799 CallHL                     ; `jp hl` trampoline (gbz80 has no `call hl`); FarCall uses it to call the target in hl
179A FarCall                    ; banked call: caller pushes (addr, bank); switch ROM bank, call addr, restore
17BB FarCallArgument            ; like FarCall but also passes one byte argument to the callee
1574 WriteSongByte              ; (bank,addr,val): select SRAM bank + enable RAM, write [de] (write side of ReadSongByte)
; --- screen-drawing helpers (VRAM cursor $C574/$C575, string src $C564/$C565) ---
24DD RedrawScreen               ; full screen repaint: ResetScreenSprites, ClearBgTilemap (CGB), then the current screen's (wCurrentScreen) draw passes across banks; called through FarCall from 18 places, so whichever bank they name is mapped meanwhile
24A8 ResetScreenSprites         ; before a redraw: clear marker sprites (ClearSprites012 + ClearMarkerSprites), or position sprites 0/1/2 (PositionWavSprites) when the WAV channel is active
0DBC ShowMessage                ; copy the string arg into wStringBuffer and trigger the on-screen message/popup (bank1 $74F7 sets wMessageStringPointer -> wStringBuffer); 47 callers
2EAD DrawTileRun                ; draw a run of `count` UI tiles at (col,row): type 0 = cursor arrow (tile $03), 1 = blank (tile $48), else solid block (tile $8D)
2F68 DrawStringTile20           ; DrawStringIndexed entry with offset $20: draw the tile at wStringSource+$20 to the VRAM cursor
2F21 DrawString                 ; draw a NUL/len string to the VRAM tilemap cursor
2F6A DrawStringIndexed          ; draw from the string source at a byte offset
2E33 DrawHexByte                ; draw a as two hex digits at the cursor (wVramCursor, advanced; asserts it is in the $9800-$9BFF map)
2E6D DrawByte                   ; draw a byte (stack arg) at the cursor
352A printn                     ; GBDK libc/printf.c's _printn: a word in a base at the console cursor, a minus first when signed
35B1 DigitCharacters            ; "0123456789ABCDEF" (printn's digit table, indexed by the digit value)
35C2 printf                     ; GBDK libc/printf.c printf at the console cursor: %c, %u, %d, %x (via printn), %s
1298 ColorField                 ; color a field of w tiles at (x, y) with palette pal: CGB attributes through wAttributeRowBuffer, a DrawTileRun on DMG
17E1 AnyChannelFlagSet          ; e = nonzero if any of the 4 per-channel bytes $C423-$C426 is set (chain-screen per-channel state; caller resets the wIdleFrames idle counter on activity)
17FB ClearBgTilemap             ; fill the visible 20x18 BG tilemap ($9800) with tile 0, rSTAT-gated
; --- dynamic VRAM tile loader: queue of tile-graphics load requests ($CBE6 table, $CBE4 slot counter) ---
32E3 LoadTilesToVram            ; LCD off: register the tile-graphics source in hl in a free wTileRequestTable slot (-> hl = the slot's entry, $0000 when all six are taken), allocate its VRAM tile slots (wTileSlotAllocation), load via CopyTileData, restore the LCD
3370 SetTileLoadRequest         ; hl -> a 3-byte tile-load request: wTileLoadSlot (the slot and flags), wTileLoadSource (the source pointer)
332B CopyTileData               ; copy a queued tile's 16-byte graphics to VRAM tile data ($9000 + wTileLoadSlot*16), rSTAT-gated (falls into the $32AD copy loop); the carry it is entered with shifts into the count (`rl e`): its caller clears it
33D5 ReinitDisplay              ; ensure LCD on with standard rLCDC config (cycle off via display_off if needed; BG on, $9800 map, $8800 tiles) + ResetTileLoader
33EC ResetTileLoader            ; reset tile-loader state: clear wUnusedCBF7/wUnusedCBF8, set wTileLoadNow=2 (immediate-copy mode)
39CD set_bkg_tiles              ; GBDK set_bkg_tiles(x, y, w, h, tiles) (set_bk_t.s, byte-exact): unpack the stack args -> set_xy_btt
39F2 set_xy_btt                 ; GBDK .set_xy_btt (set_xy_t.s): background tiles from bc at (x, y) = (d, e), (w, h) = (h, l); map base from rLCDC bit 3 ($9800/$9C00), then set_xy_tt
; --- defensive checks ---
0953 WriteInstrumentByte        ; write value (sp+8, <4) to instruments[instr][field]: bank1 $B080 + instr*$10 + field
09B9 DrumPeriodTable            ; [108] UWORD n * 2048 / 107 ($0000, $0013, ... $07FC): the periods of a channel whose instrument's PITCH is DRUM (wChannelDrumPitch), linear in the period; SoundNoteToPeriod aims wChannelPeriodTablePointer here, a byte at a time, in place of wNotePeriods
0A91 ReadInstrumentByte         ; read instruments[instr][field]: SRAM bank1 $B080 + instr*$10 + field (asserts instr<$40, field<$10)
0AE2 ReadCurrentInstrumentByte  ; ReadInstrumentByte([wInstrument] current instrument, field)
0AF6 ReadSequenceByte           ; read song sequence song[step][channel]: bank0 $B290 + step*4 + channel (step<$C0, channel<4)
2141 ReadChainByte              ; read chain[chain(sp+6)][field(sp+7)] from SRAM $A080 + chain*32 + field (via ReadSongByteRaw)
1478 KitIndexToBank             ; a = a kit index -> e = its ROM bank: +8 (kits start at bank $08), +5 more from $1B on to skip the code banks $1B-$1F
0D4C ReadKitName                ; copy the 6-char kit name (kit bank $4052, via KitIndexToBank) into wSampleNoteString
; SDCC banked-call thunk family (bc-addr style: save bank, switch, jp hl, restore),
; one per (arg-count, return-type). The sp-addr style lives at FarCall/FarCallArgument.
0BFE FarCallByte                ; call a function in another ROM bank, returning its byte (e)
0C29 FarCallArgumentByte        ; call fn(arg) in another ROM bank, returning its byte (e)
0C5A FarCallArgument2V          ; call fn(a, b) in another ROM bank
0C8F FarCallArgument2           ; call fn(a, b) in another ROM bank, returning its byte (e)
0CC5 FarCallArgument3           ; call fn(a, b, c) in another ROM bank
0CFE KitExists                  ; (kit index) -> e = 1 if a kit is present at KitIndexToBank(index): switch to that bank and check [$4000:01] == $6040
2106 ReadSequenceByteRaw        ; ReadSequenceByte via ReadSongByteRaw (bank0 $B290)
1482 DebugTrap                  ; assert/debug trap (ld b,b BGB marker + rst $38), fires once via wDebugTrapped

; --- Sound engine: per-channel pitch slide / vibrato / frequency (TimerHandler tick) ---
0762 SoundLoadWaveRam           ; fast-copy the 16-byte staged waveform (hWavUploadBuffer $FFA0) into WAV wave RAM ($FF30) with rAUD3 off (SP-pop trick), then re-enable + retrigger rAUD3 and restore freq; -> bc = the WAV frequency it restores (popped through bc after the wave)
066D SoundModulateWavFrequency  ; WAV ch direct-frequency modulation: wChannelFrequency+4 += wChannelPitchRate+4; if vibrato active apply wChannelVibratoOffset+4 (steps WAV vib via SoundApplyWavVibrato, then halved offset); -> a = 0 when vibrato is off, else the frequency's high byte: what SoundRunTableStep's WAV path hands back
1AFF SoundApplyWavVibrato       ; apply WAV-channel vibrato: if wChannelVibratoSpeed+5, compute offset (SoundCalculateVibratoOffset) -> wChannelVibratoOffset+4/5 and advance vib phase wChannelVibratoAccumulatorWav (-> e = the speed's high byte; e as it was when off); shared by SoundStepPitchVibratoWav + SoundModulateWavFrequency
1815 TickWorkTimeClock          ; bump saturating counter wWorkClockSubFrame (<$80), advance wWorkTimeAccumulator ($C69D); wrap at $0E00 -> wWorkTimeTicks ($C577), clear wIdleHalt
20DB HandleTooBusy              ; CPU-overload handler (redraw backlog overflowed while playing): reset playback (bank2 $710E: exit live mode + sound reinit) and ShowMessage "TOO BUSY!"
1986 SoundCalculateVibratoOffset ; a = the vibrato phase, e = the shape's offset in VibratoShapes, hl -> the depth: VibratoShapes[(a >> 2) + e], negated when its bit 7 is set (SoundCalculateVibratoOffsetNeg), scaled by the VibratoOffsetJumps fragment the depth byte picks -> hl = the signed offset
19A1 SoundCalculateVibratoOffsetNeg ; SoundCalculateVibratoOffset's negative half: a = the shape value (complemented here), hl -> the depth; -> hl from the VibratoOffsetJumps fragment, which the caller negates
19A6 SoundStepPitchVibratoPu1   ; ch0: accumulate wChannelPitchRate->wChannelPitchCurrent, clamp to wChannelPitchTarget (-> SoundUpdatePitchModulationFlagPu1); advance vib phase wChannelVibratoAccumulator -> wChannelVibratoOffset; -> e nonzero when it moved the pitch
1A26 SoundStepPitchVibratoPu2   ; ch1: as PU1 for +2/+3 offsets (-> SoundUpdatePitchModulationFlagPu2); vib phase wChannelVibratoAccumulatorPu2 -> wChannelVibratoOffset+2; -> e nonzero when it moved the pitch
1AA7 SoundStepPitchVibratoWav   ; ch2: as PU1 for +4/+5 offsets (-> SoundUpdatePitchModulationFlagWav); vib phase wChannelVibratoAccumulatorWav -> wChannelVibratoOffset+4; -> e nonzero when it moved the pitch
1CBA SoundStepPitchVibratoNoi   ; ch3 (noise): vibrato via SoundCalculateVibratoOffset then >>5 scale; advance vib phase wChannelVibratoAccumulatorNoi (no period table); -> e = the offset / 32, the noise note's
1B28 SoundInterpolatePeriod     ; d = the note and e its fraction, bc -> wChannelPeriodTablePointer, hl -> wChannelPitchCurrent's high byte (re-read on the octave wrap) -> de = the 16-bit period from the table, interpolated by the fraction; octave-wrap special cases ($6C/$B6/$F8/$FF)
1BA7 SoundWriteFrequencyPu1     ; ch0: wChannelOutNote+transpose[wChannelNoteOffset]+finetune+vib+pitch -> SoundInterpolatePeriod -> wChannelFrequency + rAUD1LOW/HIGH/LEN
1BF6 SoundWriteFrequencyPu2     ; ch1: like PU1 -> wChannelFrequency+2 + rAUD2LOW/HIGH/LEN
1C3D SoundWriteFrequencyWav     ; ch2: like PU1 -> wChannelFrequency+4 + rAUD3LOW/HIGH (rAUD3LEN=0)
1C7C SoundUpdatePitchModulationFlagCurrent ; dispatch by hSoundChannel -> SoundUpdatePitchModulationFlag{Pu1,Pu2,Wav} (channel 0, 1, 2 and up)
1C84 SoundUpdatePitchModulationFlagWav ; ch2: wChannelPitchModulationActiveWav = (wChannelPitchRate+4|+5 | wChannelVibratoSpeed+5)!=0, skipped if wChannelVibratoShape+2 set
1C96 SoundUpdatePitchModulationFlagPu2 ; ch1: wChannelPitchModulationActivePu2 = (wChannelPitchRate+2|+3 | wChannelVibratoSpeed+3)!=0, skipped if wChannelVibratoShape+1 set
1CA8 SoundUpdatePitchModulationFlagPu1 ; ch0: wChannelPitchModulationActive = (wChannelPitchRate+0|+1 | wChannelVibratoSpeed+1)!=0, skipped if wChannelVibratoShape set

; --- Sound: software envelope (DMG "zombie mode" volume via NRx2 rewrites) ---
2FC3 SoundFadeEnvelopeStep      ; hl -> the channel's volume: step it one unit toward target a; c = the channel's NRx2 port (rAUDxENV); equal->ret; up->NRx2=$08; down->SoundFadeEnvelopeStepDown
2F9A SoundFadeEnvelopeStepDown  ; volume down a step: hl -> the channel's volume, c = its NRx2 port (rAUDxENV): dec the level, rewrite NRx2 with $09/$11/$18; near level $0E wait for the rDIV phase (anti-click), CGB vs DMG
2FCC SoundUpdateEnvelopePu1     ; per-tick PU1 software envelope: SoundFadeEnvelopeStep wChannelEnvelope toward target [wEnvelopeTargetPu1] via rAUD1ENV, then advance env stage
2FE2 SoundUpdateEnvelopePu2     ; per-tick PU2 software envelope: wChannelEnvelope+1 toward [wEnvelopeTargetPu2] via rAUD2ENV
2FF8 SoundUpdateEnvelopeNoi     ; per-tick NOI software envelope: wChannelEnvelope+3 toward [wEnvelopeTargetNoi] via rAUD4ENV

; --- Link cable sync (see docs/sync.md) ---
1E93 DispatchSyncClock          ; per sync tick: reset wSyncTick=$FF; if playing, dispatch by wSyncMode (1=LSDJ->SyncTickLsdj, 3=MIDI->SyncTickMidi); preserves ROM bank
1D29 SyncStartTransport         ; on play-start (LSDJ/MIDI): if LSDJ idle (wSyncTick=$FF) become leader (wSyncRun=1, SyncSetSendMode) else send handshake
1D6C SyncStopTransport          ; on play-stop: LSDJ/MIDI -> reset wSyncRun/Tick/Handshake + SyncSetReceiveMode; AN.OUT (7) -> wAnalogOutTimer=3
1D9D SyncTickLsdj               ; LSDJ sync tick: in live mode reset per-channel play state + redraw SONG row indicators (bank2 $5F5E); else copy wCurrentScreen->wPlayMode (bank2 $7C4C)
1E75 SyncTickMidi               ; MIDI sync tick: if live mode -> SyncTickLsdj, else advance playback twice (bank2 $7C4C)
1EC8 SyncSetSendMode            ; send/leader config: wSyncSendGate=1, wSyncSerialIeMask=0, enable VBlank IRQ + disable serial-receive IRQ
1EE3 SyncSetReceiveMode         ; receive/follower config: wSyncSendGate=0, wSyncSerialIeMask=8, enable serial-receive IRQ, wSyncTick=$FF, SendSyncHandshake
1F06 SyncApplyMode              ; (re)configure sync for wSyncMode: di, wSyncRun=0, dispatch 0/1/3/5/6/7 -> SyncSetSendMode/SyncSetReceiveMode/gates/handshake
01AA InitializeSerial           ; boot: arm rSC=$80 (slave), preload rSB=$66
14B9 SerialHandlerTail          ; serial IRQ tail: sync bookkeeping -> TimerHandlerReturn
3467 SendSyncByte               ; master: wSyncState=1, send wSyncTransmitByte, rSC=$81 (internal clock)
347A SendSyncHandshake          ; master: wSyncState=2, send $55, rSC=$80
234D ProcessSyncByte            ; consume received $CBDD: <$FD position / >=$FD transport
227C SendByteStep               ; one step of the multi-byte (MIDI) send loop
1F9A SyncSendAnalogClock        ; AN.OUT mode: emit clock pulse byte ($FF/$00 by wAnalogOutTimer ticks/step, reloaded from wSyncMode2) via SendSyncByte
23CA SyncReceiveAnalogClock     ; AN.IN mode (wSyncSendGate>=2): process the incoming clock pulse byte (rSB), counting via $CB77-79 to advance the sequencer
217C SyncSeekSongPosition       ; (non-live) seek the song playback position to the received sync position (LSDJ wSyncReceivePosition / else wSyncStartRow): per channel, scan the song sequence (ReadSequenceByteRaw) following chain links
34F0 GetTileLoadNow             ; -> e = wTileLoadNow ($CBDB, the tile loader's flag); nothing calls it
34F5 EnableInterrupts           ; ei; ret
34F7 DisableInterrupts          ; di; ret
34F9 SoftReset                  ; a = boot id [wBootHardwareId]; jp Start (b, Start's AGB flag, is the caller's)
34FF SetInterruptEnable         ; a = the interrupts to enable: rIE = a, and rIF acknowledged for the newly enabled ones
3424 SwitchToDoubleSpeed        ; CGB KEY1 speed switch to double-speed (no-op if rSPD bit7 already set): disable IRQs, rJOYP=$30, rSPD=1, stop, restore rIE
20B3 ChecksumRomBank            ; 16-bit sum of all bytes in the current ROM bank ($4000-$7FFF) -> de
20C4 TestSram                   ; write/read-back test of SRAM bank $A000-$BFFF (writes 0); e = end offset on success / high byte on failure
343F abs                        ; GBDK libc/abs.c: the absolute value of a signed word
33B9 SetVramCursor              ; point wVramCursor at BG map cell (x, y): $9800 + y*32 + x (the next DrawString/DrawHexByte draws there)
3831 strcpy                     ; GBDK/SDCC strcpy(dest=sp+2, src=sp+4): copy until NUL (byte-exact match)
3843 memcpy                     ; SDCC memcpy(dest=sp+4, src=sp+6, n=sp+8): copy n bytes (16-bit count)
3863 StringCompare              ; SDCC strcmp (rgbasm reserves STRCMP): s1=sp+2, s2=sp+4, byte compare -> de = 0 (equal) / +1 / -1
391B joypad                     ; GBDK joypad(): read P1 d-pad (P14) + buttons (P15) matrix -> combined active-high byte in e
3983 delay                      ; GBDK delay(d): 16-bit count from stack -> DelayTicks
3949 DelayTicks                 ; busy-wait de units (DelayLoop) plus a fixed tail loop (delay impl)
3966 DelayLoop                  ; calibrated inner busy-wait: decrement de to 0 (jr+0 cycle-padding chain)
3887 FillMemoryLoop             ; inner loop: fill de bytes at hl with value b
38D8 set_bkg_palette            ; GBDK: write CGB BG palettes (first,nb,rgb_data) via rBGPI/rBGPD
388F FillMemory                 ; memset(dest=sp+4, value=sp+6, count=sp+7) -> FillMemoryLoop
38A2 MulU8                      ; SDCC runtime: (x, y) bytes on the stack -> e = x * y (MulCharToInt)
38AE MulU16                     ; SDCC runtime: (x, y) words on the stack -> de = x * y (MulInt)
38BF MulCharToInt               ; c * e (8-bit): zero-extend (b=0, d=0), fall into MulInt -> hl (l the 8-bit product)
38C2 MulInt                     ; core 16x16->16 shift-and-add multiply (hl = bc * de)

; --- SDCC runtime: 8/16-bit signed+unsigned division & modulo (Div does the ---
; --- quotient move; Mod returns the remainder; both share a restoring core) ---
3715 DivS8                      ; signed 8-bit divide -> quotient in e (DivModS8 then move c->e)
3721 ModS8                      ; signed 8-bit modulo -> remainder in e (DivModS8)
372C DivS16                     ; signed 16-bit divide -> quotient in de (DivModS16 then bc->de)
373D ModS16                     ; signed 16-bit modulo -> remainder in de (DivModS16)
374C DivU8                      ; unsigned 8-bit divide -> quotient in e (DivModU8 then move c->e)
3758 ModU8                      ; unsigned 8-bit modulo -> remainder in e (DivModU8)
3763 DivU16                     ; unsigned 16-bit divide -> quotient in de (DivModU16 then bc->de)
3774 ModU16                     ; unsigned 16-bit modulo -> remainder in de (DivModU16)
3783 DivModS8                   ; sign-extend 8-bit operands (c->bc, e->de), fall into DivModS16
378B DivModS16                  ; signed bc / de -> bc = the quotient, de = the remainder (with the dividend's sign); carry on division by zero: save/apply the operand signs, DivModU16, restore the signs
37C1 DivModU8                   ; c / e (8-bit): zero-extend (b=0, d=0), fall into DivModU16 -> c = the quotient, e = the remainder
37C4 DivModU16                  ; unsigned divide core: dividend bc / divisor de -> quotient bc, remainder de; div-by-zero -> 0 + carry; 16x DivStep
380F DivStep                    ; one restoring-division step for DivModU16: hl = the dividend shifting out (the quotient shifting in from carry), bc = the remainder, de = the divisor: shift, subtract de from bc when it fits -> carry = the quotient bit

; --- indirect (FarCall) targets, resolved by tools/farcall_targets.py ---
39E1 set_xy_wtt                 ; GBDK .set_xy_wtt (set_xy_t.s): window tiles from bc at (x, y) = (d, e), (w, h) = (h, l); map base from rLCDC bit 6 ($9800/$9C00), then set_xy_tt
1FD5 CheckRomChecksum           ; sum ROM bytes vs header global checksum ($014E/$014F) -- SRAM/boot self-test path
154B ReadSongByteDi             ; di + SRAM enable + bank select + read + reti (unreferenced variant of ReadSongByte)
34E9 SendSyncHandshakeByte      ; alt-entry into SendSyncHandshake with hl=arg (unreferenced)
1E70 TxtBlank4                  ; "    " 4-space blank field string
0104 NintendoLogo               ; [48] the logo the boot ROM compares (rgbfix -v fixes it)
0134 HeaderTitle                ; "LSDj-v9.4.0" the title, NUL-padded to $0143
0143 HeaderCgbFlag              ; [1] $80: CGB features, DMG compatible
0144 HeaderNewLicensee          ; "00" the new licensee code
0146 HeaderSgbFlag              ; [1] $00: no SGB features
0147 HeaderCartridgeType        ; [1] $1B: MBC5 + RAM + battery
0148 HeaderRomSize              ; [1] $05: 1 MiB, 64 banks
0149 HeaderRamSize              ; [1] $04: 128 KiB, 16 banks
014A HeaderDestination          ; [1] $00: Japan
014B HeaderOldLicensee          ; [1] $33: the new licensee code says
014C HeaderVersion              ; [1] $01: the ROM's version
014D HeaderChecksum             ; [1] the header checksum (rgbfix -v computes it)
014E GlobalChecksumHigh         ; [1] the ROM's global checksum, high byte (CheckRomChecksum; rgbfix -v computes it)
014F GlobalChecksumLow          ; [1] its low byte
300F ExponentialCurve16         ; [16] exponential curve $00..$73: envelope speed -> frame count
086F AsciiCharacterMap          ; [89] character-to-tile map from space onward; text draws set wStringSource to this address minus $20
08C8 IdentityCharacterMap       ; [64] identity tile-index map (loaded into wStringSource for raw-tile draws)
01E0 SyncModeStubs              ; 4 x 4-byte jp-hl slots from SendSyncHandshake ((mode&3)*4); only slot 0 (ret) populated
0200 VibratoShapes              ; [16][16] the vibrato shapes, 64 steps each -- triangle (the manual's sin), saw, square, then flat -- as offsets into VibratoOffsetJumps; bit 7 marks the negative half, the offset its complement (SoundCalculateVibratoOffset reads them through page $02)

; --- vector page ($0000-$0068): Emulicious segments the RST/interrupt slots
; and creates _DATA_ labels for every data run/accessed offset, ignoring
; symbol+offset -- so every non-code byte gets its own symbol. ---
0011 BitMaskBit6                ; bit mask $40 (BitMasks descending set)
0012 BitMaskBit5                ; bit mask $20 (BitMasks descending set)
0013 BitMaskBit4                ; bit mask $10 (BitMasks descending set)
0014 BitMaskBit3                ; bit mask $08 (BitMasks descending set)
0015 BitMaskBit2                ; bit mask $04 (BitMasks descending set)
0016 BitMaskBit1                ; bit mask $02 (BitMasks descending set)
0017 BitMaskBit0                ; bit mask $01 (BitMasks descending set)
0018 BitMasksAscending          ; ascending bit masks: [BitMasksAscending+n] = 1<<n (this byte: bit 0); unread, as BitMasks
0019 BitMaskAscending1          ; bit mask $02 (ascending set)
001A BitMaskAscending2          ; bit mask $04 (ascending set)
001B BitMaskAscending3          ; bit mask $08 (ascending set)
001C BitMaskAscending4          ; bit mask $10 (ascending set)
001D BitMaskAscending5          ; bit mask $20 (ascending set)
001E BitMaskAscending6          ; bit mask $40 (ascending set)
001F BitMaskAscending7          ; bit mask $80 (ascending set)
0001 PaddingRst00               ; 15 x $FF: RST $00's tail after its ret, and the unused RST $08 slot
0020 PaddingRst20               ; 24 x $FF: the unused RST $20, $28 and $30 slots
003C PaddingRst38               ; 4 x $FF: RST $38's tail
0045 PaddingVBlank              ; 3 x $FF: the VBlank vector's tail
0049 PaddingStat                ; 7 x $FF: the STAT vector's tail (after its reti)
0053 PaddingTimer               ; 5 x $FF: the timer vector's tail
005B PaddingSerial              ; 5 x $FF: the serial vector's tail
1BA1 SoundInterpolateResume     ; the resume point SoundInterpolatePeriod pushes for its manual call at $1B99: hl -> a table entry -> de = the period there
2D12 TxtNoi                     ; "NOI"
2D16 TxtPu1                     ; "PU1"
2D1A TxtPu2                     ; "PU2"
2D1E TxtWav                     ; "WAV"
2D20 TxtWavTail                 ; last char of TxtWav (walker split)
2020 CheckRomChecksumMiddle1    ; @deploy-only: interior of CheckRomChecksum (Emulicious walker artifact)
2030 CheckRomChecksumMiddle2    ; @deploy-only: interior of CheckRomChecksum

