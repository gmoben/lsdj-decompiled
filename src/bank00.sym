; Bank 0 symbol map for tools/disasm.py (--symbols).
; Format: ADDR Name   (hex address, then RGBDS label). ';' starts a comment.
; Names verified by control-flow + hardware-register analysis; see
; docs/functionality.md. Update here, then regenerate src/bank00.asm.

0010 BitMasks           ; [8]+[8] single-bit masks 1<<(7-i) then 1<<i (bit select; used by bank02 $637C/$63A7)
1760 ReadKitSampleName  ; (kitbank, sampleIdx) -> copy the 3-char sample name at [kitBank $4022 + idx*3] into wSampleNoteString (switches ROM bank)
2CA4 DrawTempoField     ; set VRAM cursor $9891 + BG/digit palettes, then draw the tempo (GetTempoTimerVal)
17EC WriteVramByteSafe  ; (vramAddr, value) -> spin until rSTAT allows VRAM access, then [vramAddr]=value
2D7E DrawFieldVal     ; draw a value formatted by its type: string / hex byte (DrawHexByte) / pulse duty (DrawPulseDuty)
158F InitKit1Sample   ; init kit voice 1: bank + sample-table lookup -> loop window/read ptr/clamps (wKit1*)
1676 InitKit2Sample   ; init kit voice 2 (wKit2*); speech uses allophone banks
339A ResetDisplayState   ; ReinitDisplay, then clear tile-loader alloc + state ($cbe5/$cbfb/$cbfc)
337D LoadTilesDispatch   ; route a tile-slot arg to LoadTilesToVram / SetTileLoadReq
148B DebugNop            ; `ld b,b; ret` -- no$gmb/BGB debug marker (no-op at runtime)
0908 WriteClipboardCell         ; wClipboardBuf[col*42 + row] = v (asserts col < 6, row < 42)
07DA ReadClipboardCell          ; return wClipboardBuf[col*42 + row] (asserts col < 6, row < 42)
0D8B SortBytePair               ; order the bytes at two pointers: swap them so *a <= *b
33F9 randw                      ; GBDK libc/gb/rand.s _rand/_randw: 16-bit LCG seed = seed*17 + $5C93 (wRngSeedHi/Lo); returns de
3826 initrand                   ; GBDK libc/gb/rand.s _initrand: seed the generator from a 16-bit stack arg
0B54 LoadSynthShape             ; page in bank $1E and sign-extend the 32 signed seed bytes at the pointer arg into wSynthShapeBuf
338B RequestTileSlot     ; wrap SetTileLoadReq for a tile-slot arg
36DD StrLength                     ; GBDK libc/strlen.c strlen (rgbasm reserves STRLEN): the length of the NUL-terminated string at a pointer arg
3261 OrBitsIntoDaBuf  ; OR flag bits into the $DA00/$DA4F allocation buffer
3055 ReloadEnvCounterPu1 ; wEnvCounterPu1 = ExpoCurve16[wEnvSpeedPu1] (de = speed ptr, counter = de+1)
309C ReloadEnvCounterPu2 ; wEnvCounterPu2 = ExpoCurve16[wEnvSpeedPu2]
30D7 ReloadEnvCounterNoi ; wEnvCounterNoi = ExpoCurve16[wEnvSpeedNoi]
3298 UploadTilesToVram  ; rSTAT-gated copy of 128 tile bytes ($DA40 -> VRAM $8060)
2CC6 DrawChanHeader   ; draw the channel/column header at VRAM $9811, dispatched on wSongCol (0-3)
0150 Start              ; init: di, stack=$E000, clear WRAM/HRAM, save boot regs
0824 FxMnemonics        ; "-ABCDEFGHKLMOPRSTVWZ": phrase/table command letters indexed by command byte (0='-'=none); FxCmdTable order
0839 PlayModeNames              ; five 9-byte table PLAY mode names "  MANUAL", "    ONCE", "    LOOP", "PINGPONG", "  RESYNC" (DrawWaveInstr: byte 9, capped at 5)
0DDB InitAndLoadSong    ; second-stage boot (runs once before MainLoop): SwitchToDoubleSpeed, ClearBgTilemap, init subsystems, load the working song (bank1 $4CF1/$4848) or ResetWorkState if empty, set palettes + load song properties
1377 .mainLoop            ; (was MainLoop) poll ready flags, then process a frame (-> ProcessInput)
1CFF LoadSyncSetting    ; read song sync property ($BFBD) -> $CB66/$CB67
254F ScreenDrawDispatch ; jp table $2563 indexed by wCurScreen ($C401): per-screen draw
2563 ScreenDrawTable    ; 15x jp: screen index -> "select bank N; call draw; ret"
; --- per-screen draw dispatch stubs (select bank, call the screen's draw) ---
2593 DrawDispatch_Phrase     ; idx 1 -> bank $04:$4CE5 (Phrase: note/instr/cmd/val grid)
25A2 DrawDispatch_Groove     ; idx 2 -> bank $1D:$41DA (reads grooves)
25B1 DrawDispatch_Chain      ; idx 3 -> bank $06:$5947 (chain_transp, 2 cols)
25C0 DrawDispatch_Song       ; idx 4 -> bank $07:$4574 (Song: 4-channel sequence)
25CF DrawDispatch_Table      ; idx 5 -> bank $05:$4762 (table_env)
25DE DrawDispatch_Instr ; idx 6 -> bank $03:$4DE7 (Instrument: reads instruments 119x)
25F0 DrawDispatch_Wave       ; idx 8 -> bank $06:$4F18 (wave_frames, copy/paste)
25FF DrawDispatch_Proj    ; idx 9 -> bank $1B:$5C17 (DrawProjScreen)
260E DrawDispatch_Synth      ; idx 10 -> bank $1D:$68AB (synth params)
2620 DrawDispatch_Word       ; idx 12 -> bank $06:$41A2 (words / speech)
262F DrawDispatch_File       ; idx 13 -> bank $1C:$57BB (save/load filesystem)
263E DrawDispatch_Help       ; idx 14 -> bank $1B:$4A62 (help text)
264B ScreenUpdateDispatch ; per-frame per-screen update for screens 1-5 (table $268D)
268D .jumpTable           ; (was ScreenUpdateTable) 5x jp: screen 1-5 -> "select bank N; call update; ret"
269C .phrase              ; (was UpdateDispatch_Phrase) idx 1 -> bank $1F:$648F (PhraseScreenUpdate)
26AB .groove              ; (was UpdateDispatch_Groove) idx 2 -> bank $1D:$4215 (GrooveScreenUpdate)
26BA .table               ; (was UpdateDispatch_Table) idx 5 -> bank $05:$4967 (TableScreenUpdate)
26C9 .chain               ; (was UpdateDispatch_Chain) idx 3 -> bank $06:$5A62 (ChainScreenUpdate)
26D8 .song                ; (was UpdateDispatch_Song) idx 4 -> bank $07:$47AA (SongScreenUpdate)
0038 Rst38                      ; rst $38, LSDj's crash vector (and its asserts'): di, ld b,b (debugger break), jr CrashTrampoline
0040 VBlankInterrupt            ; VBlank vector: push af/hl, jp VBlankHandler
0048 StatInterrupt              ; STAT vector: reti (unused)
0050 TimerInterrupt             ; timer vector: jp TimerHandler
0058 SerialInterrupt            ; serial vector: jp SerialHandler
0060 JoypadInterrupt            ; joypad vector: reti (unused)
0061 CrashTrampoline            ; trampoline: select ROM bank 1, jp CrashHandler ($794B)
0391 TimerHandler       ; timer IRQ body: sound/playback engine tick
0662 TimerHandlerReturn ; timer IRQ epilogue: restore regs, wait rSTAT, reti
0ED6 ProcessInput       ; the frame's input: queued keyboard events or the joypad; A's release commits what was edited while held; button changes go to HandleButtonEvent at the key delay/repeat rates
1CEA GetNextButtons     ; dequeue next button state from the input ring ($CE00[wButtonReadIdx++]) -> e; stops at wButtonWriteIdx
2B8D HandleButtonEvent  ; process one button event: latch A/B/Select held flags (wAHeld/wBHeld/wSelectHeld) from wButtons, then HandleInputCombos + DispatchScreenInput, OR their results
271A HandleInputCombos  ; the B combos before the screen's input: B+SELECT mute, B+LEFT/RIGHT pan (song screen), B+START solo, B released restores; 1 when one took the buttons
2A71 DispatchScreenInput ; jump table by wCurScreen (0-$0E, table $2A86) -> the current screen's input handler in its bank
2BC4 GetTempoTimerVal ; -> de = tempo timer value: wTempoMode 1/2/3 -> fixed CGB/DMG presets, else derived from wTempo (BPM)
2C3C DrawTempo          ; draw the tempo at the VRAM cursor: special label for wTempoMode 1/2/3, else the BPM number (printf "%d", wTempo)
2D22 DrawPulseDuty      ; draw the pulse WAVE/duty field (top 2 bits of the instr byte) as one of 4 two-tile waveform glyphs
183A VBlankHandler      ; reloads rTIMA from tempo ($C578), can raise timer IRQ
34BD SerialHandler      ; Game Boy sync RX: rSB -> $CBDD, mode in $CBDE
18BF ReadJoypad         ; standard d-pad/button matrix read
349B display_off       ; GBDK display_off: wait VBL (rLY), clear rLCDC bit7 (byte-exact match)
34B2 OamDmaRoutine      ; OAM DMA (source $DD00); copied to HRAM and called there
3154 SetOamByte         ; write byte (sp+6) to wOamBuf+offset(sp+4) only if changed; set wOamDirty (-> OAM DMA next frame)
; marker/cursor sprite field setters (sprite group at OAM byte $0C+; offset = index*4 + field), used by every editor screen's draw code
31E3 SetSpriteY         ; OAM Y of sprite (arg) = row*8 + $20, clamped to $FC when off-screen
31B5 SetSpriteX         ; OAM X of sprite (arg) = col*8 + $08
319E ClearSpriteY       ; OAM Y of sprite (arg) = 0 (move off-screen / hide)
321C SetSpriteTile3     ; OAM tile of sprite (arg) = $03
3233 SetSpriteTile4     ; OAM tile of sprite (arg) = $04
324A SetSpriteAttr      ; OAM attr of sprite (arg) = value (arg2)
3176 PositionWavSprites ; set OAM Y=$68 for sprites 0,1,2 -- the WAV channel's on-screen wave display (right edge, tiles $00-$02); only when the WAV channel is active (ResetScreenSprites)
30DD ClearSprites012    ; zero OAM Y of sprites 0,1,2 (wOamBuf +0/+4/+8)
30EC ClearMarkerSprites ; hide the marker sprites 3-10 (Y and attr = 0) and the cursor sprites 11-18 (X = 0); set wOamDirty
1500 ReadSongBytes      ; bulk copy from SRAM (bank, src) into a RAM dest buffer (e.g. a chain row)
3A33 ResetWorkState     ; reset all runtime state to defaults: per-channel sequencer ptrs (read ptr=$0140, rows=$FF, instr/table/groove=0) + editor cursors + wCurScreen=SONG; e.g. when a song load comes back empty
14D1 ReadSongByte       ; (bank,addr): di, select SRAM bank + enable RAM, read [de], reti
14EB ReadSongByteRaw    ; like ReadSongByte but no di/reti (caller already holds IRQ off)
158C WaitInterrupt     ; halt;nop;ret -- wait for the next interrupt (frame sync)
1799 CallHL             ; `jp hl` trampoline (gbz80 has no `call hl`); FarCall uses it to call the target in hl
179A FarCall            ; banked call: caller pushes (addr, bank); switch ROM bank, call addr, restore
17BB FarCallArg         ; like FarCall but also passes one byte argument to the callee
1574 WriteSongByte      ; (bank,addr,val): select SRAM bank + enable RAM, write [de] (write side of ReadSongByte)
; --- screen-drawing helpers (VRAM cursor $C574/$C575, string src $C564/$C565) ---
24DD RedrawScreen       ; full redraw of the current screen: ResetScreenSprites, clear tilemap (CGB), then per-screen draw passes across banks (1 $6CD7, 5 $4040, ...) by wCurScreen
24A8 ResetScreenSprites ; before a redraw: clear marker sprites (ClearSprites012 + ClearMarkerSprites), or position sprites 0/1/2 (PositionWavSprites) when the WAV channel is active
0DBC ShowMessage        ; copy the string arg into wStrBuf and trigger the on-screen message/popup (bank1 $74F7 sets wMessageStrPtr -> wStrBuf); 47 callers
2EAD DrawTileRun        ; draw a run of `count` UI tiles at (col,row): type 0 = cursor arrow (tile $03), 1 = blank (tile $48), else solid block (tile $8D)
2F68 DrawStringTile20   ; DrawStringIndexed entry with offset $20: draw the tile at wStringSrc+$20 to the VRAM cursor
2F21 DrawString         ; draw a NUL/len string to the VRAM tilemap cursor
2F6A DrawStringIndexed  ; draw from the string source at a byte offset
2E33 DrawHexByte        ; draw byte A as two hex digits at the cursor
2E6D DrawByte           ; draw a byte (stack arg) at the cursor
352A printn                     ; GBDK libc/printf.c's _printn: a word in a base at the console cursor, a minus first when signed
35B1 DigitChars                 ; "0123456789ABCDEF" (printn's digit table, indexed by the digit value)
35C2 printf                     ; GBDK libc/printf.c printf at the console cursor: %c, %u, %d, %x (via printn), %s
1298 ColorField                 ; color a field of w tiles at (x, y) with palette pal: CGB attributes through wAttrRowBuf, a DrawTileRun on DMG
17E1 AnyChanFlagSet     ; e = nonzero if any of the 4 per-channel bytes $C423-$C426 is set (chain-screen per-channel state; caller resets the $C68C idle counter on activity)
17FB ClearBgTilemap     ; fill the visible 20x18 BG tilemap ($9800) with tile 0, rSTAT-gated
; --- dynamic VRAM tile loader: queue of tile-graphics load requests ($CBE6 table, $CBE4 slot counter) ---
32E3 LoadTilesToVram    ; LCD off: register a tile-graphics source (de) in a free $CBE6 slot, alloc VRAM tile slots ($CBE4), load via CopyTileData, restore LCD
3370 SetTileLoadReq     ; store a 3-byte tile-load request from [hl]: $CBE1 slot/flags, $CBE2:3 source pointer
332B CopyTileData       ; copy a queued tile's 16-byte graphics to VRAM tile data ($9000 + $CBE1*16), rSTAT-gated (falls into the $32AD copy loop)
33D5 ReinitDisplay      ; ensure LCD on with standard rLCDC config (cycle off via display_off if needed; BG on, $9800 map, $8800 tiles) + ResetTileLoader
33EC ResetTileLoader    ; reset tile-loader state: clear $CBF7/$CBF8, set wTileLoadNow=2 (immediate-copy mode)
39CD set_bkg_tiles      ; GBDK set_bkg_tiles(x, y, w, h, tiles) (set_bk_t.s, byte-exact): unpack the stack args -> set_xy_btt
39F2 set_xy_btt         ; GBDK .set_xy_btt (set_xy_t.s): BG map base from rLCDC bit3 ($9800/$9C00), then set_xy_tt
; --- defensive checks ---
0953 WriteInstrByte     ; write value (sp+8, <4) to instruments[instr][field]: bank1 $B080 + instr*$10 + field
0A91 ReadInstrByte      ; read instruments[instr][field]: SRAM bank1 $B080 + instr*$10 + field (asserts instr<$40, field<$10)
0AE2 ReadCurInstrByte   ; ReadInstrByte([$C576] current instrument, field)
0AF6 ReadSeqByte        ; read song sequence song[step][channel]: bank0 $B290 + step*4 + channel (step<$C0, channel<4)
2141 ReadChainByte      ; read chain[chain(sp+6)][field(sp+7)] from SRAM $A080 + chain*32 + field (via ReadSongByteRaw)
1478 KitIndexToBank     ; map a kit index to its physical ROM bank: +8 (kits start at bank $08), +5 more if >= $1B to skip the code banks $1B-$1F
0D4C ReadKitName        ; copy the 6-char kit name (kit bank $4052, via KitIndexToBank) into wSampleNoteString
; SDCC banked-call thunk family (bc-addr style: save bank, switch, jp hl, restore),
; one per (arg-count, return-type). The sp-addr style lives at FarCall/FarCallArg.
0BFE FarCallByte        ; call a function in another ROM bank, returning its byte (e)
0C29 FarCallArgByte     ; call fn(arg) in another ROM bank, returning its byte (e)
0C5A FarCallArg2V       ; call fn(a, b) in another ROM bank
0C8F FarCallArg2        ; call fn(a, b) in another ROM bank, returning its byte (e)
0CC5 FarCallArg3        ; call fn(a, b, c) in another ROM bank
0CFE KitExists          ; (kit index) -> e=1 if a kit is present at KitIndexToBank(index): switch to that bank, check [$4000:01]==$6040 (was mislabeled FarCallByteAlt -- it reads $4000, not a FarCall)
2106 ReadSeqByteRaw     ; ReadSeqByte via ReadSongByteRaw (bank0 $B290)
1482 DebugTrap          ; assert/debug trap (ld b,b BGB marker + rst $38), fires once via $C7AF

; --- Sound engine: per-channel pitch slide / vibrato / frequency (TimerHandler tick) ---
0762 LoadWaveRam        ; fast-copy the 16-byte staged waveform (hWavUploadBuf $FFA0) into WAV wave RAM ($FF30) with rAUD3 off (SP-pop trick), then re-enable + retrigger rAUD3 and restore freq
066D SndModWavFreq      ; WAV ch direct-frequency modulation: wChanFreq+4 += wChanPitchRate+4; if vibrato active apply wChanVibOffset+4 (steps WAV vib via SndApplyWavVib, then halved offset)
1AFF SndApplyWavVib ; apply WAV-channel vibrato: if wChanVibSpeed+5, compute offset (SndCalcVibOffset) -> wChanVibOffset+4/5 and advance vib phase $C30C; shared by SndStepPitchVibWav + SndModWavFreq
1815 TickWorkTimeClock   ; bump saturating counter $C9AA (<$80), advance wWorkTimeAccum ($C69D); wrap at $0E00 -> wWorkTimeTicks ($C577), clear $C68B
20DB HandleTooBusy       ; CPU-overload handler (redraw backlog overflowed while playing): reset playback (bank2 $710E: exit live mode + sound reinit) and ShowMessage "TOO BUSY!"
1986 SndCalcVibOffset    ; eval vibrato/mod waveform: (phase>>2)+e indexes ctrl table $0200; bit7 -> negate; dispatch via $0300 -> signed offset in hl
19A1 SndCalcVibOffsetNeg ; SndCalcVibOffset bit7-set helper: complement A then dispatch via $0300
19A6 SndStepPitchVibPu1  ; ch0: accumulate wChanPitchRate->wChanPitchCur, clamp to wChanPitchTarget (-> SndUpdatePitchModFlagPu1); advance vib phase $C308 -> wChanVibOffset
1A26 SndStepPitchVibPu2  ; ch1: as PU1 for +2/+3 offsets (-> SndUpdatePitchModFlagPu2); vib phase $C30A -> wChanVibOffset+2
1AA7 SndStepPitchVibWav  ; ch2: as PU1 for +4/+5 offsets (-> SndUpdatePitchModFlagWav); vib phase $C30C -> wChanVibOffset+4
1CBA SndStepPitchVibNoi  ; ch3 (noise): vibrato via SndCalcVibOffset then >>5 scale; advance vib phase $C30E (no period table)
1B28 SndInterpPeriod     ; note(d)+frac(e) -> 16-bit period(de) from table at wChanPeriodTablePtr(bc), fractional interpolation; octave-wrap special cases ($6C/$B6/$F8/$FF)
1BA7 SndWriteFreqPu1     ; ch0: wChanOutNote+transpose[$C174]+finetune+vib+pitch -> SndInterpPeriod -> wChanFreq + rAUD1LOW/HIGH/LEN
1BF6 SndWriteFreqPu2     ; ch1: like PU1 -> wChanFreq+2 + rAUD2LOW/HIGH/LEN
1C3D SndWriteFreqWav     ; ch2: like PU1 -> wChanFreq+4 + rAUD3LOW/HIGH (rAUD3LEN=0)
1C7C SndUpdatePitchModFlagCur ; dispatch by hSoundChan -> SndUpdatePitchModFlag{PU1 (ch0),PU2 (ch1),Wav (>=2)}
1C84 SndUpdatePitchModFlagWav ; ch2: $C3FB = (wChanPitchRate+4|+5 | wChanVibSpeed+5)!=0, skipped if wChanVibShape+2 set
1C96 SndUpdatePitchModFlagPu2 ; ch1: $C3FA = (wChanPitchRate+2|+3 | wChanVibSpeed+3)!=0, skipped if wChanVibShape+1 set
1CA8 SndUpdatePitchModFlagPu1 ; ch0: $C3F9 = (wChanPitchRate+0|+1 | wChanVibSpeed+1)!=0, skipped if wChanVibShape set

; --- Sound: software envelope (DMG "zombie mode" volume via NRx2 rewrites) ---
2FC3 FadeEnvStep      ; step volume at [hl] one unit toward target a; equal->ret; up->NRx2 ([c])=$08; down->FadeEnvStepDown
2F9A FadeEnvStepDown  ; volume-decrease path: dec level, rewrite NRx2 ([c]) with $09/$11/$18; near level $0E wait for rDIV phase (anti-click), CGB vs DMG
2FCC UpdateEnvPu1     ; per-tick PU1 software envelope: FadeEnvStep wChanEnv toward target [$CBC2] via rAUD1ENV, then advance env stage
2FE2 UpdateEnvPu2     ; per-tick PU2 software envelope: wChanEnv+1 toward [$CBC9] via rAUD2ENV
2FF8 UpdateEnvNoi     ; per-tick NOI software envelope: wChanEnv+3 toward [$CBD0] via rAUD4ENV

; --- Link cable sync (see docs/sync.md) ---
1E93 DispatchSyncClock   ; per sync tick: reset wSyncTick=$FF; if playing, dispatch by wSyncMode (1=LSDJ->SyncTickLsdj, 3=MIDI->SyncTickMidi); preserves ROM bank
1D29 SyncStartTransport  ; on play-start (LSDJ/MIDI): if LSDJ idle (wSyncTick=$FF) become leader (wSyncRun=1, SyncSetSendMode) else send handshake
1D6C SyncStopTransport   ; on play-stop: LSDJ/MIDI -> reset wSyncRun/Tick/Handshake + SyncSetRecvMode; AN.OUT (7) -> $CB68=3
1D9D SyncTickLsdj        ; LSDJ sync tick: in live mode reset per-channel play state + redraw SONG row indicators (bank2 $5F5E); else copy wCurScreen->wPlayMode (bank2 $7C4C)
1E75 SyncTickMidi        ; MIDI sync tick: if live mode -> SyncTickLsdj, else advance playback twice (bank2 $7C4C)
1EC8 SyncSetSendMode     ; send/leader config: wSyncSendGate=1, $CB6D=0, enable VBlank IRQ + disable serial-receive IRQ
1EE3 SyncSetRecvMode     ; receive/follower config: wSyncSendGate=0, $CB6D=8, enable serial-receive IRQ, wSyncTick=$FF, SendSyncHandshake
1F06 SyncApplyMode       ; (re)configure sync for wSyncMode: di, wSyncRun=0, dispatch 0/1/3/5/6/7 -> SyncSetSendMode/SyncSetRecvMode/gates/handshake
01AA SerialInit         ; boot: arm rSC=$80 (slave), preload rSB=$66
14B9 SerialHandlerTail  ; serial IRQ tail: sync bookkeeping -> TimerHandlerReturn
3467 SendSyncByte       ; master: $CBDE=1, send $CBDC, rSC=$81 (internal clock)
347A SendSyncHandshake  ; master: $CBDE=2, send $55, rSC=$80
234D ProcessSyncByte    ; consume received $CBDD: <$FD position / >=$FD transport
227C SendByteStep       ; one step of the multi-byte (MIDI) send loop
1F9A SyncSendAnalogClock ; AN.OUT mode: emit clock pulse byte ($FF/$00 by $CB68 ticks/step, reloaded from wSyncMode2) via SendSyncByte
23CA SyncReceiveAnalogClock ; AN.IN mode (wSyncSendGate>=2): process the incoming clock pulse byte (rSB), counting via $CB77-79 to advance the sequencer
217C SyncSeekSongPos    ; (non-live) seek the song playback position to the received sync position (LSDJ $CB71 / else $CB6A): per channel, scan the song sequence (ReadSeqByteRaw) following chain links
34F0 GetTileLoadNow     ; e = wTileLoadNow ($CBDB tile-loader flag); unused (dead code; was mislabeled GetSyncPosition)
34F5 EnableInterrupts   ; ei; ret
34F7 DisableInterrupts  ; di; ret
34F9 SoftReset          ; a = boot id [$CBD9]; jp Start
34FF SetInterruptEnable ; update rIE, ack rIF for newly-enabled interrupts
3424 SwitchToDoubleSpeed ; CGB KEY1 speed switch to double-speed (no-op if rSPD bit7 already set): disable IRQs, rJOYP=$30, rSPD=1, stop, restore rIE
20B3 ChecksumRomBank    ; 16-bit sum of all bytes in the current ROM bank ($4000-$7FFF) -> de
20C4 TestSram           ; write/read-back test of SRAM bank $A000-$BFFF (writes 0); e = end offset on success / high byte on failure
343F abs                        ; GBDK libc/abs.c: the absolute value of a signed word
33B9 SetVramCursor              ; point wVramCursor at BG map cell (x, y): $9800 + y*32 + x (the next DrawString/DrawHexByte draws there)
3831 strcpy            ; GBDK/SDCC strcpy(dest=sp+2, src=sp+4): copy until NUL (byte-exact match)
3843 memcpy            ; SDCC memcpy(dest=sp+4, src=sp+6, n=sp+8): copy n bytes (16-bit count)
3863 StrCompare                     ; SDCC strcmp (rgbasm reserves STRCMP): s1=sp+2, s2=sp+4, byte compare -> de = 0 (equal) / +1 / -1
391B joypad            ; GBDK joypad(): read P1 d-pad (P14) + buttons (P15) matrix -> combined active-high byte in e
3983 delay             ; GBDK delay(d): 16-bit count from stack -> DelayTicks
3949 DelayTicks        ; busy-wait de units (DelayLoop) plus a fixed tail loop (delay impl)
3966 DelayLoop         ; calibrated inner busy-wait: decrement de to 0 (jr+0 cycle-padding chain)
3887 MemSetLoop        ; inner loop: fill de bytes at hl with value b
38D8 set_bkg_palette    ; GBDK: write CGB BG palettes (first,nb,rgb_data) via rBGPI/rBGPD
388F MemSet            ; memset(dest=sp+4, value=sp+6, count=sp+7) -> MemSetLoop
38A2 MulU8              ; SDCC runtime: 8-bit multiply (reads 2 byte args -> MulCharToInt)
38AE MulU16             ; SDCC runtime: 16-bit multiply (reads 2 word args -> MulInt)
38BF MulCharToInt      ; zero-extend 8-bit operands (b=0,d=0) then fall into MulInt
38C2 MulInt            ; core 16x16->16 shift-and-add multiply (hl = bc * de)

; --- SDCC runtime: 8/16-bit signed+unsigned division & modulo (Div does the ---
; --- quotient move; Mod returns the remainder; both share a restoring core) ---
3715 DivS8       ; signed 8-bit divide -> quotient in e (DivModS8 then move c->e)
3721 ModS8       ; signed 8-bit modulo -> remainder in e (DivModS8)
372C DivS16      ; signed 16-bit divide -> quotient in de (DivModS16 then bc->de)
373D ModS16      ; signed 16-bit modulo -> remainder in de (DivModS16)
374C DivU8       ; unsigned 8-bit divide -> quotient in e (DivModU8 then move c->e)
3758 ModU8       ; unsigned 8-bit modulo -> remainder in e (DivModU8)
3763 DivU16      ; unsigned 16-bit divide -> quotient in de (DivModU16 then bc->de)
3774 ModU16      ; unsigned 16-bit modulo -> remainder in de (DivModU16)
3783 DivModS8    ; sign-extend 8-bit operands (c->bc, e->de), fall into DivModS16
378B DivModS16   ; signed divide core: save/apply operand signs, DivModU16, restore quotient & remainder signs
37C1 DivModU8    ; zero-extend 8-bit operands (b=0,d=0), fall into DivModU16
37C4 DivModU16   ; unsigned divide core: dividend bc / divisor de -> quotient bc, remainder de; div-by-zero -> 0 + carry; 16x DivStep
380F DivStep     ; one restoring-division shift/subtract bit-step (called 16x by DivModU16)

; --- indirect (FarCall) targets, resolved by tools/farcall_targets.py ---
24DD RedrawScreen ; full screen repaint: ResetScreenSprites, ClearBgTilemap (CGB), then dispatch per-screen draw handlers by wCurScreen (18+ FarCall sites)
39E1 set_xy_wtt         ; GBDK .set_xy_wtt (set_xy_t.s): window map base from rLCDC bit6 ($9800/$9C00), then set_xy_tt
1FD5 CheckRomChecksum ; sum ROM bytes vs header global checksum ($014E/$014F) -- SRAM/boot self-test path
154B ReadSongByteDi ; di + SRAM enable + bank select + read + reti (unreferenced variant of ReadSongByte)
34E9 SendSyncHandshakeByte ; alt-entry into SendSyncHandshake with hl=arg (unreferenced)
1E70 TxtBlank4 ; "    " 4-space blank field string
014E HeaderChecksumHi           ; ROM header global checksum (hi byte), read by CheckRomChecksum
014F HeaderChecksumLo           ; ROM header global checksum (lo byte)
300F ExpoCurve16                ; 16-entry exponential curve $00..$73: envelope speed -> frame count
086F AsciiCharMap               ; [89] character-to-tile map from space onward; text draws set wStringSrc to this address minus $20
08C8 IdentityCharMap            ; identity tile-index map (loaded into wStringSrc for raw-tile draws)
01E0 SyncModeStubs              ; 4 x 4-byte jp-hl slots from SendSyncHandshake ((mode&3)*4); only slot 0 (ret) populated
0200 TimesTwoTable              ; [n] -> 2n byte ramp (FileUpgradeRemapBits, synth draw)
0255 SignedRampTable            ; signed ramp -12..+15 (modulation LUT block; read by LoadHwTables)

; --- vector page ($0000-$0068): Emulicious segments the RST/interrupt slots
; and creates _DATA_ labels for every data run/accessed offset, ignoring
; symbol+offset -- so every non-code byte gets its own symbol. ---
0011 BitMaskBit6         ; bit mask $40 (BitMasks descending set)
0012 BitMaskBit5         ; bit mask $20 (BitMasks descending set)
0013 BitMaskBit4         ; bit mask $10 (BitMasks descending set)
0014 BitMaskBit3         ; bit mask $08 (BitMasks descending set)
0015 BitMaskBit2         ; bit mask $04 (BitMasks descending set)
0016 BitMaskBit1         ; bit mask $02 (BitMasks descending set)
0017 BitMaskBit0         ; bit mask $01 (BitMasks descending set)
0018 BitMasksAsc         ; ascending bit masks: [$0018+n] = 1<<n (this byte: bit 0)
0019 BitMaskAsc1         ; bit mask $02 (ascending set)
001A BitMaskAsc2         ; bit mask $04 (ascending set)
001B BitMaskAsc3         ; bit mask $08 (ascending set)
001C BitMaskAsc4         ; bit mask $10 (ascending set)
001D BitMaskAsc5         ; bit mask $20 (ascending set)
001E BitMaskAsc6         ; bit mask $40 (ascending set)
001F BitMaskAsc7         ; bit mask $80 (ascending set)
