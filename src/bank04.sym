; --- Phrase-screen clipboard strings (db) ---
548B TxtPaste04         ; "PASTE"
55D1 TxtCannotClone             ; "CANNOT CLONE"
571F TxtClonedTable04   ; "CLONED TABLE"
7D49 TxtCancelSelect04  ; "CANCEL SELECT"
; ($54E3 all-$01 table -- left unnamed pending RE of its indexing)

; Bank $04 -- Phrase screen. phrase[wPhrase][16] in 4 SRAM columns: notes $A000
; (bank0), instr $B000 (bank3), fx $A000 (bank2), fx_val $AFF0 (bank2).
4968 PhraseReadNote             ; read phrase_notes[wPhrase][row] (SRAM bank 0 $A000); asserts row < $10, wPhrase != $FF
4C14 LoadPhraseRow        ; load the 4 phrase columns for phrase[wPhrase] into row buffers
4CE5 DrawPhraseScreen     ; screen idx 1: the phrase grid (note or kit samples, instrument, command, value per step), its CGB row attributes, cursor and channel status
4000 DrawNoteNameFar            ; FarCall bank 6 DrawNoteName(wSongCol, x): the phrase screen's note column
5533 CloneInstrAtCursor         ; clone the instrument under the cursor: alloc+CloneInstr; fail -> "CANNOT CLONE"

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
401B DrawPhraseCursorFar        ; FarCall bank1f DrawPhraseCursor
402C DrawPhraseCmdLetter        ; draw FX command letter cmd (FxMnemonics), "?" past $13
405D PhraseModeTile             ; return tile $78 or $6c depending on mode wSongCol
4071 ReadCursorInstr            ; ReadPhraseInstr(wPhrase, wPhraseRow)
4087 FindCursorInstr            ; the instrument in effect at the cursor: the nearest step at or above wPhraseRow with one (<= $40), else $FF
40B2 PhraseResolveCursorNote    ; remember v as wPhraseColLast[wSongCol]; in column 3 (not selecting) also write it to field 4 of a type-3 instrument in effect
4106 SetColInstr           ; cache the last-used instrument per channel column (wColInstr+wSongCol; WAV specials)
418F WritePhraseNote            ; write phrase_notes[wPhrase][row] = v (SRAM bank 0 $A000); asserts row < $10, wPhrase != $FF
41F0 WritePhraseInstr      ; write phrase_instruments[phrase][row] = instr (SRAM bank 3 $B000); asserts instr <= $40 or $FF
4257 PhraseDrawCursorGlyph      ; pick glyph data ($429e/$42a3 by wPhraseDrawMode) + col wPhraseCol, then SetVramCursor
42A8 PhraseInstrEntered         ; after instrument entry: WritePhraseInstr, update wColInstr, redraw
43CD PhraseEditUp               ; A+UP edit on the cursor cell (note: +octave; hex fields: +$10)
457C PhraseEditDown             ; A+DOWN edit on the cursor cell (-octave / -$10)
470B PhraseEditRight            ; A+RIGHT edit on the cursor cell (+semitone / +1)
4811 PhraseEditLeft             ; A+LEFT edit on the cursor cell (-semitone / -1)
4918 ReadPhraseInstr            ; read phrase_instruments[phrase][row] (SRAM bank 3 $B000); asserts phrase != $FF, row < $10
49C5 WritePhraseFx              ; write phrase_fx[phrase][row] = cmd (SRAM bank 2 $A000); asserts cmd <= $13
4A30 WritePhraseFxVal           ; write phrase_fx_val[phrase][row] = v (SRAM bank 2 $AFF0); asserts phrase != $FF, row < $10
4A8F PhraseReadFxVal            ; read phrase_fx_val[phrase][row] (SRAM bank 2 $AFF0); asserts phrase != $FF, row < $10
4AEA PhraseReadFx               ; read phrase_fx[phrase][row] (SRAM bank 2 $A000); 0 unless a command (<= $13)
4B5B PhraseEditPlace            ; plain-A: place/repeat a value into the empty cursor cell
4C06 DrawEmptyNote              ; draw "---" empty note cell
4C99 DrawPhraseSelectionFar    ; FarCall bank1f DrawPhraseSelection
4CAA PhraseCheckColFD           ; return wPhraseRowFlags[arg] > $FD (a $FE/$FF sentinel)
4CC4 DrawNoteCell               ; draw wSampleNoteString (note name) or "OFF"
510A CursorInstrIsKit           ; 1 if the instrument in effect at the cursor (FindCursorInstr) is a kit
5136 PhraseCheckEditContext     ; predicate over mode wSongCol / col wPhraseCol / wSelectionLeft / CursorInstrIsKit
51AE PastePhraseSelection       ; paste the clipboard (wClipboardType) into the phrase: for rows wSelectionTop..wSelBottom and columns wSelectionRight-1 down to wSelectionLeft, each cell by column (kit notes merged nibble-wise, instrument, command, value); a 3-wide table-command selection (wClipboardType 5) shifts its command pair by -1/+1; PASTE message for multi-row pastes
5491 CloneInstr            ; copy instrument src to dst: its 16 bytes, then its name (CopyInstrName / WriteInstrName)
55EB CloneTableAtCursor         ; clone the table referenced by the cmd value under the cursor (FindFreeTable+CopyTableData)
567D PhraseCursorOnEditCell     ; return 1 if cursor is on the active cmd cell (wPhraseRow==wSelectionTop and wPhraseCol==wSelectionLeft)
56BA PhraseCloneTableCmd        ; command action handler incl. cloning a table ("CLONED TABLE" message)
572C PrelistenCursorRow         ; play the note/instr under the cursor while editing (wPrelisten gate)
58D9 PhraseCellFlagA       ; phrase-cell predicate OR-ed in PrelistenEditedCell: note<$40 & instrument type==2 (kit) test
597D PhraseCellFlagB       ; phrase-cell predicate OR-ed in PrelistenEditedCell (inc-row variant)
5A20 PhraseCellFlagC       ; phrase-cell predicate OR-ed in PrelistenEditedCell (note<$10 / $f0-offset variant)
5AC7 PhraseCellFlagD       ; phrase-cell predicate OR-ed in PrelistenEditedCell ($30/$10-offset, adjacent-compare variant)
5B5E PrelistenEditedCell        ; preview the just-edited cell (kit instruments special-cased)
; --- functions called from bank 0 (this bank paged in) ---
5BA6 PhraseScreenInput          ; phrase screen (1) input handler, from DispatchScreenInput: dispatch on wButtons
55DE TxtClonedInstr    ; "CLONED INSTR"
7D57 TxtSelect04       ; "SELECT" (pairs with TxtCancelSelect04)

; --- phrase-screen render/edit tables ---
50D8 PhraseRowAttrs0    ; [13] CGB BG attributes of a kit row (PhraseCheckColFD false); DrawPhraseScreen's const data
50E5 PhraseRowAttrs1    ; [13] CGB BG attributes of a non-kit row on a kit phrase
50F2 PhraseRowAttrs2    ; [13] CGB BG attributes of a row on a phrase without kits
50FF TxtPhraseBlank3    ; "   " (DrawPhraseScreen: the note column's padding on kit phrases)
5103 TxtPhraseNoInstr   ; "--" (no instrument)
5106 TxtPhraseBlank3b   ; "   " (the value column's padding without kits)
54E3 PhraseStepOnes     ; [80] constant $01 table read by the four phrase edit handlers (per-index step/enable)
57C0 FxPrelistenFlags           ; [20] 1 per FX command (FxMnemonics order) whose value edit re-plays the note (PhraseScreenInput -> PrelistenCursorRow, which checks PRELISTEN): A C E F K M O P R S V W, the ones that change the sound; not - B D G H L T Z
57D4 DrawInstrName      ; FarCall bank1 CopyInstrName(instr) -> wSampleNoteString, draw the 5-char name
4C10 TxtNoteEmpty               ; "---"
4CE1 TxtNoteOff                 ; "OFF"

