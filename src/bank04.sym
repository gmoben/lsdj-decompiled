; --- Phrase-screen clipboard strings (db) ---
548B TxtPaste04         ; "PASTE"
55D1 TxtCannotClone     ; "CANNOT CLONE"
571F TxtClonedTable04   ; "CLONED TABLE"
7D49 TxtCancelSelect04  ; "CANCEL SELECT"
50D8 PhraseAttrHighlight ; CGB tile-attribute row (CopyToBgTilemap -> VRAM bank1) highlighting phrase columns; one of a group ($50D8/$50E5/$50F2)
; ($54E3 all-$01 table -- left unnamed pending RE of its indexing)

; Bank $04 -- Phrase screen. phrase[wPhrase][16] in 4 SRAM columns: notes $A000
; (bank0), instr $B000 (bank3), fx $A000 (bank2), fx_val $AFF0 (bank2).
4968 PhraseStepPtr      ; -> $A000 + step (phrase row base pre-selected in SRAM; step<16); phrase-editor cell helper
4C14 LoadPhraseRow        ; load the 4 phrase columns for phrase[wPhrase] into row buffers
4CE5 DrawPhraseScreen     ; screen idx 1: draws the phrase note/instr/cmd/val grid
4000 PhraseBanked_4000      ; banked-call wrapper (5x)
5533 PhraseBanked_5533      ; banked-call wrapper (1x)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
401B PhraseBanked_401B          ; banked-call wrapper
402C PhraseDrawStr_402C         ; calls DrawStringIndexed
405D PhraseModeTile             ; return tile $78 or $6c depending on mode $c41d
4071 PhraseReadCmdValCursor     ; read phrase cmd-value at cursor row $c416 (PhrasePhraseCmdVal_4918, wPhrase)
4087 PhraseFindNoteFromCursor   ; scan up from row $c416 for first cmd-value <= $40; return it or $ff
40B2 PhraseInstrWrite_40B2      ; calls WriteInstrByte
4106 PhraseSongWrite_4106       ; calls WriteSongByte
418F PhraseSongWrite_418F       ; calls WriteSongByte
41F0 PhraseSongWrite_41F0       ; calls WriteSongByte
4257 PhraseDrawCursorGlyph      ; pick glyph data ($429e/$42a3 by $c90c) + col $c415, then GetTilemapAddr
42A8 PhraseBanked_42A8          ; banked-call wrapper
43CD PhraseSongWrite_43CD       ; calls WriteSongByte
457C PhraseSongWrite_457C       ; calls WriteSongByte
470B PhraseSongWrite_470B       ; calls WriteSongByte
4811 PhraseSongWrite_4811       ; calls WriteSongByte
4918 PhraseReadCmdVal      ; read the phrase command-value cell (phrase arg, row arg); bounds-checked
49C5 PhraseSongWrite_49C5       ; calls WriteSongByte
4A30 PhraseSongWrite_4A30       ; calls WriteSongByte
4A8F PhraseReadCmdSram          ; read phrase_cmd_val[phrase*16+row] from SRAM ($AFF0, ReadSongByte bank2); bounds-checked
4AEA PhraseReadNoteSram         ; read phrase_notes[phrase*16+row] from SRAM ($A000, ReadSongByte bank2); bounds-checked
4B5B PhraseSongWrite_4B5B       ; calls WriteSongByte
4C06 PhraseDrawStr_4C06         ; calls DrawString
4C99 PhraseBanked_4C99          ; banked-call wrapper
4CAA PhraseCheckColFD           ; return whether [$c90d + arg] == $fd
4CC4 PhraseDrawStr_4CC4         ; calls DrawString
510A PhraseCurNoteIsKit         ; find note (PhraseFindNoteFromCursor); return 1 if its instrument type (ReadInstrByte)==2
5136 PhraseCheckEditContext     ; predicate over mode $c41d / col $c415 / wCursorX / PhraseCurNoteIsKit
51AE PhraseHandleInput          ; main phrase-screen cursor/edit handler ($c411 mode, wCursorX/Y); large
5491 PhraseInstrWrite_5491      ; calls WriteInstrByte
55EB PhraseBanked_55EB          ; banked-call wrapper
567D PhraseCursorOnEditCell     ; return 1 if cursor is on the active cmd cell ($c416==$c40e and $c415==wCursorX)
56BA PhraseCloneTableCmd        ; command action handler incl. cloning a table ("CLONED TABLE" message)
572C PhraseDrawHex_572C         ; calls DrawHexByte
58D9 PhraseCellFlagA       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E: note<$40 & instrument type==2 (kit) test
597D PhraseCellFlagB       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E (inc-row variant)
5A20 PhraseCellFlagC       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E (note<$10 / $f0-offset variant)
5AC7 PhraseCellFlagD       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E ($30/$10-offset, adjacent-compare variant)
5B5E PhraseDrawHex_5B5E         ; calls DrawHexByte