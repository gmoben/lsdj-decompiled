; --- Phrase-screen clipboard strings (db) ---
548B TxtPaste04         ; "PASTE"
55D1 TxtCannotClone             ; "CANNOT CLONE"
571F TxtClonedTable04   ; "CLONED TABLE"
7D49 TxtCancelSelect04  ; "CANCEL SELECT"
50D8 PhraseAttrHighlight ; CGB tile-attribute row (CopyToBgTilemap -> VRAM bank1) highlighting phrase columns; one of a group ($50D8/$50E5/$50F2)
; ($54E3 all-$01 table -- left unnamed pending RE of its indexing)

; Bank $04 -- Phrase screen. phrase[wPhrase][16] in 4 SRAM columns: notes $A000
; (bank0), instr $B000 (bank3), fx $A000 (bank2), fx_val $AFF0 (bank2).
4968 PhraseStepPtr      ; -> $A000 + step (phrase row base pre-selected in SRAM; step<16); phrase-editor cell helper
4C14 LoadPhraseRow        ; load the 4 phrase columns for phrase[wPhrase] into row buffers
4CE5 DrawPhraseScreen     ; screen idx 1: draws the phrase note/instr/cmd/val grid
4000 DrawChainCellFar           ; FarCall bank06 DrawChainCell(wSongCol, row) -- chain info cell on the phrase screen
5533 CloneInstrAtCursor         ; clone the instrument under the cursor: alloc+CopyInstrBytes; fail -> "CANNOT CLONE"

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
401B DrawPhraseCursorFar        ; FarCall bank1f DrawPhraseCursor
402C DrawPhraseTile             ; draw one indexed tile/char at the VRAM cursor (DrawStringIndexed wrapper)
405D PhraseModeTile             ; return tile $78 or $6c depending on mode $c41d
4071 PhraseReadCmdValCursor     ; read phrase cmd-value at cursor row $c416 (PhrasePhraseCmdVal_4918, wPhrase)
4087 PhraseFindNoteFromCursor   ; scan up from row $c416 for first cmd-value <= $40; return it or $ff
40B2 PhraseResolveCursorNote    ; resolve note+instrument under the cursor (PhraseFindNoteFromCursor; $40=none; select-mode aware)
4106 SetColInstrument           ; cache the last-used instrument per channel column (wColInstrument+wSongCol; WAV specials)
418F WritePhraseNote            ; phrase_notes[wPhrase*16+row] = value (row<16, wPhrase!=$ff asserted)
41F0 WritePhraseInstrument      ; phrase_instruments (song $7000) [phrase*16+row] = instr
4257 PhraseDrawCursorGlyph      ; pick glyph data ($429e/$42a3 by $c90c) + col $c415, then GetTilemapAddr
42A8 PhraseInstrEntered         ; after instrument entry: WritePhraseInstrument, update wColInstrument, redraw
43CD PhraseEditUp               ; A+UP edit on the cursor cell (note: +octave; hex fields: +$10)
457C PhraseEditDown             ; A+DOWN edit on the cursor cell (-octave / -$10)
470B PhraseEditRight            ; A+RIGHT edit on the cursor cell (+semitone / +1)
4811 PhraseEditLeft             ; A+LEFT edit on the cursor cell (-semitone / -1)
4918 PhraseReadCmdVal      ; read the phrase command-value cell (phrase arg, row arg); bounds-checked
49C5 WritePhraseNoteRaw         ; phrase-notes write at an explicit song offset ($0000 region)
4A30 WriteWorkRow               ; write byte n (n<16) of the song work/bookmarks row ($0FF0 = phrase $ff slot)
4A8F PhraseReadCmdSram          ; read phrase_cmd_val[phrase*16+row] from SRAM ($AFF0, ReadSongByte bank2); bounds-checked
4AEA PhraseReadNoteSram         ; read phrase_notes[phrase*16+row] from SRAM ($A000, ReadSongByte bank2); bounds-checked
4B5B PhraseEditPlace            ; plain-A: place/repeat a value into the empty cursor cell
4C06 DrawEmptyNote              ; draw "---" empty note cell
4C99 PastePhraseSelectionFar    ; FarCall bank1f PastePhraseSelection
4CAA PhraseCheckColFD           ; return whether [$c90d + arg] == $fd
4CC4 DrawNoteCell               ; draw wSampleNoteString (note name) or "OFF"
510A PhraseCurNoteIsKit         ; find note (PhraseFindNoteFromCursor); return 1 if its instrument type (ReadInstrByte)==2
5136 PhraseCheckEditContext     ; predicate over mode $c41d / col $c415 / wCursorX / PhraseCurNoteIsKit
51AE PhraseHandleInput          ; main phrase-screen cursor/edit handler ($c411 mode, wCursorX/Y); large
5491 CopyInstrBytes             ; copy 16 instrument bytes src->dst (+name/table FarCalls)
55EB CloneTableAtCursor         ; clone the table referenced by the cmd value under the cursor (FindFreeTable+CopyTableData)
567D PhraseCursorOnEditCell     ; return 1 if cursor is on the active cmd cell ($c416==$c40e and $c415==wCursorX)
56BA PhraseCloneTableCmd        ; command action handler incl. cloning a table ("CLONED TABLE" message)
572C PrelistenCursorRow         ; play the note/instr under the cursor while editing (wPrelisten gate)
58D9 PhraseCellFlagA       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E: note<$40 & instrument type==2 (kit) test
597D PhraseCellFlagB       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E (inc-row variant)
5A20 PhraseCellFlagC       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E (note<$10 / $f0-offset variant)
5AC7 PhraseCellFlagD       ; phrase-cell predicate OR-ed in PhraseDrawHex_5B5E ($30/$10-offset, adjacent-compare variant)
5B5E PrelistenEditedCell        ; preview the just-edited cell (kit instruments special-cased)
; --- functions called from bank 0 (this bank paged in) ---
5BA6 PhraseScreenEdit           ; phrase-screen edit dispatcher: A+dir ops, plain-A place, selection seeding (wSel* from cursor)
55DE TxtClonedInstr    ; "CLONED INSTR"
7D57 TxtSelect04       ; "SELECT" (pairs with TxtCancelSelect04)

; --- phrase-screen render/edit tables ---
50D8 PhraseRowAttrs0    ; 13-byte CGB BG-attribute row for phrase rows (variant 0; picked via PhraseCheckColFD)
50E5 PhraseRowAttrs1    ; 13-byte CGB BG-attribute row (variant 1)
50F2 PhraseRowAttrs2    ; 13-byte CGB BG-attribute row (variant 2; $c90c==0 path)
54E3 PhraseStepOnes     ; constant $01 table read by the four phrase edit handlers (per-index step/enable)
57D4 DrawInstrName      ; FarCall bank1 CopyInstrName(instr) -> wSampleNoteString, draw the 5-char name
4C10 TxtNoteEmpty               ; "---"
4CE1 TxtNoteOff                 ; "OFF"
