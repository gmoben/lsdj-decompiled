; Bank $1B symbol map -- Project / File / Help screens + UI text.
; See docs/editors.md and docs/sync.md. First-pass carve: the major string
; tables are marked as data in the disasm command; some embedded graphics/jump
; tables are still shown as code (byte-safe) and will be refined.

4A62 DrawHelpScreen   ; Help screen (idx 14): renders the help/command-list text
5C17 DrawProjectScreen ; Project screen draw: edits song-global properties at SRAM bank1 $BFB2+ (song offset $3FB2: tempo/transpose/sync/font/colorset/clone; see data_model.md)
58B1 DrawSyncField   ; Project SYNC field: read $CB66, draw mode string to VRAM $9885
59B7 SyncModeNames   ; sync-mode display names "OFF"/"LSDJ"/"MIDI"/... (7-byte stride)

; --- Project/File data tables + strings ---
4C6A AlnumChars      ; "0123456789ABCDEF..." digit/letter table (hex + filename display)
5117 TxtSaveAs       ; "SAVE AS:"/"NAME:" prompts
52D8 TxtSaving                  ; "SAVING..."
5C03 TxtClockLabels  ; "PLAY %d:"/"WORKED %d:" (total/work-time clock)
6A5C CloneModeNames2 ; "SLIM"/"DEEP" + "RESET CART..." (reset-cartridge menu)
6C38 ProjScreenGfx   ; 1152-byte tile/graphics block copied to WRAM $D000 by $6B88
5D4F CloneModeNames  ; clone-mode display names "DEEP"/"SLIM" (5-byte stride)
5B7A DrawSyncSubSetting ; draw PS/2 DELAY (KEYBD) or TICKS/STEP (analog) value beside SYNC
5126 CloseNameEditor            ; leave the name editor -> wNameReturnScreen (FILE flow shows "SAVING...")

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
401B DrawStringAtXY             ; GetTilemapAddr(x,y) + DrawString
49F8 ProjDrawHelpEntry          ; draw help-list line index $c934 (text via ROM tables $408E/$4058); palette by arg
4A4D ProjRedrawHelpSel          ; if $c933==0, redraw current help entry (<-DrawHelpScreen)
4A79 ProjHelpSelectNext         ; move help selection down: redraw old highlighted, inc $c934, redraw new normal
4AA6 ProjHelpSelectPrev         ; move help selection up: redraw old highlighted, dec $c934, redraw new normal
4AC5 GotoProjectScreen          ; wCurrentScreen=9 + RedrawScreen (FarCall home $24dd)
4ADB ProjHelpReset              ; $c933=0, refresh ($17fb), DrawHelpScreen
4AE7 DrawNameEditArrows         ; draw the name editor '<' '>' arrows at the letter position
4B6D ProjHelpOpenSelected       ; activate selected help entry $c934: set $c933, load its string via ProjDrawStr_4AE7
4C30 ProjDrawNameFieldHw        ; draw text field at $c42d/$c42e (palette per hGameboyType) via DrawTextField
4C96 ProjDrawNameField          ; draw text field at $c42d/$c42e (palette 0) via DrawTextField
4CBA DrawProjTextField          ; draw a project-screen text field (highlight-aware) at computed coords
5303 DrawNameEditCursor         ; letter-position highlight in the name editor (wKbdLetterPos, DrawTextField)
569C DrawFontColorFields        ; draw the FONT (wFont) and COLOR SET (wColorSet) project rows
5782 SaveSyncMode               ; wSyncMode -> song property $bfbd
5796 DrawSyncMode2Field         ; draw + persist wSyncMode2 (song property $bfbf)
57C1 ProjSyncStateFlag          ; predicate combining wSyncMode (1/3) and $cb6b
582C SaveTempoProps             ; wTempo -> $bfb4, wTempoMode -> $bfcc song properties
5853 ProjCommitVram             ; $2bc4 -> $2c3c (commit a queued VRAM write)
5861 ProjQueueVramWrite         ; spin until wRedrawPending<6, set wVramCursor=$9846, then ProjCommitVram
5876 DrawKeyRepeatField         ; draw the KEY DELAY/REPEAT values (wKeyDelay/wKeyRepeat)
5896 ProjSyncModeIs567          ; return 1 if wSyncMode in {5,6,7}
5952 DrawSyncModeField          ; draw the SYNC mode field (palettes + DrawTextField)
5A07 ProjCalcFieldTile          ; compute a field tile/value from index $c9a4 (ROM $5776) + flag $c9a3
5A42 ProjDrawSyncField          ; draw a project/sync field via ProjCalcFieldTile + DrawTextField (index $c9a4)
5A90 ProjDrawSyncFieldHw        ; like ProjDrawSyncField but palette per hGameboyType
5AE3 DrawDecimalField           ; draw a small decimal value ("%d" via DrawFormat)
5B09 ProjSyncModeIs015          ; return 1 if wSyncMode in {0,1,5}
5B23 DrawPrelistenField         ; PRELISTEN field: "ON "/"OFF"/"N/A" by wPrelisten + sync mode
5B62 ProjDrawSyncLabel          ; set wVramCursor=$992a, src $c566/$c567, then ProjDrawStr_5B23
5D7C ProjectScreenRefresh       ; drain buttons, clear tilemap, DrawProjectScreen + map row
6988 ApplySettingsAndRedraw     ; delay, LoadProjectSettings(0), clear, redraw frame -- 63 call sites
6A8C ProjScrollTextStep         ; marquee step: manage $c9aa/$c9ab state, shift 7-byte buffer $c9ac (via $3843)
70B8 GetInstrEnvBytes           ; read the instrument's envelope input bytes (x2 ReadCurInstrByte)
7200 ProjFillDaBuffer           ; append byte(s) into $DA00+ buffer up to index arg ($cbd8 cursor, <$40)
726E ComputeEnvelope            ; precompute envelope data for the current instrument (UpdateInstrEnvelope core)
74E4 UpdateEnvSprites           ; write the envelope OAM markers (SetOAMByte x2, 8-slot bound)
; --- functions called from bank 0 (this bank paged in) ---
6B7A LoadSongData       ; load the working song (called by InitAndLoadSong)
5DBF ProjectDrawField   ; project field draw ($c9a4)
53E8 ProjectHelper      ; project helper
4BC3 ProjectStateRead   ; read project state ($c933)

4E8A OpenNameEditor             ; save screen -> wNameReturnScreen, init letter input (wKbdLetterPos) for instr/file/word names
754F UpdateInstrEnvelope        ; envelope-bearing types only (PULSE/NOISE): recompute envelope data after instrument edit
5B06 TxtPctD1B                  ; "%d"
5B56 TxtOn1B                    ; "ON "
5B5A TxtOff1B                   ; "OFF"
5B5E TxtNA                      ; "N/A"
