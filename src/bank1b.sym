; Bank $1B symbol map -- Project / File / Help screens + UI text.
; See docs/editors.md and docs/sync.md. First-pass carve: the major string
; tables are marked as data in the disasm command; some embedded graphics/jump
; tables are still shown as code (byte-safe) and will be refined.

4000 MixerKernel                ; 27-byte asm kit mixer step (ldh a,[c] .. ldh [c],a), copied to WRAM by InitializeKitMixer; ends at DrawHelpMenu
4A62 DrawHelpScreen   ; Help screen (idx 14): renders the help/command-list text
5C17 DrawProjectScreen ; Project screen draw: edits song-global properties at SRAM bank1 $BFB2+ (song offset $3FB2: tempo/transpose/sync/font/colorset/clone; see data_model.md)
58B1 DrawSyncField   ; Project SYNC field ($58B1-$59B6): draw the wSyncMode name (TxtSyncOff..TxtSyncAnOut) at VRAM $9885, then at $98A0 either the sub-setting label (PS/2 DELAY / TICKS/STEP, ProjectSyncModeIs567) + wSyncMode2 in hex, or a blank; CGB attribute row via ColorField. Matched in C: c/bank1b/DrawSyncField.c
59B7 TxtSyncOff      ; "OFF   " sync-mode name (six consecutive 7-byte strings, each its own symbol: DrawSyncField pushes them as plain addresses)
59BE TxtSyncLsdj     ; "LSDJ  "

; --- Project/File data tables + strings ---
4C6A AlphanumericCharacters      ; "0123456789": the name keyboard, char [4][11] -- four NUL-terminated 10-key rows (OpenNameEditor draws it, NameEditorInput reads it)
5117 TxtSaveAs       ; "SAVE AS:"/"NAME:" prompts
52D8 TxtSaving                  ; "SAVING..."
5C03 TxtClockLabels  ; "PLAY %d:"/"WORKED %d:" (total/work-time clock)
6A5C CloneModeNames2 ; "SLIM", "DEEP": ProjectScreenInput's string literals (then the reset menu's)
6C38 KitMixTable                ; 1152-byte nibble-sum LUT copied to WRAM $d000 for the MixerKernel (indexed h = page, l = sample nibbles)
5D4F CloneModeNames  ; clone-mode display names "DEEP"/"SLIM" (5-byte stride)
5B7A DrawSyncSubSetting ; draw PS/2 DELAY (KEYBD) or TICKS/STEP (analog) value beside SYNC
5126 CommitNameEdit             ; name-editor done (start, or the keyboard's done key): store the name (instrument, speech word) or save the song under it (FILE flow: "SAVING..."), back to wNameReturnScreen

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
401B DrawHelpMenu               ; draw the HELP menu: HelpMenuPointers[i] at column 0, row i, up to the NULL
49F8 DrawHelpCursor             ; the help menu's cursor: colour menu line HelpEntryLines[wHelpRow] across its text, palette 2 (highlight) or, with erase, 0
4A4D RedrawHelpCursor           ; draw the help menu's cursor unless an entry is open (DrawHelpScreen's last step)
4A79 MoveHelpCursorDown             ; move the help menu's cursor down (to row 9 at most): erase it, wHelpRow++, draw it
4AA6 MoveHelpCursorUp               ; move the help menu's cursor up (to row 0 at most): erase it, wHelpRow--, draw it
4AC5 GotoProjectScreen          ; wCurrentScreen=9 + RedrawScreen (FarCall home $24dd)
4ADB CloseHelpEntry             ; close the open help entry: wHelpOpenEntry = 0, ClearBgTilemap, DrawHelpScreen
4AE7 DrawHelpPage               ; draw help page s from $9800: '\n' starts the next row, a '<'..'>' span is highlighted (ColorField), other bytes are glyphs
4B6D OpenHelpEntry       ; open the help entry at wHelpRow: unhighlight its menu line, clear the BG map, set wHelpOpenEntry, draw its page (DrawHelpPage)
4C30 DrawNameEditCursor         ; highlight the name editor's keyboard key under the cursor ((5, 8) + wNameEditColumn/Row; palette 3 CGB / 2 DMG)
4C96 EraseNameEditCursor        ; un-highlight the name editor's keyboard key under the cursor (palette 0)
4CBA DrawProjectTextField          ; draw a project-screen text field (highlight-aware) at computed coords
5303 BackspaceNameEdit          ; name-editor backspace (select, or the keyboard's backspace key): clear the letter at the last slot, else step the letter highlight back and clear the letter there
569C DrawFontColorFields        ; draw the FONT (wFont) and COLOR SET (wColorSet) project rows
5782 SaveSyncMode               ; wSyncMode -> song property $bfbd
5796 DrawSyncMode2Field         ; draw + persist wSyncMode2 (song property $bfbf)
57C1 ProjectSyncStateFlag          ; predicate combining wSyncMode (1/3) and wSyncRun
582C SaveTempoProperties             ; wTempo -> $bfb4, wTempoMode -> $bfcc song properties
5853 DrawProjectTempo              ; draw the tempo at the VRAM cursor: DrawTempo(GetTempoTimerValue())
5861 RedrawProjectTempo            ; wait while wRedrawPending < 6, then DrawProjectTempo at $9846
5876 DrawKeyRepeatField         ; draw the KEY DELAY/REPEAT values (wKeyDelay/wKeyRepeat)
5896 ProjectSyncModeIs567          ; return 1 if wSyncMode in {5,6,7}
5952 .drawSubSetting            ; (was mislabeled as a function DrawSyncModeField: its `push bc` is the DrawString argument, its `pop bc; ret` DrawSyncField's epilogue)
5A07 ProjectCursorFieldWidth       ; the cursor field's width in tiles: ProjectFieldWidth[wProjectCursor], 2 more on field 11 while the file browser is up
5A42 EraseProjectCursor            ; restore the palette of the project screen field under wProjectCursor (1 for fields 0-7)
5A90 DrawProjectCursor             ; highlight the project screen field under wProjectCursor (ProjectFieldX/Y, ProjectCursorFieldWidth)
5AE3 DrawDecimalField           ; draw a small decimal value ("%d" via printf)
5B09 ProjectSyncModeIs015          ; return 1 if wSyncMode in {0,1,5}
5B23 DrawPrelistenField         ; PRELISTEN field: "ON "/"OFF"/"N/A" by wPrelisten + sync mode
5B62 RedrawProjectPrelisten        ; PRELISTEN field at $992A in the shadow palette (DrawPrelistenField)
5D7C RefreshProjectScreen       ; drain buttons, clear tilemap, DrawProjectScreen + map row
6988 .applySettings     ; ProjectScreenInput: the reset path after RESET MEMORY! (delay, LoadProjectSettings(0), redraw)
6A8C TapTempoStep               ; TAP tempo: on each tap record the frames since the last one (wWorkClockSubFrame) into wTapTempoBuffer (8-deep, oldest dropped), reset on a -frame gap; from 3 taps on, tempo = ffe / (8 * mean interval), capped at 
70B8 GetInstrumentEnvelopeBytes           ; read the instrument's envelope input bytes (x2 ReadCurrentInstrumentByte)
7200 PlotEnvelopeCurve               ; plot env-graph column y at x into wDecompressBuffer, filling gap from wEnvelopePlotX (<$40)
726E ComputeEnvelope            ; plot the instrument envelope graph (bytes 1/9/10 segments over 64 columns, time scaled by GetInstrumentEnvelopeBytes) into wDecompressBuffer, upload
74E4 UpdateEnvelopeSprites           ; write the envelope OAM markers (SetOamByte x2, 8-slot bound)
; --- functions called from bank 0 (this bank paged in) ---
6B7A InitializeKitMixer               ; build the kit sample mixer in WRAM: KitMixTable -> $d000 (1152 B), then MixerKernel unrolled 16x at $d480 with inc c / inc e between copies and a ret after the last
5DBF ProjectScreenInput         ; project screen (9) input (wButtons): field edits saved to the song properties, tap tempo, clean, file screen, RESET CARTRIDGE? menu; 1 = handled
53E8 NameEditorInput            ; name-editor input (screen 7): d-pad moves the keyboard cursor, A types the key, select = backspace, start = done, B = cancel
4BC3 HelpScreenInput            ; HELP screen input: UP/DOWN move the selection, A opens the entry, B closes it or returns to the project screen

4E8A OpenNameEditor             ; save screen -> wNameReturnScreen, init letter input (wNameEditPosition) for instr/file/word names
754F UpdateInstrumentEnvelope        ; ComputeEnvelope + UpdateEnvelopeSprites unless the instrument is WAVE (1) or KIT (2)
5B06 TxtPctD1B                  ; "%d"
5B56 TxtOn1B                    ; "ON "
5B5A TxtOff1B                   ; "OFF"
5B5E TxtNA                      ; "N/A"
5707 FontNames                  ; 5-char FONT names "Y2K ", "ZERO", "KIKO" (indexed wFont*5; DrawFontColorFields)
5716 ColorSetNames              ; 5-char COLOR SET names ("AIRY"...; indexed wColorSet*5)
6FFE ScrollStepTable            ; scroll index-step table (TapTempoStep)
703C EnvelopeVolumeRamps             ; 8-byte volume ramp rows (envelope precalc family; computed base from ScrollStepTable region)
4058 HelpMenuPointers               ; [16] dw -> the help-menu line strings
4098 TxtHelpTitle               ; "HELP / V9.4.0"
40A6 TxtHelpBlank1              ; "" empty help line
40A7 TxtHelpScreens             ; "SCREENS:"
40B0 TxtHelpBlank2              ; "" empty help line
40B1 TxtHelpSong                ; "SONG"
40B6 TxtHelpChain               ; "CHAIN"
40BC TxtHelpPhrase              ; "PHRASE"
40C3 TxtHelpInstr               ; "INSTR"
40C9 TxtHelpGroove              ; "GROOVE"
40D0 TxtHelpWave                ; "WAVE"
40D5 TxtHelpBlank3              ; "" empty help line
40D6 TxtHelpCmdList             ; "COMMAND LIST"
40E3 TxtHelpBlank4              ; "" empty help line
40E4 TxtHelpLiveMode            ; "LIVE MODE"
40EE TxtHelpSelCopy             ; "SELECT/COPY/PASTE"
4100 TxtHelpMuteSolo            ; "MUTE/SOLO/PAN"
4078 HelpPagePointers               ; [11] dw -> the help content pages (entry 0 = none)
408E HelpEntryLines             ; [10] the menu line of each help entry (SONG..MUTE/SOLO/PAN), by wHelpRow
410E TxtHelpPageSong            ; "SONG SCREEN" help page
4248 TxtHelpPageLive            ; "LIVE MODE" help page
430E TxtHelpPageChain           ; "CHAIN SCREEN" help page
441A TxtHelpPagePhrase          ; "PHRASE SCREEN" help page
4529 TxtHelpPageInstr           ; "INSTR SCREEN" help page
4613 TxtHelpPageGroove          ; "GROOVE SCREEN" help page
467F TxtHelpPageWave            ; "WAVE SCREEN" help page
472F TxtHelpPageCmds            ; "COMMAND LIST" help page (<A> RUN TABLE...)
482B TxtHelpPageCopy            ; "SELECT/COPY/PASTE" help page
4971 TxtHelpPageMute            ; "MUTE/SOLO/PAN" help page
4146 TxtHelpSongCont1           ; SONG help page text continuation (scroll split)
414E TxtHelpSongCont2           ; SONG help page text continuation
4153 TxtHelpSongCont3           ; SONG help page text continuation
4241 TxtHelpSongTail            ; tail of the SONG help page ("...UP/DOWN")
454B TxtHelpInstrCont1          ; INSTR help page text continuation
4552 TxtHelpInstrCont2          ; INSTR help page text continuation
4559 TxtHelpInstrCont3          ; INSTR help page text continuation
464F TxtHelpGrooveCont1         ; GROOVE help page text continuation
494D TxtHelpCopyCont1           ; SELECT/COPY/PASTE help page continuation
4C75 NameRowsAJ                 ; "ABCDEFGHIJ": name keyboard row 1
4C80 NameRowsKT                 ; "KLMNOPQRST": name keyboard row 2
4C8B NameRowsUZ                 ; "UVWXYZx >w": name keyboard row 3 -- x and space are typed, > is backspace, w is done (NameEditorInput)
5120 TxtNameColon               ; "NAME:"
52E2 TxtFail1B                  ; "FAIL!"
52E8 TxtOutOfMemory1B           ; "OUT OF MEMORY!"
52F7 TxtOk1B                    ; "OK!  "
52FD TxtFail1B2                 ; "FAIL!" (second instance)
59C5 TxtSyncMidi                ; "MIDI  " sync mode name
59CC TxtSyncKeybd               ; "KEYBD " sync mode name
59D3 TxtSyncAnaIn               ; "ANA.IN" sync mode name
59DA TxtSyncAnOut               ; "AN.OUT" sync mode name
59E1 TxtSyncPs2                 ; "PS/2 DELAY " sync sub-setting label (KEYBD mode)
59ED TxtSyncTicksStep           ; "TICKS/STEP " sync sub-setting label (ANA.IN / AN.OUT)
59F9 TxtBlank13                 ; 13 spaces + NUL (clears the sub-setting field)
5C0C TxtWorkedFmt               ; "WORKED %d:" total-work-time display
5D75 TxtClockFmt                ; "%d:%d:" clock format
6A66 TxtResetCartridge          ; "RESET CARTRIDGE?"
6A77 TxtYes1B                   ; "YES"
6A7B TxtNo1B                    ; "NO"
6A7E TxtResetMemory             ; "RESET MEMORY!"

