; Bank $1C -- File screen (save/load) + song (de)compression
57BB DrawFileScreen      ; screen idx 13: draws the file/save-load browser
; --- song compressor (SAVE); see docs/save_format.md ---
441E CompressSong        ; compress the 32 KiB working song into blocks
715B WriteCompressedByte ; emit one byte to the compressed output stream
711F ReadWorkingSongByte ; read a byte of the working song (input to compress)
; --- song decompressor (LOAD) ---
46E1 DecompressSpecial   ; handle an $E0-escape sub-command: $F0 wave / $F1 instr / $FF end / literal $E0
7402 ReadCompressedByte  ; read next byte from the compressed stream (ptr $C97B/$C97C)
74E0 WriteDecompByte     ; write a decompressed byte into the working song (decompress output)
753E EmitDefaultWave     ; $F0 run: emit a default wavetable frame
758E EmitDefaultInstrument ; $F1 run: emit a default instrument
; --- file screen ---
589A FileActionNames    ; action names "LOAD"/"SAVE"/"ERASE" (5-byte stride, indexed by action type)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 FileWriteCompressedSram    ; low-level compressed-output writer to SRAM (bank $c979, ptr $c97a; di-guarded)
415A FileDrawByte_415A          ; calls DrawByte
42D6 FileSlotHalfBase           ; return $40 or $c0 depending on $c56b (which save half)
42E9 FileScanSlotNames          ; scan file-slot names in SRAM ($A140, bank4) from index $c958
4335 FileGetNameChar            ; read $c959[arg] from the 32-char name buffer (bounds-checked)
4352 FileStrCopy_4352           ; calls strcpy
43C1 FileReadCompressedBlock    ; read a compressed block via ptr $c97d (bounds $800f); 16-step
441F FilePhraseNote_441F        ; accesses PhraseNote
46E3 FileDrawStr_46E3           ; calls DrawStringIndexed
4778 FileDrawStr_4778           ; calls DrawString
4862 FileFindSlotEnd            ; scan file slots in SRAM ($A141) for the $ff terminator
48D4 FileMemFill_48D4           ; calls MemSet
4969 FileListSlots              ; enumerate file slots for the browser (<-DrawFileScreen)
49D4 FileSongWrite_49D4         ; calls WriteSongByte
4A46 FileStrCopy_4A46           ; calls strcpy
4C1A FileSongWrite_4C1A         ; calls WriteSongByte
4D58 FileSongWrite_4D58         ; calls WriteSongByte
4DD1 FileSongWrite_4DD1         ; calls WriteSongByte
4FA5 FileLoadSlotInfo           ; load slot info for index (arg<$20 -> $c97f); calls FileScanSlotNames
5077 FileClearChanState         ; zero the 8 wChanActive bytes ($C0E0..7) backward
5098 FileStopSound              ; SetInterruptEnable + FileClearChanState (silence before load/save)
50B3 FileDrawByte_50B3          ; calls DrawByte
5361 FileDrawStr_5361           ; calls DrawStringIndexed
5531 FileDrawField              ; DrawTextField wrapper
5563 FileDrawFieldChecked       ; bounds-check (<$10) then DrawTextField
5597 FileValidateName           ; validate a name (FileFindSlotEnd; char range $0a/$1f/$20 checks)
55F1 FileDrawStr_55F1           ; calls DrawStringIndexed
5892 FileDrawStr_5892           ; calls DrawString
58C1 FileMatchName              ; compare a slot name (ReadSongByte) against the name buffer (FileGetNameChar)
590B FileCopyNameToBuf          ; copy a slot name from SRAM (ReadSongByte) into the name buffer
594A FileCheckNameLen           ; return whether ($c999-$c99b) exceeds $0b (name length)
595F FileCalcCompressedSize     ; read 4 size bytes + MulU16 -> total compressed size
59E6 FileDrawStr_59E6           ; calls DrawString
60CC FileReadInstrByte          ; read an instrument byte (ReadInstrByte wrapper) for serialization
60E0 FileInstrWrite_60E0        ; calls WriteInstrByte
60F5 FileSerializeField         ; serialize bytes per a descriptor ptr + type code (core of instrument save)
61D6 FileSaveInstrument         ; serialize one instrument (dispatch via FileSerializeField/ReadInstrByte/InstrWrite)
621D FileSaveInstrEnvelope      ; (?) serialize instrument envelope section (descriptor $61e6)
622D FileSongWrite_622D         ; calls WriteSongByte
630F FileSaveInstrPulse         ; (?) serialize pulse-instrument fields (descriptors $628b/$62d3)
6336 FileSongWrite_6336         ; calls WriteSongByte
63C6 FileSaveInstrWave          ; (?) serialize wave-instrument fields
640B FileSaveInstrField640B     ; (?) serialize an instrument field group (FileSerializeField)
641B FileClassifyInstrByte      ; classify an instrument byte ($80/$b8/$bc/$f0 ranges)
6503 FileSaveInstrKit           ; (?) serialize kit-instrument fields
6530 FileSaveInstrNoise         ; (?) serialize noise-instrument fields
656B FileSaveInstrField656B     ; (?) serialize an instrument field group
6585 FileReadByte6585           ; read a byte (ReadSongByte) for serialization
65B9 FileMemFill_65B9           ; calls MemSet
669E FileSongWrite_669E         ; calls WriteSongByte
68C5 FileSaveRunRLE             ; serialize a repeated run (recursive; FileReadInstrByte/InstrWrite)
6959 FileSaveInstrField6959     ; (?) serialize an instrument field group
6973 FileCheckByte6973          ; classify a byte (cp $80)
69A7 FilePhraseNote_69A7        ; accesses PhraseNote
6A57 FileSaveRunRLE2            ; serialize a repeated run (recursive variant)
6AD2 FileSaveInstrField6AD2     ; (?) serialize an instrument field group
6B08 FileSaveInstrField6B08     ; (?) serialize an instrument field group
6B18 FileCheckByte6B18          ; classify a byte ($90/$b8/$0f/$0e)
6BA7 FileSongWrite_6BA7         ; calls WriteSongByte
6C46 FileSaveInstrField6C46     ; (?) serialize an instrument field group
6C56 FileSongWrite_6C56         ; calls WriteSongByte
6EAC FileSongWrite_6EAC         ; calls WriteSongByte
6F73 FileDrawStr_6F73           ; calls DrawString
7109 FileClassifyToken          ; classify a byte for compression ($04/$10/$a0/$c0 tokens)
7167 FileCompressRun            ; RLE-encode a run (WriteCompressedByte x2, ReadWorkingSongByte)
719C FileSendSyncByte           ; send a sync byte (SendSyncByte, $3983; arg<$81)
72EE FileSync_72EE              ; calls SendSyncHandshake
741D FilePutDecompByte          ; append decompressed byte to $DA00 buffer ($c983 cursor)
7426 FileDecompNextBank         ; decompression: advance source / switch SRAM bank ($c97c, $c982)
749E FileDecompressByte         ; decode one compressed byte ($c0/$e0 RLE tokens; FileProc_7513)
7513 FileDecompressRun          ; decode an RLE run (ReadCompressedByte, FileFunc_7426)