; Bank $1C -- File screen (save/load) + song (de)compression
57BB DrawFileScreen      ; screen idx 13: draws the file/save-load browser

; --- File-screen strings + a LUT (db; referenced by the draw/save-load code) ---
4047 DefaultWaveFrameB1C ; [16] default wave frame (32-nibble ramp), source at $43FC
43B9 TxtEmpty           ; "[EMPTY]" (empty file slot)
47A3 TxtVerify          ; "VERIFY..."
4C11 TxtEmpty2          ; "[EMPTY] "
534E TxtLoading         ; "LOADING...1/"
57AC TxtEmpty3          ; "[EMPTY]      0"
5AD4 TxtLoseMinutes     ; "LOSE %u MINUTES" (unsaved-work warning)
60A9 TxtFileErased      ; "FILE ERASED!"
70F9 TxtUpgrading        ; "UPGRADING..."
6E3C CompressRunTable   ; [8][8] run/length table used by the song compressor ($6DBF)
; --- song compressor (SAVE); see docs/save_format.md ---
715B WriteCompressedByte ; emit one byte to the compressed output stream
711F ReadWorkingSongByte ; read a byte of the working song (input to compress)
; --- song decompressor (LOAD) ---
46E1 DecompressSpecial   ; handle an $E0-escape sub-command: $F0 wave / $F1 instr / $FF end / literal $E0
7402 ReadCompressedByte  ; read next byte from the compressed stream (ptr $C97B/$C97C)
74E0 WriteDecompByte     ; write a decompressed byte into the working song (decompress output)
753E EmitDefaultWave     ; $F0 run: emit a default wavetable frame
758E EmitDefaultInstrument ; $F1 run: emit a default instrument
; --- file screen ---
589A FileActionNames    ; action names "LOAD"/"SAVE"/"ERASE" (5-byte stride, indexed by action type)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 FileWriteCompressedSram    ; low-level compressed-output writer to SRAM (bank $c979, ptr $c97a; di-guarded)
415A FindFreeBlock              ; scan the block alloc table ($a141+) for a free block ($c56b selects the SRAM half)
42D6 FileSlotHalfBase           ; return $40 or $c0 depending on $c56b (which save half)
42E9 FileScanSlotNames          ; scan file-slot names in SRAM ($A140, bank4) from index $c958
4335 GetFileBlockCount          ; wFileBlockCounts[i] (i < $20): the blocks file i uses
4352 CopyFileName               ; copy the 8-char filename of slot arg (<$20) into the $c987 buffer
43C1 FileReadCompressedBlock    ; read a compressed block via ptr $c97d (bounds $800f); 16-step
441F CompressSong               ; compress the 32 KiB working song ($A000) into the output stream: init ptrs $c97d/$c983, read via ReadSongByte, emit via WriteCompressedByte ($441E is the prior fn's ret)
46E3 DecompressBlock            ; LSDj block decompressor: RLE $c0, special $e0/$f0 (default wave) /$f1 (default instr) /$ff EOF
4778 DrawVerifyPanel            ; "VERIFY..." save-verification panel + slot info
4862 FileFindSlotEnd            ; scan file slots in SRAM ($A141) for the $ff terminator
48D4 CountFileBlocks            ; rebuild the per-file block-count map ($c959, 32 slots) from the alloc table
4969 FileListSlots              ; enumerate file slots for the browser (<-DrawFileScreen)
49D4 FreeFileBlocks             ; release all blocks of file arg in the alloc table ($a141+)
4A46 LoadFileListState          ; read active-file marker ($bfc1) + init map, cursor restrict, block counts
4C1A EraseFileName              ; clear the 8-char filename slot in the $a000 name table
4D58 EraseFile                  ; FILE erase action: FreeFileBlocks + EraseFileName + refresh (TxtFileErased)
4DD1 MigrateTempoProps          ; copy legacy property bytes $bfb2/$bfb3 -> $bfca/$bfcb (format fixup)
4FA5 FileLoadSlotInfo           ; load slot info for index (arg<$20 -> $c97f); calls FileScanSlotNames
5077 FileClearChanState         ; zero the 8 wChanActive bytes ($C0E0..7) backward
5098 FileStopSound              ; SetInterruptEnable + FileClearChanState (silence before load/save)
50B3 LoadInputSyncProps         ; load KEY DELAY/REPEAT ($bfba/bb) + sync modes ($bfbd/$bfbf) from song properties
5361 DrawFileTextField          ; draw a file-screen text field (highlight-aware) at computed coords
5531 FileDrawField              ; DrawTextField wrapper
5563 FileDrawFieldChecked       ; bounds-check (<$10) then DrawTextField
5597 FileValidateName           ; validate a name (FileFindSlotEnd; char range $0a/$1f/$20 checks)
55F1 DrawFileList               ; draw the visible file slots (wFileScroll window, names + block counts)
5892 .drawLabel           ; (was DrawLoadLabel) draw the "LOAD" prompt string
58C1 FileMatchName              ; compare a slot name (ReadSongByte) against the name buffer (GetFileBlockCount)
590B FileCopyNameToBuf          ; copy a slot name from SRAM (ReadSongByte) into the name buffer
594A FileCheckNameLen           ; return whether ($c999-$c99b) exceeds $0b (name length)
595F FileCalcCompressedSize     ; read 4 size bytes + MulU16 -> total compressed size
59E6 DrawBlocksUsed             ; BLOCKS USED/FREE panel (FileCalcCompressedSize, 33-block bound)
60CC FileReadInstrByte          ; read byte[arg] of the instrument currently being iterated (for upgrade/migration)
60E0 FileWriteInstrByte         ; write byte[arg] of the instrument currently being iterated
60F5 FileForEachInstrType       ; for each of the 64 instruments whose byte-0 (type) == arg, invoke the callback ptr
61D6 FileUpgradeV0              ; song upgrade step v0->v1: patch type-2 instruments (callback $6134)
621D FileUpgradeV1              ; song upgrade step v1->v2: type-2 instruments, subtract 8 from fields 2 & 9 (callback $61e6)
622D FileUpgradeV2              ; song upgrade step v2->v3: patch song data (WriteSongByte)
630F FileUpgradeV3              ; song upgrade step v3->v4: patch instruments (FileForEachInstrType)
6336 FileUpgradeV4              ; song upgrade step v4->v5: patch song data (WriteSongByte)
63C6 FileUpgradeV5              ; song upgrade step v5->v6: patch instruments (FileForEachInstrType)
640B FileUpgradeV6              ; song upgrade step v6->v7: patch instruments (FileForEachInstrType)
641B FileUpgradeV7              ; song upgrade step v7->v8: reclassify instrument bytes ($80/$b8/$bc/$f0)
6503 FileUpgradeV8              ; song upgrade step v8->v9: patch instruments (FileForEachInstrType)
6530 FileUpgradeV9              ; song upgrade step v9->v10: patch instruments (FileForEachInstrType)
656B FileUpgradeV10             ; song upgrade step v10->v11: patch instruments (FileForEachInstrType)
6585 FileUpgradeReadByte        ; upgrade helper: read a working-song byte (ReadSongByte)
65B9 FileUpgradeClearRange      ; upgrade helper: clear a range (MemSet; reads via FileUpgradeReadByte)
669E FileUpgradeV11             ; song upgrade step v11->v12: patch song data (+ FileUpgradeClearRange clear)
68C5 FileUpgradeRemapBits       ; upgrade helper: recursive bit/nibble remap via ROM table $68f1
6959 FileUpgradeV12             ; song upgrade step v12->v13: patch instruments (FileForEachInstrType)
6973 FileCheckByte6973          ; classify a byte (cp $80)
69A7 FileUpgradeV13             ; song upgrade step v13->v14: patch phrase data
6A57 FileUpgradeClampNibble     ; upgrade helper: mask low nibble, conditional decrement; return in e
6AD2 FileUpgradeV14             ; song upgrade step v14->v15: patch instruments (FileForEachInstrType)
6B08 FileUpgradeV15             ; song upgrade step v15->v16: patch instruments (FileForEachInstrType)
6B18 FileUpgradeV16             ; song upgrade step v16->v17: reclassify bytes ($90/$b8/$0f/$0e)
6BA7 FileUpgradeV17             ; song upgrade step v17->v18: patch song data (+ FileUpgradeV17b)
6C46 FileUpgradeV17b            ; v17 upgrade helper: patch instruments (FileForEachInstrType)
6C56 FileUpgradeV18             ; song upgrade step v18->v19: patch song data (WriteSongByte)
6EAC FileUpgradeV19             ; song upgrade step v19->v20: patch song data (WriteSongByte)
6F73 FileUpgradeV21             ; song-format upgrade step for v21->v22: patch synth params (SRAM $beb2.. stride $10, write $03)
6FC7 FileUpgradeSong            ; song-format migration: read stored version ($bfff[3]); if < $16 show "UPGRADING..." and run FileUpgradeV<n> for n=version..$15, then stamp version $16
7109 FileClassifyToken          ; classify a byte for compression ($04/$10/$a0/$c0 tokens)
7167 FileCompressRun            ; RLE-encode a run (WriteCompressedByte x2, ReadWorkingSongByte)
719C FileSendSyncByte           ; send a sync byte (SendSyncByte, $3983; arg<$81)
72EE SyncTransferByte           ; link-port byte exchange step (wSyncState, joypad, SendSyncHandshake)
741D FilePutDecompByte          ; append decompressed byte to $DA00 buffer ($c983 cursor)
7426 FileDecompNextBank         ; decompression: advance source / switch SRAM bank ($c97c, $c982)
749E FileDecompressByte         ; decode one compressed byte ($c0/$e0 RLE tokens; FileDecompressRun)
7513 FileDecompressRun          ; decode an RLE run (ReadCompressedByte, FileDecompNextBank)
; --- functions called from bank 0 (this bank paged in) ---
7310 EnableSerialSync           ; cursorMode=1, $cb65=1, enable the serial interrupt, SendSyncHandshake
5B0C FileScreenInput            ; file-screen input dispatch (wButtons; clears $c997)
40F2 CheckFileMagicAll          ; e=0 if the SRAM file space is initialized: 64K 'rb' set, else 'jk' + 128K marker set

4057 CheckFileMagic64           ; e=1 if the 'rb' format markers are missing (SRAM banks 4/5/7)
47B1 FormatFileSpace            ; zero filenames+versions (bank4 $a000-$a13f), reset the block alloc table
71CD CopySelection              ; copy the selection rect (wSelLeft/Top/Right/Bottom) into the clipboard scratch

; --- per-instrument-type migration callbacks (passed to FileForEachInstrType) ---
6134 FileUpgradeV0Kit    ; V0 kit-instrument field migration (callback)
61E6 FileUpgradeV1Kit    ; V1 kit-instrument field migration (callback)
628B FileUpgradeV3Pulse  ; V3 pulse-instrument field migration (callback)
62D3 FileUpgradeV3Kit    ; V3 kit-instrument field migration (callback)
6395 FileUpgradeV5Wave   ; V5 wave-instrument field migration (callback)
63D6 FileUpgradeV6Wave   ; V6 wave-instrument field migration (callback)
64E7 FileUpgradeV8Wave   ; V8 wave-instrument field migration (callback)
6513 FileUpgradeV9Wave   ; V9 wave-instrument field migration (callback)
6540 FileUpgradeV10Pulse ; V10 pulse-instrument field migration (callback)
68F1 FileUpgradeRemapTable ; [8] nibble remap for FileUpgradeRemapBits: 00 06 08 09 0a 0b 0c 0c
68F9 FileUpgradeV12Pulse ; V12 pulse/noise-instrument field migration (callback; remaps bytes 1/9 via FileUpgradeRemapBits)
6A72 FileUpgradeV14Pulse ; V14 pulse-instrument field migration (callback)
6AEC FileUpgradeV15Wave  ; V15 wave-instrument field migration (callback)
6C29 FileUpgradeV17bPulse ; V17b pulse-instrument field migration (callback)
4E10 ClearFileName      ; zero the 8-byte filename slot n<32 at file-space +n*8 (unreferenced)
589F TxtSave                    ; "SAVE"
58A4 TxtErase                   ; "ERASE"
58AA TxtBlocksUsed              ; "BLOCKS USED: %x/"
58BB TxtBlocks3F                ; "3F" 64K block total
