; Bank $1C -- File screen (save/load) + song (de)compression
57BB DrawFileScreen      ; screen idx 13: draws the file/save-load browser

; --- File-screen strings + a LUT (db; referenced by the draw/save-load code) ---
4047 DefaultWaveFrameB1C ; [16] default wave frame (32-nibble ramp), source at $43FC
43B9 TxtEmpty           ; "[EMPTY]" (empty file slot)
47A3 TxtVerify          ; "VERIFY..."
4C11 TxtEmpty2          ; "[EMPTY] "
534E TxtLoading         ; "LOADING...1/"
57AC TxtEmpty3          ; "[EMPTY]      0"
5AD4 FileNoAttributeTiles                ; [2] = $03 $03: CGB attribute bytes under the "NO" prompt (set_bkg_tiles, DrawBlocksUsed)
60A9 TxtFileErased      ; "FILE ERASED!"
70F9 TxtUpgrading        ; "UPGRADING..."
6E3C NoiseNoteRemapTable        ; [112] FileUpgradeV18's noise-note remap: (note - $20) as high nibble x low 3 bits -> 1..$3C, +$3C unless bit 3
; --- song compressor (SAVE); see docs/save_format.md ---
715B WriteCompressedByte ; emit one byte to the compressed output stream
711F ReadWorkingSongByte ; read a byte of the working song (input to compress)
; --- song decompressor (LOAD) ---
7402 ReadCompressedByte  ; read next byte from the compressed stream (ptr wCompressSourceHigh/wBlockDestinationBank)
74E0 LoadCompressedBlock        ; copy 512-byte compressed block a (SRAM bank 4 + a>>4, $A000 + (a&15)*$200) into the $DB00 buffer and point wCompressSource at it; ends with reti
753E EmitDefaultWave     ; $F0 run: emit a default wavetable frame
758E EmitDefaultInstrument ; $F1 run: emit a default instrument
; --- file screen ---
589A FileActionNames    ; action names "LOAD"/"SAVE"/"ERASE" (5-byte stride, indexed by action type)

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
4000 FileWriteCompressedSram    ; low-level compressed-output writer to SRAM (bank wCompressBank, ptr wCompressSource; di-guarded)
415A FindFreeBlock              ; claim the first free block of the allocation table ($a141 on, to $a180 on the 64K-only format [wFilesystemCheckResult], else $a200): mark it wCompressByte, return its bank + SRAM address; e=0 when full
42D6 FileSlotHalfBase           ; return $40 or $c0 depending on wFilesystemCheckResult (which save half)
42E9 FileScanSlotNames          ; scan file-slot names in SRAM ($A140, bank4) from index wFileBlockIndex
4335 GetFileBlockCount          ; wFileBlockCounts[i] (i < $20): the blocks file i uses
4352 CopyFileName               ; copy the 8-char filename of slot arg (<$20) into the wFileNameBuffer buffer
43C1 CompressIsDefaultWave      ; 1 when the 16 working-song bytes at wCompressDestination are the default wave frame (DefaultWaveFrameB1C); 0 at or past $7FF1
441F CompressSong               ; compress the 32 KiB working song into SRAM blocks: $C0/$E0 escapes, RLE runs, default-wave runs, $E0 n block links, $E0 $FF end; 0 when no block is free
46E3 DecompressBlock            ; LSDj block decompressor: RLE $c0, special $e0/$f0 (default wave) /$f1 (default instr) /$ff EOF
4778 DrawVerifyPanel            ; save-verification panel ("VERIFY...") + slot info
4862 FileFindSlotEnd            ; scan file slots in SRAM ($A141) for the $ff terminator
48D4 CountFileBlocks            ; rebuild the per-file block-count map (wFileBlockCounts, 32 slots) from the alloc table
4969 FileListSlots              ; enumerate file slots for the browser (<-DrawFileScreen)
49D4 FreeFileBlocks             ; release all blocks of file arg in the alloc table ($a141+)
4A46 LoadFileListState          ; read active-file marker ($bfc1) + init map, cursor restrict, block counts
4C1A EraseFileName              ; clear the 8-char filename slot in the $a000 name table
4D58 EraseFile                  ; FILE erase action: FreeFileBlocks + EraseFileName + refresh (TxtFileErased)
4DD1 MigrateTempoProperties          ; copy legacy property bytes $bfb2/$bfb3 -> $bfca/$bfcb (format fixup)
4FA5 FileLoadSlotInfo           ; load slot info for index (arg<$20 -> wCompressByte); calls FileScanSlotNames
5077 FileClearChannelState         ; zero the 8 wChannelActive bytes ($C0E0..7) backward
5098 FileStopSound              ; SetInterruptEnable + FileClearChannelState (silence before load/save)
50B3 LoadFile                   ; FILE load action: keep key delay/repeat + sync modes, FileLoadSlotInfo the slot (FAIL! waits a press), restore props, set active file, LoadProjectSettings + RedrawScreen
5361 DrawFileTextField          ; draw a file-screen text field (highlight-aware) at computed coords
5531 FileDrawField              ; ColorField wrapper
5563 FileDrawFieldChecked       ; bounds-check (<$10) then ColorField
5597 FileValidateName           ; validate a name (FileFindSlotEnd; char range $0a/$1f/$20 checks)
55F1 DrawFileList               ; draw the visible file slots (wFileScroll window, names + block counts)
5892 .drawLabel           ; (was DrawLoadLabel) draw the "LOAD" prompt string
58C1 FileMatchName              ; compare a slot name (ReadSongByte) against the name buffer (GetFileBlockCount)
590B FileCopyNameToBuffer          ; move wFileCursor back to the previous slot that is empty or the open file (SRAM bank 4 $A140); asserts < $20
594A FileCheckNameLength           ; return whether (wFileCursor-wFileScroll) exceeds $0b (name length)
595F FileCalculateCompressedSize     ; read 4 size bytes + MulU16 -> total compressed size
59E6 DrawBlocksUsed             ; BLOCKS USED/FREE panel (FileCalculateCompressedSize, 33-block bound)
60CC FileReadInstrumentByte          ; read byte[arg] of the instrument currently being iterated (for upgrade/migration)
60E0 FileWriteInstrumentByte         ; write byte[arg] of the instrument currently being iterated
60F5 FileForEachInstrumentType       ; for each of the 64 instruments whose byte-0 (type) == arg, invoke the callback ptr
61D6 FileUpgradeV0              ; song upgrade step v0->v1: patch type-2 instruments (callback FileUpgradeV0Kit)
621D FileUpgradeV1              ; song upgrade step v1->v2: type-2 instruments, subtract 8 from fields 2 & 9 (callback FileUpgradeV1Kit)
622D FileUpgradeV2              ; song upgrade step v2->v3: patch song data (WriteSongByte)
630F FileUpgradeV3              ; song upgrade step v3->v4: patch instruments (FileForEachInstrumentType)
6336 FileUpgradeV4              ; song upgrade step v4->v5: patch song data (WriteSongByte)
63C6 FileUpgradeV5              ; song upgrade step v5->v6: patch instruments (FileForEachInstrumentType)
640B FileUpgradeV6              ; song upgrade step v6->v7: patch instruments (FileForEachInstrumentType)
641B FileUpgradeV7              ; song upgrade step v7->v8: reclassify instrument bytes ($80/$b8/$bc/$f0)
6503 FileUpgradeV8              ; song upgrade step v8->v9: patch instruments (FileForEachInstrumentType)
6530 FileUpgradeV9              ; song upgrade step v9->v10: patch instruments (FileForEachInstrumentType)
656B FileUpgradeV10             ; song upgrade step v10->v11: patch instruments (FileForEachInstrumentType)
6585 FileUpgradeReadByte        ; upgrade helper: read a working-song byte (ReadSongByte)
65B9 FileUpgradeClearRange      ; upgrade helper: clear a range (FillMemory; reads via FileUpgradeReadByte)
669E FileUpgradeV11             ; song upgrade step v11->v12: noise-instrument phrase notes -> instrument byte 4, high nibble moved by octave
68C5 FileUpgradeRemapBits       ; upgrade helper: recursive bit/nibble remap via ROM table FileUpgradeRemapTable
6959 FileUpgradeV12             ; song upgrade step v12->v13: patch instruments (FileForEachInstrumentType)
6973 FileUpgradeRetrigRate      ; version 13: an R command value gets 1 added to its rate digit (mod 16), except R8x (resync)
69A7 FileUpgradeV13             ; song upgrade step v13->v14: patch phrase data
6A57 FileUpgradeClampNibble     ; upgrade helper: mask low nibble, conditional decrement; return in e
6AD2 FileUpgradeV14             ; song upgrade step v14->v15: patch instruments (FileForEachInstrumentType)
6B08 FileUpgradeV15             ; song upgrade step v15->v16: patch instruments (FileForEachInstrumentType)
6B18 FileUpgradeV16             ; song upgrade step v16->v17: reclassify bytes ($90/$b8/$0f/$0e)
6BA7 FileUpgradeV17             ; song upgrade step v17->v18: patch song data (+ FileUpgradeV17b)
6C46 FileUpgradeV17b            ; v17 upgrade helper: patch instruments (FileForEachInstrumentType)
6C56 FileUpgradeV18             ; song upgrade step v18->v19: noise-instrument phrase notes remapped through NoiseNoteRemapTable
6EAC FileUpgradeV19             ; song upgrade step v19->v20: patch song data (WriteSongByte)
6F73 FileUpgradeV21             ; song-format upgrade step for v21->v22: patch synth params (SRAM $beb2.. stride $10, write $03)
6FC7 FileUpgradeSong            ; song-format migration: read stored version ($bfff[3]); if < $16 show "UPGRADING..." and run FileUpgradeV<n> for n=version..$15, then stamp version $16
7109 FileClassifyToken          ; classify a byte for compression ($04/$10/$a0/$c0 tokens)
7167 FileCompressRun            ; RLE-encode a run (WriteCompressedByte x2, ReadWorkingSongByte)
719C FileSendSyncByte           ; send sync byte arg: assert no transfer is running (rSC & $81), wSyncTransmitByte = arg, SendSyncByte, then delay(6 on CGB, 3 on DMG)
72EE SyncTransferByte           ; link-port byte exchange step (wSyncState, joypad, SendSyncHandshake)
741D FilePutDecompressByte          ; append decompressed byte to wDecompressBuffer buffer (wDecompressPosition cursor)
7426 FileDecompressNextBank         ; decompression: advance source / switch SRAM bank (wBlockDestinationBank, wDecompressOk)
749E FileDecompressByte         ; decode one compressed byte ($c0/$e0 RLE tokens; FileDecompressRun)
7513 FileDecompressRun          ; decode an RLE run (ReadCompressedByte, FileDecompressNextBank)
; --- functions called from bank 0 (this bank paged in) ---
7310 ReceiveLinkClipboard       ; ProcessSyncByte's $FE: receive the linked Game Boy's clipboard (type, bounds, cells into wClipboardBuffer) for pasting
5B0C FileScreenInput            ; file-screen input dispatch (wButtons; clears wFileLoadAlternateReturn)
40F2 CheckFileMagicAll          ; e=0 if the SRAM file space is initialized: 64K 'rb' set, else 'jk' + 128K marker set

4057 CheckFileMagic64           ; e=1 if the 'rb' format markers are missing (SRAM banks 4/5/7)
47B1 FormatFileSpace            ; zero filenames+versions (bank4 $a000-$a13f), reset the block alloc table
71CD SendLinkClipboard          ; after a copy on linked Game Boys not playing (SYNC = LSDJ): send $FE, the clipboard type, the selection bounds and the cells (manual 5.1.4 Clipboard Transfer)

; --- per-instrument-type migration callbacks (passed to FileForEachInstrumentType) ---
6134 FileUpgradeV0Kit    ; save-format 0 kit instrument: the loop bits of kit bytes 2/9 move into byte 5 (bits 6/5), the kit numbers shift up by 8
61E6 FileUpgradeV1Kit    ; V1 kit-instrument field migration (callback)
628B FileUpgradeV3Pulse  ; V3 pulse-instrument field migration (callback)
62D3 FileUpgradeV3Kit    ; V3 kit-instrument field migration (callback)
6395 FileUpgradeV5Wave   ; V5 wave-instrument field migration (callback)
63D6 FileUpgradeV6Wave   ; V6 wave-instrument field migration (callback)
64E7 FileUpgradeV8Wave   ; V8 wave-instrument field migration (callback)
6513 FileUpgradeV9Wave   ; V9 wave-instrument field migration (callback)
6540 FileUpgradeV10Pulse ; V10 pulse-instrument field migration (callback)
68F1 FileUpgradeRemapTable ; [8] nibble remap for FileUpgradeRemapBits: 00 06 08 09 0a 0b 0c 0c
68F9 FileUpgradeV12Pulse ; V12 pulse/noise-instrument field migration (callback; remaps bytes 1/9 via FileUpgradeRemapBits)
6A72 FileUpgradeV14Pulse ; V14 pulse-instrument field migration (callback)
6AEC FileUpgradeV15Wave  ; V15 wave-instrument field migration (callback)
6C29 FileUpgradeV17bPulse ; V17b pulse-instrument field migration (callback)
4E10 SaveFile                   ; FILE save action: clear the slot name, free its blocks, compress + verify (DrawVerifyPanel), bump the file generation ($a100+n), copy wNameEditBuffer; 0 fail, 2 verify fail, 1 ok
589F TxtSave                    ; "SAVE"
58A4 TxtErase                   ; "ERASE"
58AA TxtBlocksUsed              ; "BLOCKS USED: %x/"
58BB TxtBlocks3F                ; "3F" 64K block total
58BE TxtBlocksBF                ; "BF" 128K block total
5AD6 TxtLoseMin                 ; "LOSE %u MINUTES"
5AE6 TxtLoseHours               ; "LOSE %u HOURS"
5AF4 TxtOfUnsaved               ; "OF UNSAVED WORK?"
5B05 TxtYes1C                   ; "YES"
5B09 TxtNo1C                    ; "NO"
60BE TxtErasePrompt             ; "ERASE?"
60C5 TxtYes1Cb                  ; "YES"
60C9 TxtNo1Cb                   ; "NO"
743C FlushBlockToSram           ; copy the 256-byte staging page (wDecompressBuffer) to SRAM [wBlockDestinationPage]<<8; wrap $c0->$a0, bank++
746E VerifyBlockAgainstSram     ; compare the staging page with the SRAM block (save VERIFY step)
4559 CompressSongMiddle ; @deploy-only: interior of CompressSong (walker artifact)
4F4C SaveFileMiddle ; @deploy-only: interior of SaveFile (walker artifact)

