60BE TxtErasePrompt             ; "ERASE?"
60C5 TxtYes1Cb                  ; "YES"
60C9 TxtNo1Cb                   ; "NO"
743C FlushBlockToSram           ; copy the 256-byte staging page (wDecompBuf) to SRAM [wBlockDstPage]<<8; wrap $c0->$a0, bank++
746E VerifyBlockAgainstSram     ; compare the staging page with the SRAM block (save VERIFY step)
