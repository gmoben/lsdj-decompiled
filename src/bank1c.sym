; Bank $1C -- File screen (save/load) + song (de)compression
57BB DrawFileScreen      ; screen idx 13: draws the file/save-load browser
; --- song compressor (SAVE); see docs/save_format.md ---
441E CompressSong        ; compress the 32 KiB working song into blocks
715B WriteCompressedByte ; emit one byte to the compressed output stream
711F ReadWorkingSongByte ; read a byte of the working song (input to compress)
; --- song decompressor (LOAD) ---
46E1 DecompressSpecial   ; handle an $E0-escape sub-command: $F0 wave / $F1 instr / $FF end / literal $E0
7402 ReadCompressedByte  ; read next byte from the compressed stream (ptr $C97B/$C97C)
74E0 WriteDecompByte     ; write a decompressed byte into the working song (decompress output)
753E EmitDefaultWave     ; $F0 run: emit a default wavetable frame
758E EmitDefaultInstrument ; $F1 run: emit a default instrument
; --- file screen ---
589A FileActionNames    ; action names "LOAD"/"SAVE"/"ERASE" (5-byte stride, indexed by action type)
; --- mechanically-named call-targets (interface-based; some purpose TBD) ---
4000 FileProc_4000          ; subroutine (purpose TBD) (2x)
4335 FileProc_4335          ; subroutine (purpose TBD) (5x)
4352 FileProc_4352          ; subroutine (purpose TBD) (3x)
4778 FileProc_4778          ; subroutine (purpose TBD) (1x)
