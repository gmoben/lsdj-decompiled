; Bank $1E -- screen pre-draw helper
4000 ScreenPreDraw       ; top-row column labels for the screen about to be drawn (raw tiles; none on the wave screen); ScreenDrawDispatch prologue

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
79FA GfxFillVramRegions         ; write $ff to VRAM $9480-$97FF and $8800-$88CF (via $17ec vblank tile writer)
7A38 GfxReadVramByte            ; wait for safe LCD access (rSTAT mode), read [de], return byte in e
7A4B GfxCopyVramRegion          ; copy one tile (16 bytes) from VRAM address src (1st arg, GfxReadVramByte) to dst (2nd, WriteVramByteSafe)
; --- indirect (FarCall) target ---
7AA0 LoadFontTiles              ; font (wFont) + UI icon tiles into VRAM after ResetDisplayState; CGB fixes the palettes and loads one block, DMG three (+ right-third blank on colour set bit 1)

; --- tile data blocks (LoadTilesDispatch streams) + synth waveforms ---
42C8 TilesUiIcons       ; UI/icon tile block loaded on every palette init
462A TilesFont2A        ; font 2 (wFont==2) tile block A
4B1C TilesFont2B        ; font 2 tile block B (DMG path)
4FEE TilesFont2C        ; font 2 tile block C (DMG path)
54C0 TilesFont0A        ; font 0 (default) tile block A
59B2 TilesFont0B        ; font 0 tile block B (DMG path)
5E84 TilesFont0C        ; font 0 tile block C (DMG path)
6356 TilesFont1A        ; font 1 (wFont==1) tile block A
6848 TilesFont1B        ; font 1 tile block B (DMG path)
6D1A TilesFont1C        ; font 1 tile block C (DMG path)
71EC SynthSeedTableA    ; [512] bank-$1E seed cycles: waveform shape 0, signal 0 (32 signed bytes per cycle)
720C SynthWaveTables    ; [480] interior of SynthSeedTableA, retained debugger name for its second cycle
73EC SynthSeedTableB    ; [256] seed cycles: waveform shape 0, signal 1
74EC SynthSeedTableC    ; [512] seed cycles: waveform shape 1, signal 0
76EC SynthSeedTableD    ; [256] seed cycles: waveform shape 1, signal 1
77EC SynthSeedTableE    ; [256] seed cycles: waveform shape 0, signal 2
78EC SynthSeedTableF    ; [256] seed cycles: waveform shape 1, signal 2
79EC TxtSpaces13        ; 13-space blank string

; --- structural local names (loop heads / common exits) ---
42C6 .done                ; common exit of ScreenPreDraw
79FE .loop                ; loop head in GfxFillVramRegions
7A1B .loop2               ; loop head in GfxFillVramRegions
7A36 .done                ; common exit of GfxFillVramRegions
7A39 .loop                ; loop head in GfxReadVramByte
7A52 .copyLoop            ; loop head in GfxCopyVramRegion: 16 bytes, src++ read, dst++ safe write
7A9C .done                ; common exit of GfxCopyVramRegion

; --- structural local names (loop heads / common exits) ---
400D .notWave             ; wButtons == case in ScreenPreDraw
4066 .onPhrase            ; wCurScreen == case in ScreenPreDraw
413F .onChain             ; wCurScreen == case in ScreenPreDraw
4176 .onTable             ; wCurScreen == case in ScreenPreDraw
41D9 .onGroove            ; wCurScreen == case in ScreenPreDraw
4211 .onWord              ; wCurScreen == case in ScreenPreDraw
4248 .onSong              ; wCurScreen == case in ScreenPreDraw



; --- first-action / assert local names ---
40E4 .setVramCursor


; --- full local naming (block signature) ---
403C .cont
403E .checkCurScreen
42B0 .setStringSrc
7A09 .writeVramByteSafe
7A18 .cont
7A27 .writeVramByteSafe_2
7AD9 .cont
7AE1 .cont_2
7AE6 .loadTilesDispatch
7AF5 .cont_3
7B1B .cont_4
7B33 .cont_5
7B48 .loadTilesDispatch_2
7B77 .loadTilesDispatch_3
