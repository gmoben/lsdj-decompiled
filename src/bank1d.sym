; Bank $1D -- Groove / Synth screens + softsynth renderer
6035 RenderSynthWave    ; render a softsynth wave frame; called from main.mainLoop idle time (counter wSynthRenderIndex, 0-15)

; --- synth data tables + strings ---
4EF0 SineTable          ; signed sine waveform (synth source): 0..$3f..0..-$3f..
62BB SynthDispatchJumps ; jp-table for synth command dispatch (jp $62C7/$62D3/...)
63F0 TxtFilterNone              ; "-----"
6DDD TxtOverwrite               ; "OVERWRITE"
41CD TxtGrooveRowBlank  ; " --    " groove/synth row template
4B57 TxtCancelSelect1D  ; "CANCEL SELECT"
4CD8 TxtPaste1D         ; "PASTE"
7D8B TxtCopiedSynth     ; "COPIED SYNTH"
; Groove editor: edits grooves[wGroove][16] at SRAM bank0 $B090 (song offset $1090).
4000 WriteGrooveByte    ; write grooves[wGroove][step] (step in low nibble); 6 edit sites
4058 ReadGrooveByte     ; read grooves[wGroove][step]
40EA DrawGrooveSteps    ; draw the current groove's 16 step values (wGroove*16)
41DA DrawGrooveScreen   ; screen idx 2: draws the groove steps
4215 GrooveScreenUpdate ; screen idx 2 per-frame update (from ScreenUpdateTable)
; Synth editor: softsynth_params[wSynth][16] at SRAM bank1 $BEB2 (16 synths);
; params read via per-field getters ($6311/$68CC/... -> ReadSongByte on $BEB2).
6354 SynthSignalIsFrame ; -> 1 if synth signal type (param 0) == 3 (FRAME mode), else 0
6311 ReadSynthParameter             ; the current synth's param byte n: synth_params[wSynthScreen*16 + n] (song $3EB2)
68AB DrawSynthScreen    ; screen idx 10: draws softsynth params (wave/filter/cutoff/dist/...)
; --- synth-screen value-name tables (indexed by the synth param value) --------
62F5 SynthPhaseNames    ; phase types " PINCH"/"  WARP"/"RESYNC" (7-byte stride)
63F6 TxtLowp                    ; " LOWP"
65B3 TxtClip                    ; "CLIP"

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
40AE EraseGrooveCursor          ; restore the groove cursor step's palette (alternating per two rows)
425B DrawGrooveRow              ; draw one groove row (step<16; ticks via ReadGrooveStep, state wGrooveCacheValid/wGrooveStepCache)
435D BuildGrooveCache       ; once (wGrooveCacheValid guard): build the 16-step groove display cache wGrooveStepCache (via ReadGrooveStep)
4394 DrawGrooveCursor           ; highlight the groove cursor step (palette 3 on CGB, 2 on DMG)
43CF SetGrooveRowPalettes          ; pick a groove row's draw palettes: select colours inside the sorted wSelectionTop..wGrooveRow range (select mode) or on the cursor row, 4/1 stripe on rows with bit 1, else shadow
4B6C CutCopyGrooveSelection              ; cut/copy the groove selection (arg 1 = cut: rows cleared to 0, row 0 to 6)
4C63 PasteGrooveSelection       ; write the clipboard steps into the groove from the cursor (clipType 2), advancing wGrooveRow and wrapping at 16; PASTE message
4CDE DrawGrooveSelection        ; clipType 2: highlight the rows between the anchor wSelectionTop and the cursor (palette 3 on CGB, 2 on DMG)
4D81 RenderSynthWaveA           ; render synth waveform segment using wave tables $4EF0/$50F0 (wSynthSegmentLength1/wSynthSignalType)
5190 RenderSynthWaveB           ; render synth waveform segment (variant of RenderSynthWaveA)
5323 ComposeSynthWave           ; main synth wave composition (wSynthRenderIndex, buffer wSynthWaveBuffer); large
5695 RenderSynthWaveType        ; dispatch waveform shape by type wSynthWaveShape (jump table $56bd); buffer wSynthCurveAmplitude
58DA WrapSynthIndex32           ; return (arg+1) & $1f (wave sample index wrap)
58E6 SynthFilterLowHigh         ; synth filter LOWP/HIGHP (any type but 2/3): scatter each of the 32 samples over two accumulator slots at a cutoff-driven 8.8 position, then normalise each slot by its weight (type 0 fills missing weight with 8)
5BBD SynthFilterBandPass        ; synth filter BANDP: halve the wave an octave per cutoff doubling (pair averages), then the LOWP/HIGHP scatter-and-normalise core with the position masked to the shortened wave
5E53 SynthFilterPass            ; filter/transform 32 wave samples using wSynthFilterCutoff
5F00 ApplySynthFilter           ; dispatch filter by wSynthFilterType (2->SynthFilterBandPass, 3->SynthFilterPass, else 58E6); gated wSynthFilterCutoff
5F29 WriteSynthWaveColumn          ; write an edited wave column (<$20) from the edit state (wWaveEditX) into song data
5F90 LoadSynthSignalWave        ; load the custom-wave SIGNAL (W.FX: wave $F0 + synth, 16 packed bytes at SRAM $AF00 + 16 * synth) into wSynthShapeBuffer as 32 signed words
60A7 SynthLockByteAddressB1D       ; bank $1D's copy of SynthLockByteAddress: the SRAM byte holding synth x's lock bit ($BFC5 for 0-7, $BFC4 for 8-F)
6115 IsSynthLocked              ; nonzero if synth x is locked (its bit in the SynthLockByteAddressB1D byte; LockCurrentSynth sets it when a wave is edited by hand)
6144 ClearSynthFlag             ; clear synth x's bit in the flag pair at $BFC4/$BFC5 (SynthLockByteAddressB1D)
6193 FillSynthWaveRange         ; fill/interpolate a wave value range (16-step; <-SynthLoadWaveTable)
62A8 DrawSynthField             ; draw the synth PHASE field: switch (jp-table SynthDispatchJumps) -> " PINCH"/"  WARP"/"RESYNC"/"RESYN2"
636E DrawSynthFilterField       ; draw the FILTER type field (" LOWP"...; "-----" empty; jp-table $63a6)
6414 DrawSynthWaveField         ; draw the waveform type row (glyph strings "iiii"/"mmmm"; jp-table $6437)
649F EraseSynthCursor           ; restore palette 1 over the cursor field's cells (SynthFieldX/Width/Layout[wSynthCursor])
6503 DrawSynthCursor            ; highlight the cursor field's cells (palette 3 on CGB, 2 on DMG)
6577 DrawSynthDistortionField         ; draw the DIST field: "CLIP"/"FOLD"/"WRAP"
65C2 DrawSynthNumber            ; redraw the synth number and both endpoints of every parameter field
68A5 TxtSynthFrameDashesA       ; "--" for a hidden parameter's first endpoint
68A8 TxtSynthFrameDashesB       ; "--" for its second endpoint
6709 .rowA                ; (was DrawSynthHexRowA) draw a START/END hex pair row of the synth screen (section A; "--" empty)
6791 .rowB                ; (was DrawSynthHexRowB) draw a START/END hex pair row (section B)
6819 .rowC                ; (was DrawSynthHexRowC) draw a START/END hex pair row (section C)
6865 .rowD                ; (was DrawSynthHexRowD) draw a START/END hex pair row (section D), then DrawSynthCursor re-render
68F9 LoadSynthParameters            ; load the edited synth's parameters from SRAM ($BEB2 + wSynthScreen*16) into the render state: wave type, wave table, filter
6935 .loadWaveType        ; (was SynthLoadWaveType) read 2 synth params from SRAM -> wSynthSignalType, wSynthWaveShape (wave type)
6967 .loadWaveTable       ; (was SynthLoadWaveTable) read packed param from SRAM, build wave table wSynthCurveAmplitude (via FillSynthWaveRange)
6997 .loadFilterParameters    ; (was SynthLoadFilterParams) read 2 synth params from SRAM -> wSynthFilterParameter, wSynthFilterType (filter)
6B33 BuildOverwritePrompt       ; draw the confirmation border at columns 3..14, rows 4..10; restore wStringSource/palettes
6D0F DrawOverwriteChoice        ; highlight the OVERWRITE? prompt choice (wOverwriteEnd) on row 9
6D6F OverwriteSynthWaves        ; open the OVERWRITE HAND-DRAWN WAVES? confirmation; set active/choice flags wOverwriteStart/wOverwriteEnd
6E00 RedrawScreenFar            ; FarCall home RedrawScreen ($24dd)
6E11 OverwritePromptInput       ; synth OVERWRITE? prompt input: LEFT/RIGHT move the choice, A accepts (clearing the synth flag on the left choice), B cancels
6E6E WriteSynthParameter            ; synth_params[wSynthScreen*16+n] = value (song $3EB2); 24 uses
6EB6 AddSynthParameterClamped         ; synth param field += inc, clamped to max; draws it and writes it back
6F3F SubSynthParameterClamped         ; synth param field -= dec, clamped at 0; draws it and writes it back
6FC4 RaiseSynthParameterTo            ; increment the edited synth's param field unless it equals max; draw it (hex) and store it
702B LowerSynthParameterTo0           ; decrement the edited synth's param field unless 0; draw it (hex) and store it
708E RaiseSynthFieldHigh            ; current synth field: +$10 on the hi nibble (clamp $f0), WriteSynthParameter
70BC RaiseSynthFieldLow            ; current synth field: +1 on the lo nibble (clamp $0f)
70E4 LowerSynthFieldHigh            ; current synth field: -$10 on the hi nibble
7111 LowerSynthFieldLow            ; current synth field: -1 on the lo nibble
; --- functions called from bank 0 (this bank paged in) ---
7138 SynthScreenInput           ; synth screen input (wButtons): overwrite prompt, help, cursor moves, field steps, synth select, copy/paste; 1 = handled
4D58 ResetGrooveState           ; reset groove screen state (wGrooveCacheValid=0 + 16-slot loop)
4451 GrooveScreenInput          ; groove screen (2) input: step edits, tick moves between pairs, delete, groove select, cut/copy/paste, map exit; 1 = handled
4B65 TxtSelect1D       ; "SELECT" (pairs with TxtCancelSelect1D)
7D98 TxtPastedSynth    ; "PASTED SYNTH"

; --- softsynth shape banks (RenderSynthWaveB and $4db1 reader) ---
4EF0 SynthShapeTableA   ; signed seed samples for synth wave rendering (selected when the shape flag is 0)
50F0 SynthShapeTableB   ; second shape bank (SynthShapeTableA+$200)
405A ReadGrooveStep     ; e = groove data[wGroove*16 + step] (song $1090); asserts step & wGroove<$20
6489 TxtWaveGlyphI              ; "iiii" waveform glyph row
648E TxtWaveGlyphM              ; "mmmm" waveform glyph row
65B8 TxtFold1D                  ; "FOLD"
65BD TxtWrap1D                  ; "WRAP"
60E5 SynthFieldLayout           ; per-synth-field layout, 16 fields each: rows here, then SynthFieldX, SynthFieldWidth
435A TxtPctD1D                  ; "%d"
6DE7 TxtHandDrawn               ; "HAND-DRAWN"
6DF2 TxtWavesQ                  ; "WAVES?"
6DF9 TxtYes1D                   ; "YES"
6DFD TxtNo1D                    ; "NO"
62FC TxtPhaseWarp               ; "  WARP"
6303 TxtPhaseResync             ; "RESYNC"
630A TxtPhaseResyn2             ; "RESYN2"

