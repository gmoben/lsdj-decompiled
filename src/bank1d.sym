; Bank $1D -- Groove / Synth screens + softsynth renderer
6035 RenderSynthWave    ; render a softsynth wave frame; called from MainLoop idle time (counter $C9F0, 0-15)

; --- synth data tables + strings ---
4EF0 SineTable          ; signed sine waveform (synth source): 0..$3f..0..-$3f..
62BB SynthDispatchJumps ; jp-table for synth command dispatch (jp $62C7/$62D3/...)
63F0 TxtFilterNone              ; "-----"
6DDD TxtOverwrite               ; "OVERWRITE"
41CD TxtGrooveRowBlank  ; " --    " groove/synth row template
4B57 TxtCancelSelect1D  ; "CANCEL SELECT"
4CD8 TxtPaste1D         ; "PASTE"
7D8B TxtCopiedSynth     ; "COPIED SYNTH"
; Groove editor: edits grooves[wGroove][16] at SRAM bank0 $B090 (song offset $1090).
4000 WriteGrooveByte    ; write grooves[wGroove][step] (step in low nibble); 6 edit sites
4058 ReadGrooveByte     ; read grooves[wGroove][step]
40EA DrawGrooveSteps    ; draw the current groove's 16 step values (wGroove*16)
41DA DrawGrooveScreen   ; screen idx 2: draws the groove steps
4215 GrooveScreenUpdate ; screen idx 2 per-frame update (from ScreenUpdateTable)
; Synth editor: softsynth_params[wSynth][16] at SRAM bank1 $BEB2 (16 synths);
; params read via per-field getters ($6311/$68CC/... -> ReadSongByte on $BEB2).
6354 SynthSignalIsFrame ; -> 1 if synth signal type (param 0) == 3 (FRAME mode), else 0
6311 SynthParamAddr     ; -> &SYNTH_PARAMS[$C441]*16 + field (current synth's param block, song $3EB2/$BEB2)
68AB DrawSynthScreen    ; screen idx 10: draws softsynth params (wave/filter/cutoff/dist/...)
; --- synth-screen value-name tables (indexed by the synth param value) --------
62F5 SynthPhaseNames    ; phase types " PINCH"/"  WARP"/"RESYNC" (7-byte stride)
63F6 TxtLowp                    ; " LOWP"
65B3 TxtClip                    ; "CLIP"

; --- context-based names (callee-derived role; Func/Proc = purpose TBD) ---
40AE GrooveDrawField        ; draw groove value field at cursor $c9d4 (palette by bit1) via DrawTextField
425B DrawGrooveRow              ; draw one groove row (step<16; ticks via ReadGrooveStep, state $c9d5/$c9d6)
435D GrooveBuildCache       ; once ($c9d5 guard): build the 16-step groove display cache $c9d6 (via $405a)
4394 GrooveDrawFieldHw      ; like GrooveDrawField but palette per hGameboyType
43CF GrooveScreen           ; Groove screen handler (input/draw/edit); sets wClipboardType=SCREEN_GROOVE on CUT
4B6C GrooveScreenHw         ; Groove screen banked-draw path (sets wClipboardType=GROOVE on CUT)
4C63 GrooveRefreshRows      ; redraw groove rows over cursor range $c40e..$c410
4CDE GrooveRefreshRange     ; redraw groove value range around $c9d4/$c40e
4D81 SynthRenderWaveA           ; render synth waveform segment using wave tables $4EF0/$50F0 ($c9e8/$c9ed)
5190 SynthRenderWaveB           ; render synth waveform segment (variant of SynthRenderWaveA)
5323 SynthComposeWave           ; main synth wave composition (wSynthRenderIdx, buffer $ca34); large
5695 SynthRenderWaveType        ; dispatch waveform shape by type $c9e9 (jump table $56bd); buffer $ca94
58DA SynthWrapIndex32           ; return (arg+1) & $1f (wave sample index wrap)
58E6 ClearSynthWaveBufs         ; clear the two 64-byte synth wave work buffers ($cab8/$caf8)
5BBD ClearSynthWaveBufs2        ; duplicate of ClearSynthWaveBufs (second compile)
5E53 SynthFilterPass            ; filter/transform 32 wave samples using $c9ec
5F00 SynthApplyFilter           ; dispatch filter by $c9eb (2->ClearSynthWaveBufs2, 3->SynthFilterPass, else 58E6); gated $c9ec
5F29 SynthWriteWaveCol          ; write an edited wave column (<$20) from the edit state ($cb60) into song data
5F90 SynthReadWaveSram          ; read synth wave bytes from SRAM $AF00 + $c441*32
60A7 SynthCalcParamAddr         ; pick SRAM base $bfc4/$bfc5 by bit3 of arg -> synth param pointer
6115 SynthReadParam             ; read synth param via SynthCalcParamAddr + ReadSongByte (bank1)
6144 SynthCopyParam             ; copy one synth parameter byte (SynthCalcParamAddr src->dst)
6193 SynthFillWaveRange         ; fill/interpolate a wave value range (16-step; <-SynthLoadWaveTable)
62A8 DrawSynthField             ; draw a synth field (jp-table $62bb dispatch by field type)
636E DrawSynthFilterField       ; draw the FILTER type field (" LOWP"...; "-----" empty; jp-table $63a6)
6414 DrawSynthWaveField         ; draw the waveform type row (glyph strings "iiii"/"mmmm"; jp-table $6437)
649F SynthLoadWaveDataA         ; read wave data via index $c442 + ROM table $60F5
6503 SynthLoadWaveDataB         ; read wave data via index $c442 + ROM table $60F5 (variant)
6577 DrawSynthDistField         ; draw the DIST field: "CLIP"/"FOLD"/"WRAP"
65C2 DrawSynthNumber            ; draw the synth number header (wSynthScreen)
6709 DrawSynthHexRowA           ; draw a START/END hex pair row of the synth screen (section A; "--" empty)
6791 DrawSynthHexRowB           ; draw a START/END hex pair row (section B)
6819 DrawSynthHexRowC           ; draw a START/END hex pair row (section C)
6865 DrawSynthHexRowD           ; draw a START/END hex pair row (section D), then SynthLoadWaveDataB re-render
68F9 SynthDataAddr         ; compute SRAM address of synth $c441 data (index*N + base)
6935 SynthLoadWaveType          ; read 2 synth params from SRAM -> $c9ed, $c9e9 (wave type)
6967 SynthLoadWaveTable         ; read packed param from SRAM, build wave table $ca94 (via SynthFillWaveRange)
6997 SynthLoadFilterParams      ; read 2 synth params from SRAM -> $c9ee, $c9eb (filter)
6B33 BuildOverwritePrompt       ; build the OVERWRITE prompt string (wStringSrc)
6D0F SynthDrawWaveView          ; draw synth wave view; layout depends on $cb62 toggle
6D6F SynthOverwriteWaves        ; "OVERWRITE": render the synth into the wave frames ($cb61/$cb62 range)
6E00 RedrawScreenFar            ; FarCall home RedrawScreen ($24dd)
6E11 SynthHandleViewKeys        ; synth-screen key dispatch ($c575: toggle views $cb61/$cb62, RedrawScreenFar)
6E6E WriteSynthParam            ; synth_params[wSynthScreen*16+n] = value (song $3EB2); 24 uses
6EB6 ReadSynthParamPair         ; read a synth param byte (variant 1 of the row accessors)
6F3F ReadSynthParamPair2        ; read a synth param byte (variant 2)
6FC4 DrawSynthParamPair         ; read + DrawHexByte a synth param (variant 1)
702B DrawSynthParamPair2        ; read + DrawHexByte a synth param (variant 2)
708E SynthFieldIncHi            ; current synth field: +$10 on the hi nibble (clamp $f0), WriteSynthParam
70BC SynthFieldIncLo            ; current synth field: +1 on the lo nibble (clamp $0f)
70E4 SynthFieldDecHi            ; current synth field: -$10 on the hi nibble
7111 SynthFieldDecLo            ; current synth field: -1 on the lo nibble
; --- functions called from bank 0 (this bank paged in) ---
7138 SynthScreenInput           ; synth-screen input dispatch (wButtons + SynthReadParam)
4D58 GrooveResetState           ; reset groove screen state ($c9d5=0 + 16-slot loop)
4451 DrawGrooveCursor           ; groove cursor-row highlight (wGrooveRow, select palettes)
4B65 TxtSelect1D       ; "SELECT" (pairs with TxtCancelSelect1D)
7D98 TxtPastedSynth    ; "PASTED SYNTH"

; --- softsynth shape banks (SynthRenderWaveB and $4db1 reader) ---
4EF0 SynthShapeTableA   ; signed seed samples for synth wave rendering (selected when the shape flag is 0)
50F0 SynthShapeTableB   ; second shape bank (SynthShapeTableA+$200)
405A ReadGrooveStep     ; e = groove data[wGroove*16 + step] (song $1090); asserts step & wGroove<$20
6489 TxtWaveGlyphI              ; "iiii" waveform glyph row
648E TxtWaveGlyphM              ; "mmmm" waveform glyph row
65B8 TxtFold1D                  ; "FOLD"
65BD TxtWrap1D                  ; "WRAP"
60E6 SynthFieldLayout           ; per-synth-field {x,y,width} layout (16 fields x 3)
435A TxtPctD1D                  ; "%d"
6DE7 TxtHandDrawn               ; "HAND-DRAWN"
6DF2 TxtWavesQ                  ; "WAVES?"
6DF9 TxtYes1D                   ; "YES"
6DFD TxtNo1D                    ; "NO"
62C7 DrawPhasePinch             ; synth PHASE field case: draw " PINCH"
62D3 DrawPhaseWarp              ; synth PHASE field case: draw "  WARP"
62DF DrawPhaseResync            ; synth PHASE field case: draw "RESYNC"
62EB DrawPhaseResyn2            ; synth PHASE field case: draw "RESYN2"
62FC TxtPhaseWarp               ; "  WARP"
6303 TxtPhaseResync             ; "RESYNC"
630A TxtPhaseResyn2             ; "RESYN2"
