; Bank $1D -- Groove / Synth screens + softsynth renderer
6035 RenderSynthWave    ; render a softsynth wave frame; called from MainLoop idle time (counter $C9F0, 0-15)
; Groove editor: edits grooves[wGroove][16] at SRAM bank0 $B090 (song offset $1090).
4000 WriteGrooveByte    ; write grooves[wGroove][step] (step in low nibble); 6 edit sites
4058 ReadGrooveByte     ; read grooves[wGroove][step]
40EA DrawGrooveSteps    ; draw the current groove's 16 step values (wGroove*16)
41DA DrawGrooveScreen   ; screen idx 2: draws the groove steps
4215 GrooveScreenUpdate ; screen idx 2 per-frame update (from ScreenUpdateTable)
; Synth editor: softsynth_params[wSynth][16] at SRAM bank1 $BEB2 (16 synths);
; params read via per-field getters ($6311/$68CC/... -> ReadSongByte on $BEB2).
6354 SynthSignalIsFrame ; -> 1 if synth signal type (param 0) == 3 (FRAME mode), else 0
6311 SynthParamAddr     ; -> &SYNTH_PARAMS[$C441]*16 + field (current synth's param block, song $3EB2/$BEB2)
68AB DrawSynthScreen    ; screen idx 10: draws softsynth params (wave/filter/cutoff/dist/...)
; --- synth-screen value-name tables (indexed by the synth param value) --------
62F5 SynthPhaseNames    ; phase types " PINCH"/"  WARP"/"RESYNC" (7-byte stride)
63F6 SynthFilterNames   ; filter types " LOWP"/"HIGHP"/"BANDP"/" ALLP" (6-byte stride)
65B3 SynthDistNames     ; distortion types "CLIP"/"FOLD"/"WRAP" (5-byte stride)
