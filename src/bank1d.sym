592C .scatterLoop         ; SynthFilterLowHigh: for each of the 32 source samples, scatter it over two accumulator slots
5AF7 .normaliseLoop       ; SynthFilterLowHigh: for each slot, output = sum / weight
5B5A .shiftLeft           ; SynthFilterLowHigh: (0x100 - weight) <<= 3, the fill of a slot that has no weight
5BB9 .done                ; common exit of SynthFilterLowHigh
5BF7 .octaveLoop          ; SynthFilterBandPass: while the step is below 0x80, halve the wave
5C10 .halveLoop           ; SynthFilterBandPass: wave[i] = (wave[k] + wave[k + 1]) / 2 over the shortened wave
